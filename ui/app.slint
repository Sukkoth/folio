import { Button, ListView, ScrollView } from "std-widgets.slint";

component IconButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: !root.enabled ? #161a21 : root.active ? #2d3545 : ta.pressed ? #2d3545 : ta.has-hover ? #222834 : transparent;
    border-width: 1px;
    border-color: root.active ? #3e485a : ta.has-hover && root.enabled ? #2e3747 : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    Text {
        text: root.text;
        font-size: 15px;
        font-weight: 600;
        color: !root.enabled ? #454f60 : root.active ? #ffffff : ta.has-hover ? #ffffff : #c3ccd9;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}

export struct PageItemData {
    page-index: int,
    offset-y: length,
    width: length,
    height: length,
    image: image,
}

export struct TocItemData {
    title: string,
    page: int,
    display-page: string,
    depth: int,
}

export struct SelectionRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct AnnotationItemData {
    id: int,
    page: int,
    kind: string, // "highlight", "underline", "strikethrough", "note"
    color: color,
    color-hex: string,
    snippet: string,
    comment: string,
    display-page: string,
}

export struct AnnotationVisual {
    id: int,
    page: int,
    kind: string,
    color: color,
    color-index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    comment: string,
    show-note-icon: bool,
}

export component AppWindow inherits Window {
    title: file-title != "" ? "\{file-title} - Folio" : "Folio";
    min-width: 720px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 860px;
    background: #0f1115;

    in property <image> page-image;
    in property <length> page-width: 595px;
    in property <length> page-height: 842px;
    in property <float> page-opacity: 1.0;

    in property <string> file-title: "";
    in property <string> file-path: "";
    in property <string> page-display: "1 / 1";
    in property <string> zoom-display: "200%";
    in property <float> zoom-level: 2.0;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> is-scroll-view: true;
    in-out property <length> scroll-content-y: 0px;
    in property <length> scroll-item-height: 842px + 24px;
    in property <length> total-scroll-height: 0px;
    in property <int> total-pages: 1;
    in-out property <int> current-page: 0;
    in property <[PageItemData]> scroll-pages;

    in-out property <bool> show-sidebar: false;
    in-out property <int> sidebar-tab: 0; // 0=Contents, 1=Highlights, 2=Notes
    in property <[TocItemData]> toc-items;
    in property <[AnnotationItemData]> highlight-items;
    in property <[AnnotationItemData]> note-items;
    in property <[AnnotationVisual]> page-annotations;

    // Text selection & floating popup state
    in property <[SelectionRect]> selection-rects;
    in-out property <bool> has-selection: false;
    in-out property <bool> show-popup: false;
    in-out property <length> popup-x: 0px;
    in-out property <length> popup-y: 0px;
    in-out property <int> selected-color-index: 0; // 0=Yellow, 1=Green, 2=Blue, 3=Pink, 4=Orange
    in-out property <int> selected-annotation-id: -1;
    in-out property <int> hovered-annotation-id: -1;
    in-out property <bool> show-note-input: false;
    in-out property <string> current-note-text: "";

    in-out property <bool> is-dirty: false;
    in-out property <bool> is-saving: false;
    in-out property <bool> show-saved-badge: false;

    in-out property <bool> suppress-page-change: false;
    in property <bool> has-error: false;
    in property <string> error-message: "";

    callback save-document();
    callback save-document-as();
    callback prev-page();
    callback next-page();
    callback zoom-in();
    callback zoom-out();
    callback zoom-in-at(int);
    callback zoom-out-at(int);
    callback zoom-reset();
    callback zoom-fit();
    callback set-view-mode(bool);
    callback visible-page-changed(int);
    callback toggle-sidebar();
    callback jump-to-page(int);

    // Text selection & annotation callbacks
    callback selection-started(int, length, length); // (page, x, y)
    callback selection-dragged(int, length, length); // (page, x, y)
    callback selection-completed(int, length, length); // (page, x, y)
    callback clear-selection();
    callback create-annotation(string, int); // (kind, color_index)
    callback create-note-annotation(string, int); // (comment, color_index)
    callback delete-annotation(int); // (id)
    callback update-annotation-color(int, int); // (id, color_index)
    callback update-annotation-note(int, string); // (id, comment)
    callback undo();
    callback redo();

    public function scroll-to-page(index: int) {
        if (index >= 0 && index < root.scroll-pages.length) {
            root.scroll-content-y = -root.scroll-pages[index].offset-y;
        } else {
            root.scroll-content-y = -index * root.scroll-item-height;
        }
    }

    property <int> visible-page: max(0, min(root.total-pages - 1, round(-root.scroll-content-y / max(1px, root.scroll-item-height))));

    changed visible-page => {
        if (root.is-scroll-view && !root.suppress-page-change) {
            root.visible-page-changed(root.visible-page);
        }
    }

    forward-focus: keyboard-handler;

    keyboard-handler := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.modifiers.shift) {
                    // Ctrl + Shift + S: Save As
                    if (event.text == "s" || event.text == "S") {
                        root.save-document-as();
                        return accept;
                    // Ctrl + Shift + Z: Redo
                    } else if (event.text == "z" || event.text == "Z") {
                        root.redo();
                        return accept;
                    }
                } else if (event.modifiers.alt) {
                    // Ctrl + Alt + S: Strikethrough
                    if (event.text == "s" || event.text == "S") {
                        if (root.has-selection) {
                            root.create-annotation("strikethrough", root.selected-color-index);
                            return accept;
                        }
                    // Ctrl + Alt + N: Note
                    } else if (event.text == "n" || event.text == "N") {
                        if (root.has-selection) {
                            root.show-popup = true;
                            root.show-note-input = true;
                            return accept;
                        }
                    }
                } else {
                    // Ctrl + S: Save Document
                    if (event.text == "s" || event.text == "S") {
                        root.save-document();
                        return accept;
                    // Ctrl + Z: Undo
                    } else if (event.text == "z" || event.text == "Z") {
                        root.undo();
                        return accept;
                    // Ctrl + Y: Redo
                    } else if (event.text == "y" || event.text == "Y") {
                        root.redo();
                        return accept;
                    // Ctrl + H: Highlight
                    } else if (event.text == "h" || event.text == "H") {
                        if (root.has-selection) {
                            root.create-annotation("highlight", root.selected-color-index);
                            return accept;
                        }
                    // Ctrl + U: Underline
                    } else if (event.text == "u" || event.text == "U") {
                        if (root.has-selection) {
                            root.create-annotation("underline", root.selected-color-index);
                            return accept;
                        }
                    } else if (event.text == "+" || event.text == "=") {
                        root.zoom-in();
                        return accept;
                    } else if (event.text == "-" || event.text == "_") {
                        root.zoom-out();
                        return accept;
                    } else if (event.text == "0") {
                        root.zoom-reset();
                        return accept;
                    } else if (event.text == "m" || event.text == "M") {
                        root.set-view-mode(!root.is-scroll-view);
                        return accept;
                    } else if (event.text == "b" || event.text == "B" || event.text == "t" || event.text == "T") {
                        root.toggle-sidebar();
                        return accept;
                    }
                }
            } else {
                if (event.text == Key.Escape) {
                    if (root.show-popup || root.has-selection) {
                        root.clear-selection();
                        return accept;
                    }
                } else if (root.selected-annotation-id > 0) {
                    if (event.text == "1") { root.selected-color-index = 0; root.update-annotation-color(root.selected-annotation-id, 0); return accept; }
                    else if (event.text == "2") { root.selected-color-index = 1; root.update-annotation-color(root.selected-annotation-id, 1); return accept; }
                    else if (event.text == "3") { root.selected-color-index = 2; root.update-annotation-color(root.selected-annotation-id, 2); return accept; }
                    else if (event.text == "4") { root.selected-color-index = 3; root.update-annotation-color(root.selected-annotation-id, 3); return accept; }
                    else if (event.text == "5") { root.selected-color-index = 4; root.update-annotation-color(root.selected-annotation-id, 4); return accept; }
                    else if (event.text == Key.Delete || event.text == Key.Backspace) {
                        root.delete-annotation(root.selected-annotation-id);
                        root.show-popup = false;
                        root.selected-annotation-id = -1;
                        root.hovered-annotation-id = -1;
                        return accept;
                    }
                } else if (root.has-selection && !root.show-note-input) {
                    if (event.text == "1") { root.selected-color-index = 0; return accept; }
                    else if (event.text == "2") { root.selected-color-index = 1; return accept; }
                    else if (event.text == "3") { root.selected-color-index = 2; return accept; }
                    else if (event.text == "4") { root.selected-color-index = 3; return accept; }
                    else if (event.text == "5") { root.selected-color-index = 4; return accept; }
                } else if (event.text == Key.LeftArrow || event.text == Key.PageUp || event.text == Key.UpArrow) {
                    root.prev-page();
                    return accept;
                } else if (event.text == Key.RightArrow || event.text == Key.PageDown || event.text == Key.DownArrow) {
                    root.next-page();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // Top Toolbar (52px, #161a21)
            Rectangle {
                height: 52px;
                background: #161a21;
                border-width: 0;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: #232936;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    // Left Group: Sidebar Toggle, Brand, Filename & View Mode Toggle
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        IconButton {
                            text: "☰";
                            active: root.show-sidebar;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.toggle-sidebar(); }
                        }

                        Rectangle {
                            height: 24px;
                            width: 54px;
                            y: (parent.height - self.height) / 2;
                            background: #6366f120;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #6366f150;

                            Text {
                                text: "FOLIO";
                                font-size: 11px;
                                font-weight: 800;
                                letter-spacing: 1.5px;
                                color: #818cf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            background: #232936;
                        }

                        Text {
                            text: root.file-title != "" ? root.file-title : "No document loaded";
                            font-size: 13px;
                            font-weight: 500;
                            color: #c7d0de;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 220px;
                        }

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            background: #232936;
                        }

                        // View Mode Toggle (Page / Scroll)
                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            y: (parent.height - self.height) / 2;
                            background: #131720;
                            border-width: 1px;
                            border-color: #2b3342;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                page-mode-btn := Rectangle {
                                    width: 50px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: !root.is-scroll-view ? #2b3648 : page-btn-ta.has-hover ? #1f2735 : transparent;
                                    animate background { duration: 120ms; }

                                    Text {
                                        text: "Page";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: !root.is-scroll-view ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    page-btn-ta := TouchArea {
                                        clicked => { root.set-view-mode(false); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                scroll-mode-btn := Rectangle {
                                    width: 50px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: root.is-scroll-view ? #2b3648 : scroll-ta.has-hover ? #1f2735 : transparent;
                                    animate background { duration: 120ms; }

                                    Text {
                                        text: "Scroll";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.is-scroll-view ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    scroll-ta := TouchArea {
                                        clicked => { root.set-view-mode(true); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            background: #232936;
                        }

                        IconButton {
                            text: "↺";
                            enabled: root.can-undo;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.undo(); }
                        }

                        IconButton {
                            text: "↻";
                            enabled: root.can-redo;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.redo(); }
                        }
                    }

                    // Center Group: Page Controls
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        IconButton {
                            text: "<";
                            enabled: root.can-prev;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.prev-page(); }
                        }

                        Rectangle {
                            height: 30px;
                            min-width: 84px;
                            y: (parent.height - self.height) / 2;
                            background: #1c222c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2b3342;

                            Text {
                                text: root.page-display;
                                font-size: 13px;
                                font-weight: 600;
                                color: #e1e7f0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        IconButton {
                            text: ">";
                            enabled: root.can-next;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.next-page(); }
                        }
                    }

                    // Right Group: Zoom Controls
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        IconButton {
                            text: "−";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.zoom-out(); }
                        }

                        Rectangle {
                            height: 30px;
                            min-width: 58px;
                            y: (parent.height - self.height) / 2;
                            background: #1c222c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: zoom-ta.has-hover ? #3c475a : #2b3342;
                            animate border-color { duration: 120ms; }

                            Text {
                                text: root.zoom-display;
                                font-size: 12px;
                                font-weight: 600;
                                color: #c3ccd9;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            zoom-ta := TouchArea {
                                clicked => { root.zoom-reset(); }
                                mouse-cursor: pointer;
                            }
                        }

                        IconButton {
                            text: "+";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.zoom-in(); }
                        }

                        IconButton {
                            text: "Fit";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.zoom-fit(); }
                        }

                        // Save Button (Appears when annotations are modified)
                        if root.is-dirty: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: save-ta.has-hover ? #2563eb : #3b82f6;
                            border-width: 1px;
                            border-color: #60a5fa;
                            animate background { duration: 100ms; }
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 5px;
                                alignment: center;

                                Text {
                                    text: "💾";
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.is-saving ? "Saving..." : "Save";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }

                            save-ta := TouchArea {
                                clicked => { root.save-document(); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Saved Confirmation Badge
                        if !root.is-dirty && root.show-saved-badge: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: #05966920;
                            border-width: 1px;
                            border-color: #10b98160;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: "✓ Saved";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #34d399;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Main Workspace Area (Sidebar + Document Viewport)
            HorizontalLayout {
                spacing: 0;
                padding: 0;

                // Sidebar (Contents, Highlights, Notes)
                sidebar := Rectangle {
                    width: root.show-sidebar ? 290px : 0px;
                    clip: true;
                    background: #13161e;
                    animate width { duration: 160ms; easing: ease-out; }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: #232936;
                    }

                    VerticalLayout {
                        width: 290px;
                        height: 100%;
                        padding: 0;
                        spacing: 0;

                        // Sidebar Tab Switcher (Contents | Highlights | Notes)
                        Rectangle {
                            height: 44px;
                            background: #171b24;

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                width: 100%;
                                background: #232936;
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    // Tab 0: Outline
                                    Rectangle {
                                        height: 28px;
                                        min-width: 68px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: root.sidebar-tab == 0 ? #2b3648 : tab0-ta.has-hover ? #1c222e : transparent;
                                        animate background { duration: 100ms; }

                                        Text {
                                            text: "Outline";
                                            font-size: 11px;
                                            font-weight: root.sidebar-tab == 0 ? 700 : 500;
                                            color: root.sidebar-tab == 0 ? #ffffff : #94a3b8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        tab0-ta := TouchArea {
                                            clicked => { root.sidebar-tab = 0; }
                                            mouse-cursor: pointer;
                                        }
                                    }

                                    // Tab 1: Highlights
                                    Rectangle {
                                        height: 28px;
                                        min-width: 76px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: root.sidebar-tab == 1 ? #2b3648 : tab1-ta.has-hover ? #1c222e : transparent;
                                        animate background { duration: 100ms; }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;

                                            Text {
                                                text: "Highlights";
                                                font-size: 11px;
                                                font-weight: root.sidebar-tab == 1 ? 700 : 500;
                                                color: root.sidebar-tab == 1 ? #ffffff : #94a3b8;
                                                vertical-alignment: center;
                                            }

                                            if root.highlight-items.length > 0: Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 8px;
                                                background: #38bdf830;
                                                y: (parent.height - self.height) / 2;

                                                Text {
                                                    text: root.highlight-items.length;
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #38bdf8;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        tab1-ta := TouchArea {
                                            clicked => { root.sidebar-tab = 1; }
                                            mouse-cursor: pointer;
                                        }
                                    }

                                    // Tab 2: Notes
                                    Rectangle {
                                        height: 28px;
                                        min-width: 64px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: root.sidebar-tab == 2 ? #2b3648 : tab2-ta.has-hover ? #1c222e : transparent;
                                        animate background { duration: 100ms; }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 4px;

                                            Text {
                                                text: "Notes";
                                                font-size: 11px;
                                                font-weight: root.sidebar-tab == 2 ? 700 : 500;
                                                color: root.sidebar-tab == 2 ? #ffffff : #94a3b8;
                                                vertical-alignment: center;
                                            }

                                            if root.note-items.length > 0: Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 8px;
                                                background: #facc1530;
                                                y: (parent.height - self.height) / 2;

                                                Text {
                                                    text: root.note-items.length;
                                                    font-size: 9px;
                                                    font-weight: 700;
                                                    color: #facc15;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        tab2-ta := TouchArea {
                                            clicked => { root.sidebar-tab = 2; }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }

                                IconButton {
                                    text: "✕";
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.toggle-sidebar(); }
                                }
                            }
                        }

                        // Tab 0 Body: Table of Contents
                        if root.sidebar-tab == 0: VerticalLayout {
                            vertical-stretch: 1;

                            if root.toc-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Outline";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "This document does not provide a table of contents.";
                                        font-size: 12px;
                                        color: #475569;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.toc-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.toc-items: row := Rectangle {
                                    height: 36px;
                                    width: parent.width;
                                    background: item.page == root.current-page ? #1e2636 : row-ta.has-hover ? #171c26 : transparent;
                                    animate background { duration: 100ms; }

                                    if item.page == root.current-page: Rectangle {
                                        x: 0;
                                        width: 3px;
                                        height: 100%;
                                        background: #818cf8;
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px + item.depth * 12px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        alignment: space-between;

                                        Text {
                                            text: item.title;
                                            font-size: 12px;
                                            font-weight: item.page == root.current-page ? 600 : 400;
                                            color: item.page == root.current-page ? #ffffff : row-ta.has-hover ? #f1f5f9 : #94a3b8;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: item.display-page;
                                            font-size: 11px;
                                            color: item.page == root.current-page ? #818cf8 : #64748b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    row-ta := TouchArea {
                                        clicked => { root.jump-to-page(item.page); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        // Tab 1 Body: Highlights & Markups
                        if root.sidebar-tab == 1: VerticalLayout {
                            vertical-stretch: 1;

                            if root.highlight-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Highlights Yet";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Select text on any page and use the icon bar to highlight, underline, or strike through.";
                                        font-size: 12px;
                                        color: #475569;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.highlight-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.highlight-items: h-card := Rectangle {
                                    height: 56px;
                                    width: parent.width;
                                    background: h-ta.has-hover ? #1a202d : #141720;
                                    border-width: 0;

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        width: 100%;
                                        background: #1f2533;
                                    }

                                    // Color swatch line
                                    Rectangle {
                                        x: 0;
                                        width: 3px;
                                        height: 100%;
                                        background: item.color;
                                    }

                                    // TouchArea for jumping to page covers the card except the delete button on the right
                                    h-ta := TouchArea {
                                        x: 0;
                                        y: 0;
                                        width: parent.width - 48px;
                                        height: parent.height;
                                        clicked => { root.jump-to-page(item.page); }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;

                                                Text {
                                                    text: item.kind == "highlight" ? "🖍 Highlight" : item.kind == "underline" ? "U̲ Underline" : "S̶ Strikethrough";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: item.color;
                                                }

                                                Text {
                                                    text: "• p. \{item.display-page}";
                                                    font-size: 10px;
                                                    color: #64748b;
                                                }
                                            }

                                            Text {
                                                text: "\{item.snippet}";
                                                font-size: 12px;
                                                color: #cbd5e1;
                                                overflow: elide;
                                                max-width: 200px;
                                            }
                                        }

                                        // Delete icon button
                                        IconButton {
                                            text: "✕";
                                            y: (parent.height - self.height) / 2;
                                            clicked => { root.delete-annotation(item.id); }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 2 Body: Notes
                        if root.sidebar-tab == 2: VerticalLayout {
                            vertical-stretch: 1;

                            if root.note-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Notes Yet";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Select text on any page and click the 📝 icon to attach a note.";
                                        font-size: 12px;
                                        color: #475569;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.note-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.note-items: n-card := Rectangle {
                                    height: 70px;
                                    width: parent.width;
                                    background: n-ta.has-hover ? #1a202d : #141720;

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        width: 100%;
                                        background: #1f2533;
                                    }

                                    // Color swatch line
                                    Rectangle {
                                        x: 0;
                                        width: 3px;
                                        height: 100%;
                                        background: item.color;
                                    }

                                    // TouchArea for jumping to page covers the card except the delete button on the right
                                    n-ta := TouchArea {
                                        x: 0;
                                        y: 0;
                                        width: parent.width - 48px;
                                        height: parent.height;
                                        clicked => { root.jump-to-page(item.page); }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;

                                                Text {
                                                    text: "📝 Note";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: item.color;
                                                }

                                                Text {
                                                    text: "• p. \{item.display-page}";
                                                    font-size: 10px;
                                                    color: #64748b;
                                                }
                                            }

                                            Text {
                                                text: item.comment;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: #f1f5f9;
                                                overflow: elide;
                                                max-width: 200px;
                                            }

                                            Text {
                                                text: "“\{item.snippet}”";
                                                font-size: 11px;
                                                color: #64748b;
                                                overflow: elide;
                                                max-width: 200px;
                                            }
                                        }

                                        // Delete icon button in Notes tab: removes note from highlight, or deletes standalone note
                                        IconButton {
                                            text: "✕";
                                            y: (parent.height - self.height) / 2;
                                            clicked => {
                                                if (item.kind == "note") {
                                                    root.delete-annotation(item.id);
                                                } else {
                                                    root.update-annotation-note(item.id, "");
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Document Viewport / Error Area
                Rectangle {
                    horizontal-stretch: 1;
                    background: #0f1115;
                    clip: true;

                    if root.has-error: Rectangle {
                        width: 440px;
                        height: 220px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: #161a21;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #ef444450;
                        drop-shadow-blur: 24px;
                        drop-shadow-color: #000000a0;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 42px;
                                height: 42px;
                                border-radius: 21px;
                                background: #ef444420;
                                border-width: 1px;
                                border-color: #ef444460;
                                x: (parent.width - self.width) / 2;

                                Text {
                                    text: "!";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: #f87171;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Failed to Open PDF";
                                font-size: 16px;
                                font-weight: 600;
                                color: #f1f5f9;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.error-message;
                                font-size: 12px;
                                color: #94a3b8;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Single Page View
                    if !root.has-error && !root.is-scroll-view: view-scroll := Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: max(parent.width, root.page-width + 64px);
                        content-height: max(parent.height, root.page-height + 64px);

                        viewport-touch := TouchArea {
                            width: view-scroll.content-width;
                            height: view-scroll.content-height;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.move) {
                                    root.hovered-annotation-id = -1;
                                }
                            }

                            scroll-event(event) => {
                                if (event.modifiers.control) {
                                    if (event.delta-y > 0) {
                                        root.zoom-in();
                                        return accept;
                                    } else if (event.delta-y < 0) {
                                        root.zoom-out();
                                        return accept;
                                    }
                                }
                                return reject;
                            }

                            // Page Card with soft shadow and rounded corners
                            page-card := Rectangle {
                                x: max(32px, (view-scroll.content-width - self.width) / 2);
                                y: max(32px, (view-scroll.content-height - self.height) / 2);
                                width: root.page-width;
                                height: root.page-height;
                                background: #ffffff;
                                border-radius: 4px;
                                drop-shadow-blur: 24px;
                                drop-shadow-offset-y: 8px;
                                drop-shadow-color: #000000a6;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: root.page-image;
                                    opacity: root.page-opacity;
                                    animate opacity {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }
                                }

                                // Interactive Text Selection Highlights directly on actual text
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        x: sel-r.x;
                                        y: sel-r.y;
                                        width: sel-r.width;
                                        height: sel-r.height;
                                        background: #3b82f640;
                                        border-radius: 2px;
                                    }
                                }

                                // TouchArea for dragging text selection
                                page-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move) {
                                            root.hovered-annotation-id = -1;
                                        } else if (event.button == PointerEventButton.left) {
                                            if (event.kind == PointerEventKind.down) {
                                                root.selected-annotation-id = -1;
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-started(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                            } else if (event.kind == PointerEventKind.up) {
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-completed(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                            }
                                        }
                                    }

                                    moved => {
                                        if (page-ta.pressed) {
                                            root.selection-dragged(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                        }
                                    }
                                }

                                // Render Page Annotations on top of page-ta so hover and click are intercepted
                                for annot in root.page-annotations: Rectangle {
                                    if annot.page == root.current-page: Rectangle {
                                        x: annot.x;
                                        y: annot.y;
                                        width: annot.w;
                                        height: annot.h;

                                        // Hover & Selection visual recognition feedback rectangle
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.selected-annotation-id == annot.id ? #3b82f628 : ((root.hovered-annotation-id == annot.id || annot-ta.has-hover) ? #ffffff22 : transparent);
                                            border-width: (root.selected-annotation-id == annot.id || root.hovered-annotation-id == annot.id || annot-ta.has-hover) ? 1.5px : 0px;
                                            border-color: root.selected-annotation-id == annot.id ? #3b82f6 : annot.color;
                                        }

                                        // Underline (anchored with breathing space below character baseline, scaling with zoom)
                                        if annot.kind == "underline": Rectangle {
                                            y: parent.height * 0.88;
                                            width: 100%;
                                            height: max(1.2px, root.zoom-level * 1.35px);
                                            background: annot.color;
                                        }

                                        // Strikethrough (centered directly through lowercase x-height, scaling with zoom)
                                        if annot.kind == "strikethrough": Rectangle {
                                            y: parent.height * 0.52;
                                            width: 100%;
                                            height: max(1.0px, root.zoom-level * 1.0px);
                                            background: annot.color;
                                        }

                                        // Margin Gutter Note Pin: positioned in the right page margin so text is never covered
                                        if annot.show-note-icon: margin-pin := Rectangle {
                                            x: root.page-width - annot.x - 28px;
                                            y: (parent.height - self.height) / 2;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 6px;
                                            background: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? annot.color : annot.color.darker(0.15);
                                            border-width: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? 2px : 1px;
                                            border-color: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? #ffffff : #ffffff50;
                                            drop-shadow-blur: (root.hovered-annotation-id == annot.id || pin-ta.has-hover) ? 6px : 3px;
                                            drop-shadow-color: #00000080;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Text {
                                                text: "💬";
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            pin-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.move) {
                                                        root.hovered-annotation-id = annot.id;
                                                    }
                                                }
                                                clicked => {
                                                    root.selected-annotation-id = annot.id;
                                                    root.selected-color-index = annot.color-index;
                                                    root.has-selection = false;
                                                    root.current-note-text = annot.comment;
                                                    root.show-note-input = true;
                                                    let p_width = 290px;
                                                    let p_height = 108px;
                                                    root.popup-x = max(8px, min(root.page-width - p_width - 8px, root.page-width - p_width - 16px));
                                                    root.popup-y = annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px;
                                                    root.show-popup = true;
                                                }
                                            }
                                        }

                                        annot-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = annot.id;
                                                }
                                            }

                                            clicked => {
                                                root.selected-annotation-id = annot.id;
                                                root.selected-color-index = annot.color-index;
                                                root.has-selection = false;
                                                root.current-note-text = annot.comment;
                                                root.show-note-input = annot.comment != "" || annot.kind == "note";
                                                let p_width = root.show-note-input ? 290px : 224px;
                                                let p_height = root.show-note-input ? 108px : 40px;
                                                root.popup-x = max(8px, min(root.page-width - p_width - 8px, annot.x + (annot.w - p_width) / 2));
                                                root.popup-y = annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px;
                                                root.show-popup = true;
                                            }
                                        }
                                    }
                                }

                                // Floating Annotation Icon Popup
                                if root.show-popup: popup := Rectangle {
                                    x: root.popup-x;
                                    y: root.popup-y;
                                    width: root.show-note-input ? 290px : (root.selected-annotation-id > 0 ? 224px : 254px);
                                    height: root.show-note-input ? 108px : 40px;
                                    border-radius: 8px;
                                    background: #181d27;
                                    border-width: 1px;
                                    border-color: #2e384d;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #000000c0;
                                    animate height { duration: 120ms; }
                                    animate width { duration: 120ms; }

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 6px;

                                        // UPDATE MODE: When existing annotation recognized
                                        if root.selected-annotation-id > 0: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;

                                            // 5 Color Circles
                                            HorizontalLayout {
                                                spacing: 5px;
                                                alignment: start;

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #facc15;
                                                    border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 0;
                                                            root.update-annotation-color(root.selected-annotation-id, 0);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #4ade80;
                                                    border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 1;
                                                            root.update-annotation-color(root.selected-annotation-id, 1);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #60a5fa;
                                                    border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 2;
                                                            root.update-annotation-color(root.selected-annotation-id, 2);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #f472b6;
                                                    border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 3;
                                                            root.update-annotation-color(root.selected-annotation-id, 3);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #fb923c;
                                                    border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 4;
                                                            root.update-annotation-color(root.selected-annotation-id, 4);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: #2e384d;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            // Action Icons: Note Toggle, Delete & Close
                                            HorizontalLayout {
                                                spacing: 2px;
                                                alignment: end;

                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: root.show-note-input ? #3b82f640 : note-ta-edit.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "📝";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    note-ta-edit := TouchArea {
                                                        clicked => { root.show-note-input = !root.show-note-input; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: del-ta.has-hover ? #ef444430 : transparent;
                                                    Text {
                                                        text: "🗑";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    del-ta := TouchArea {
                                                        clicked => {
                                                            root.delete-annotation(root.selected-annotation-id);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.hovered-annotation-id = -1;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 22px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: cls-ta-edit.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "✕";
                                                        font-size: 11px;
                                                        color: #94a3b8;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    cls-ta-edit := TouchArea {
                                                        clicked => {
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // CREATE MODE: When text selection is active
                                        if root.selected-annotation-id <= 0: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;

                                            // 5 Color Circles
                                            HorizontalLayout {
                                                spacing: 5px;
                                                alignment: start;

                                                // Color 0: Yellow
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #facc15;
                                                    border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 0; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 1: Green
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #4ade80;
                                                    border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 1; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 2: Blue
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #60a5fa;
                                                    border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 2; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 3: Pink
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #f472b6;
                                                    border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 3; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 4: Orange
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #fb923c;
                                                    border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 4; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: #2e384d;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            // 4 Action Icons (Highlight, Underline, Strikethrough, Note) + Dismiss
                                            HorizontalLayout {
                                                spacing: 2px;
                                                alignment: end;

                                                // Highlight Icon
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: hl-ta.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "🖍";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    hl-ta := TouchArea {
                                                        clicked => { root.create-annotation("highlight", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Underline Icon (U̲)
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: ul-ta.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "U̲";
                                                        font-size: 13px;
                                                        font-weight: 800;
                                                        color: #e2e8f0;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    ul-ta := TouchArea {
                                                        clicked => { root.create-annotation("underline", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Strikethrough Icon (S̶)
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: st-ta.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "S̶";
                                                        font-size: 13px;
                                                        font-weight: 800;
                                                        color: #e2e8f0;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    st-ta := TouchArea {
                                                        clicked => { root.create-annotation("strikethrough", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Note Icon (📝)
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: root.show-note-input ? #3b82f640 : note-ta.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "📝";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    note-ta := TouchArea {
                                                        clicked => {
                                                            if (!root.show-note-input) {
                                                                root.current-note-text = "";
                                                            }
                                                            root.show-note-input = !root.show-note-input;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Close Icon
                                                Rectangle {
                                                    width: 22px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: cls-ta.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "✕";
                                                        font-size: 11px;
                                                        color: #94a3b8;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    cls-ta := TouchArea {
                                                        clicked => { root.clear-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // Bottom Row: Inline Note Input Box (when note active)
                                        if root.show-note-input: HorizontalLayout {
                                            spacing: 4px;

                                            Rectangle {
                                                height: 56px;
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: #11141c;
                                                border-width: 1px;
                                                border-color: #3e4c66;

                                                if root.current-note-text == "": Text {
                                                    x: 8px;
                                                    y: 8px;
                                                    text: root.selected-annotation-id > 0 ? "Add note to annotation..." : "Write a note...";
                                                    font-size: 12px;
                                                    color: #64748b;
                                                }

                                                ScrollView {
                                                    height: 100%;
                                                    width: 100%;

                                                    VerticalLayout {
                                                        padding: 6px;

                                                        note-input := TextInput {
                                                            init => { self.focus(); }
                                                            text <=> root.current-note-text;
                                                            font-size: 12px;
                                                            color: #f1f5f9;
                                                            wrap: word-wrap;
                                                            single-line: false;
                                                            width: 100%;
                                                        }
                                                    }
                                                }
                                            }

                                            // Save Note button (✓ icon)
                                            Rectangle {
                                                width: 32px;
                                                height: 56px;
                                                border-radius: 4px;
                                                background: note-save-ta.has-hover ? #059669 : #10b981;
                                                animate background { duration: 100ms; }

                                                Text {
                                                    text: "✓";
                                                    font-size: 16px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                note-save-ta := TouchArea {
                                                    clicked => {
                                                        if (root.selected-annotation-id > 0) {
                                                            root.update-annotation-note(root.selected-annotation-id, root.current-note-text);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                        } else {
                                                            root.create-note-annotation(root.current-note-text, root.selected-color-index);
                                                        }
                                                    }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Continuous Scroll View
                    if !root.has-error && root.is-scroll-view: scroll-view := ScrollView {
                        width: 100%;
                        height: 100%;
                        content-y <=> root.scroll-content-y;
                        content-height: root.total-scroll-height;
                        content-width: parent.width;

                        for page-item in root.scroll-pages: Rectangle {
                            y: page-item.offset-y;
                            width: parent.width;
                            height: page-item.height + 24px;

                            margin-ta := TouchArea {
                                width: 100%;
                                height: 100%;

                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.move) {
                                        root.hovered-annotation-id = -1;
                                    }
                                }

                                scroll-event(event) => {
                                    if (event.modifiers.control) {
                                        if (event.delta-y > 0) {
                                            root.zoom-in();
                                            return accept;
                                        } else if (event.delta-y < 0) {
                                            root.zoom-out();
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }

                            page-card-scroll := Rectangle {
                                x: max(32px, (parent.width - self.width) / 2);
                                y: 12px;
                                width: page-item.width;
                                height: page-item.height;
                                background: #ffffff;
                                border-radius: 4px;
                                drop-shadow-blur: 24px;
                                drop-shadow-offset-y: 8px;
                                drop-shadow-color: #000000a6;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: page-item.image;
                                }

                                // Interactive Text Selection Highlights directly on actual text
                                if root.has-selection && root.current-page == page-item.page-index: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        x: sel-r.x;
                                        y: sel-r.y;
                                        width: sel-r.width;
                                        height: sel-r.height;
                                        background: #3b82f640;
                                        border-radius: 2px;
                                    }
                                }

                                page-scroll-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;

                                    scroll-event(event) => {
                                        if (event.modifiers.control) {
                                            if (event.delta-y > 0) {
                                                root.zoom-in();
                                                return accept;
                                            } else if (event.delta-y < 0) {
                                                root.zoom-out();
                                                return accept;
                                            }
                                        }
                                        return reject;
                                    }

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move) {
                                            root.hovered-annotation-id = -1;
                                        } else if (event.button == PointerEventButton.left) {
                                            if (event.kind == PointerEventKind.down) {
                                                root.selected-annotation-id = -1;
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.current-page = page-item.page-index;
                                                root.selection-started(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                            } else if (event.kind == PointerEventKind.up) {
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-completed(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                            }
                                        }
                                    }

                                    moved => {
                                        if (page-scroll-ta.pressed) {
                                            root.selection-dragged(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                        }
                                    }
                                }

                                // Render Page Annotations in Scroll View on top of page-scroll-ta
                                for annot in root.page-annotations: Rectangle {
                                    if annot.page == page-item.page-index: Rectangle {
                                        x: annot.x;
                                        y: annot.y;
                                        width: annot.w;
                                        height: annot.h;

                                        // Hover & Selection visual recognition feedback rectangle
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.selected-annotation-id == annot.id ? #3b82f628 : ((root.hovered-annotation-id == annot.id || annot-ta2.has-hover) ? #ffffff22 : transparent);
                                            border-width: (root.selected-annotation-id == annot.id || root.hovered-annotation-id == annot.id || annot-ta2.has-hover) ? 1.5px : 0px;
                                            border-color: root.selected-annotation-id == annot.id ? #3b82f6 : annot.color;
                                        }

                                        // Underline (anchored with breathing space below character baseline, scaling with zoom)
                                        if annot.kind == "underline": Rectangle {
                                            y: parent.height * 0.88;
                                            width: 100%;
                                            height: max(1.2px, root.zoom-level * 1.35px);
                                            background: annot.color;
                                        }

                                        // Strikethrough (centered directly through lowercase x-height, scaling with zoom)
                                        if annot.kind == "strikethrough": Rectangle {
                                            y: parent.height * 0.52;
                                            width: 100%;
                                            height: max(1.0px, root.zoom-level * 1.0px);
                                            background: annot.color;
                                        }

                                        // Margin Gutter Note Pin in Scroll View
                                        if annot.show-note-icon: margin-pin2 := Rectangle {
                                            x: page-item.width - annot.x - 28px;
                                            y: (parent.height - self.height) / 2;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 6px;
                                            background: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? annot.color : annot.color.darker(0.15);
                                            border-width: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? 2px : 1px;
                                            border-color: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? #ffffff : #ffffff50;
                                            drop-shadow-blur: (root.hovered-annotation-id == annot.id || pin-ta2.has-hover) ? 6px : 3px;
                                            drop-shadow-color: #00000080;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Text {
                                                text: "💬";
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            pin-ta2 := TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.move) {
                                                        root.hovered-annotation-id = annot.id;
                                                    }
                                                }
                                                clicked => {
                                                    root.current-page = page-item.page-index;
                                                    root.selected-annotation-id = annot.id;
                                                    root.selected-color-index = annot.color-index;
                                                    root.has-selection = false;
                                                    root.current-note-text = annot.comment;
                                                    root.show-note-input = true;
                                                    let p_width = 290px;
                                                    let p_height = 108px;
                                                    root.popup-x = max(8px, min(page-item.width - p_width - 8px, page-item.width - p_width - 16px));
                                                    root.popup-y = annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px;
                                                    root.show-popup = true;
                                                }
                                            }
                                        }

                                        annot-ta2 := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = annot.id;
                                                }
                                            }

                                            clicked => {
                                                root.current-page = page-item.page-index;
                                                root.selected-annotation-id = annot.id;
                                                root.selected-color-index = annot.color-index;
                                                root.has-selection = false;
                                                root.current-note-text = annot.comment;
                                                root.show-note-input = annot.comment != "" || annot.kind == "note";
                                                let p_width = root.show-note-input ? 290px : 224px;
                                                let p_height = root.show-note-input ? 108px : 40px;
                                                root.popup-x = max(8px, min(page-item.width - p_width - 8px, annot.x + (annot.w - p_width) / 2));
                                                root.popup-y = annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px;
                                                root.show-popup = true;
                                            }
                                        }
                                    }
                                }

                                // Floating Annotation Icon Popup in Scroll View
                                if root.show-popup && root.current-page == page-item.page-index: Rectangle {
                                    x: root.popup-x;
                                    y: root.popup-y;
                                    width: root.show-note-input ? 290px : (root.selected-annotation-id > 0 ? 224px : 254px);
                                    height: root.show-note-input ? 108px : 40px;
                                    border-radius: 8px;
                                    background: #181d27;
                                    border-width: 1px;
                                    border-color: #2e384d;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-color: #000000c0;
                                    animate height { duration: 120ms; }
                                    animate width { duration: 120ms; }

                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 6px;

                                        // UPDATE MODE: When existing annotation recognized
                                        if root.selected-annotation-id > 0: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;

                                            // 5 Color Circles
                                            HorizontalLayout {
                                                spacing: 5px;
                                                alignment: start;

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #facc15;
                                                    border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 0;
                                                            root.update-annotation-color(root.selected-annotation-id, 0);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #4ade80;
                                                    border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 1;
                                                            root.update-annotation-color(root.selected-annotation-id, 1);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #60a5fa;
                                                    border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 2;
                                                            root.update-annotation-color(root.selected-annotation-id, 2);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #f472b6;
                                                    border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 3;
                                                            root.update-annotation-color(root.selected-annotation-id, 3);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #fb923c;
                                                    border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => {
                                                            root.selected-color-index = 4;
                                                            root.update-annotation-color(root.selected-annotation-id, 4);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: #2e384d;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            // Action Icons: Note Toggle, Delete & Close
                                            HorizontalLayout {
                                                spacing: 2px;
                                                alignment: end;

                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: root.show-note-input ? #3b82f640 : note-ta-edit2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "📝";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    note-ta-edit2 := TouchArea {
                                                        clicked => { root.show-note-input = !root.show-note-input; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: del-ta2.has-hover ? #ef444430 : transparent;
                                                    Text {
                                                        text: "🗑";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    del-ta2 := TouchArea {
                                                        clicked => {
                                                            root.delete-annotation(root.selected-annotation-id);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.hovered-annotation-id = -1;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 22px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: cls-ta-edit2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "✕";
                                                        font-size: 11px;
                                                        color: #94a3b8;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    cls-ta-edit2 := TouchArea {
                                                        clicked => {
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // CREATE MODE: When text selection is active
                                        if root.selected-annotation-id <= 0: HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;

                                            // 5 Color Circles
                                            HorizontalLayout {
                                                spacing: 5px;
                                                alignment: start;

                                                // Color 0: Yellow
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #facc15;
                                                    border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 0; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 1: Green
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #4ade80;
                                                    border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 1; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 2: Blue
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #60a5fa;
                                                    border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 2; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 3: Pink
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #f472b6;
                                                    border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 3; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Color 4: Orange
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    border-radius: 9px;
                                                    background: #fb923c;
                                                    border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                    border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                    y: (parent.height - self.height) / 2;
                                                    TouchArea {
                                                        clicked => { root.selected-color-index = 4; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: #2e384d;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            // 4 Action Icons (Highlight, Underline, Strikethrough, Note) + Dismiss
                                            HorizontalLayout {
                                                spacing: 2px;
                                                alignment: end;

                                                // Highlight Icon
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: hl-ta2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "🖍";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    hl-ta2 := TouchArea {
                                                        clicked => { root.create-annotation("highlight", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Underline Icon (U̲)
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: ul-ta2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "U̲";
                                                        font-size: 13px;
                                                        font-weight: 800;
                                                        color: #e2e8f0;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    ul-ta2 := TouchArea {
                                                        clicked => { root.create-annotation("underline", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Strikethrough Icon (S̶)
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: st-ta2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "S̶";
                                                        font-size: 13px;
                                                        font-weight: 800;
                                                        color: #e2e8f0;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    st-ta2 := TouchArea {
                                                        clicked => { root.create-annotation("strikethrough", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Note Icon (📝)
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: root.show-note-input ? #3b82f640 : note-ta2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "📝";
                                                        font-size: 13px;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    note-ta2 := TouchArea {
                                                        clicked => {
                                                            if (!root.show-note-input) {
                                                                root.current-note-text = "";
                                                            }
                                                            root.show-note-input = !root.show-note-input;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Close Icon
                                                Rectangle {
                                                    width: 22px;
                                                    height: 26px;
                                                    border-radius: 4px;
                                                    background: cls-ta2.has-hover ? #283141 : transparent;
                                                    Text {
                                                        text: "✕";
                                                        font-size: 11px;
                                                        color: #94a3b8;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    cls-ta2 := TouchArea {
                                                        clicked => { root.clear-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // Bottom Row: Inline Note Input Box (when note active)
                                        if root.show-note-input: HorizontalLayout {
                                            spacing: 4px;

                                            Rectangle {
                                                height: 56px;
                                                horizontal-stretch: 1;
                                                border-radius: 4px;
                                                background: #11141c;
                                                border-width: 1px;
                                                border-color: #3e4c66;

                                                if root.current-note-text == "": Text {
                                                    x: 8px;
                                                    y: 8px;
                                                    text: root.selected-annotation-id > 0 ? "Add note to annotation..." : "Write a note...";
                                                    font-size: 12px;
                                                    color: #64748b;
                                                }

                                                ScrollView {
                                                    height: 100%;
                                                    width: 100%;

                                                    VerticalLayout {
                                                        padding: 6px;

                                                        note-input2 := TextInput {
                                                            init => { self.focus(); }
                                                            text <=> root.current-note-text;
                                                            font-size: 12px;
                                                            color: #f1f5f9;
                                                            wrap: word-wrap;
                                                            single-line: false;
                                                            width: 100%;
                                                        }
                                                    }
                                                }
                                            }

                                            // Save Note button (✓ icon)
                                            Rectangle {
                                                width: 32px;
                                                height: 56px;
                                                border-radius: 4px;
                                                background: note-save-ta2.has-hover ? #059669 : #10b981;
                                                animate background { duration: 100ms; }

                                                Text {
                                                    text: "✓";
                                                    font-size: 16px;
                                                    font-weight: 700;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                note-save-ta2 := TouchArea {
                                                    clicked => {
                                                        if (root.selected-annotation-id > 0) {
                                                            root.update-annotation-note(root.selected-annotation-id, root.current-note-text);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                        } else {
                                                            root.create-note-annotation(root.current-note-text, root.selected-color-index);
                                                        }
                                                    }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
