import { Button, ListView } from "std-widgets.slint";

component IconButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: !root.enabled ? #161a21 : ta.pressed ? #2d3545 : ta.has-hover ? #222834 : transparent;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? #2e3747 : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    Text {
        text: root.text;
        font-size: 15px;
        font-weight: 600;
        color: !root.enabled ? #454f60 : ta.has-hover ? #ffffff : #c3ccd9;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}

export struct PageItemData {
    page-index: int,
    width: length,
    height: length,
    image: image,
}

export component AppWindow inherits Window {
    title: file-title != "" ? "\{file-title} - Folio" : "Folio";
    min-width: 640px;
    min-height: 480px;
    preferred-width: 1100px;
    preferred-height: 820px;
    background: #0f1115;

    in property <image> page-image;
    in property <length> page-width: 595px;
    in property <length> page-height: 842px;
    in property <float> page-opacity: 1.0;

    in property <string> file-title: "";
    in property <string> file-path: "";
    in property <string> page-display: "1 / 1";
    in property <string> zoom-display: "200%";
    in property <bool> can-prev: false;
    in property <bool> can-next: false;

    in-out property <bool> is-scroll-view: true;
    in-out property <length> scroll-content-y: 0px;
    in property <length> scroll-item-height: 842px + 24px;
    in property <int> total-pages: 1;
    in property <[PageItemData]> scroll-pages;

    in property <bool> has-error: false;
    in property <string> error-message: "";

    callback prev-page();
    callback next-page();
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback zoom-fit();
    callback set-view-mode(bool);
    callback visible-page-changed(int);

    public function scroll-to-page(index: int) {
        root.scroll-content-y = -index * root.scroll-item-height;
    }

    property <int> visible-page: max(0, min(root.total-pages - 1, round(-root.scroll-content-y / max(1px, root.scroll-item-height))));

    changed visible-page => {
        if (root.is-scroll-view) {
            root.visible-page-changed(root.visible-page);
        }
    }

    forward-focus: keyboard-handler;

    keyboard-handler := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "+" || event.text == "=") {
                    root.zoom-in();
                    return accept;
                } else if (event.text == "-" || event.text == "_") {
                    root.zoom-out();
                    return accept;
                } else if (event.text == "0") {
                    root.zoom-reset();
                    return accept;
                } else if (event.text == "m" || event.text == "M") {
                    root.set-view-mode(!root.is-scroll-view);
                    return accept;
                }
            } else {
                if (event.text == Key.LeftArrow || event.text == Key.PageUp || event.text == Key.UpArrow) {
                    root.prev-page();
                    return accept;
                } else if (event.text == Key.RightArrow || event.text == Key.PageDown || event.text == Key.DownArrow) {
                    root.next-page();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            padding: 0;
            spacing: 0;

            // Top Toolbar (52px, #161a21)
            Rectangle {
                height: 52px;
                background: #161a21;
                border-width: 0;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: #232936;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    // Left Group: Brand, Filename & View Mode Toggle
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            height: 24px;
                            width: 58px;
                            y: (parent.height - self.height) / 2;
                            background: #6366f120;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #6366f150;

                            Text {
                                text: "FOLIO";
                                font-size: 11px;
                                font-weight: 800;
                                letter-spacing: 1.5px;
                                color: #818cf8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            background: #232936;
                        }

                        Text {
                            text: root.file-title != "" ? root.file-title : "No document loaded";
                            font-size: 13px;
                            font-weight: 500;
                            color: #c7d0de;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 260px;
                        }

                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            background: #232936;
                        }

                        // View Mode Toggle (Page / Scroll)
                        Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            y: (parent.height - self.height) / 2;
                            background: #131720;
                            border-width: 1px;
                            border-color: #2b3342;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                page-mode-btn := Rectangle {
                                    width: 52px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: !root.is-scroll-view ? #2b3648 : page-ta.has-hover ? #1f2735 : transparent;
                                    animate background { duration: 120ms; }

                                    Text {
                                        text: "Page";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: !root.is-scroll-view ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    page-ta := TouchArea {
                                        clicked => { root.set-view-mode(false); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                scroll-mode-btn := Rectangle {
                                    width: 52px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: root.is-scroll-view ? #2b3648 : scroll-ta.has-hover ? #1f2735 : transparent;
                                    animate background { duration: 120ms; }

                                    Text {
                                        text: "Scroll";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.is-scroll-view ? #ffffff : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    scroll-ta := TouchArea {
                                        clicked => { root.set-view-mode(true); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }

                    // Center Group: Page Controls
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        IconButton {
                            text: "<";
                            enabled: root.can-prev;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.prev-page(); }
                        }

                        Rectangle {
                            height: 30px;
                            min-width: 84px;
                            y: (parent.height - self.height) / 2;
                            background: #1c222c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2b3342;

                            Text {
                                text: root.page-display;
                                font-size: 13px;
                                font-weight: 600;
                                color: #e1e7f0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        IconButton {
                            text: ">";
                            enabled: root.can-next;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.next-page(); }
                        }
                    }

                    // Right Group: Zoom Controls
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        IconButton {
                            text: "−";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.zoom-out(); }
                        }

                        Rectangle {
                            height: 30px;
                            min-width: 58px;
                            y: (parent.height - self.height) / 2;
                            background: #1c222c;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: zoom-ta.has-hover ? #3c475a : #2b3342;
                            animate border-color { duration: 120ms; }

                            Text {
                                text: root.zoom-display;
                                font-size: 12px;
                                font-weight: 600;
                                color: #c3ccd9;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            zoom-ta := TouchArea {
                                clicked => { root.zoom-reset(); }
                                mouse-cursor: pointer;
                            }
                        }

                        IconButton {
                            text: "+";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.zoom-in(); }
                        }

                        IconButton {
                            text: "Fit";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.zoom-fit(); }
                        }
                    }
                }
            }

            // Document Viewport / Error Area
            Rectangle {
                background: #0f1115;
                clip: true;

                if root.has-error: Rectangle {
                    width: 440px;
                    height: 220px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: #161a21;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #ef444450;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000a0;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 21px;
                            background: #ef444420;
                            border-width: 1px;
                            border-color: #ef444460;
                            x: (parent.width - self.width) / 2;

                            Text {
                                text: "!";
                                font-size: 20px;
                                font-weight: 700;
                                color: #f87171;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Failed to Open PDF";
                            font-size: 16px;
                            font-weight: 600;
                            color: #f1f5f9;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.error-message;
                            font-size: 12px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                // Single Page View
                if !root.has-error && !root.is-scroll-view: view-scroll := Flickable {
                    width: 100%;
                    height: 100%;
                    content-width: max(parent.width, root.page-width + 64px);
                    content-height: max(parent.height, root.page-height + 64px);

                    viewport-touch := TouchArea {
                        width: view-scroll.content-width;
                        height: view-scroll.content-height;

                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                if (event.delta-y > 0) {
                                    root.zoom-in();
                                    return accept;
                                } else if (event.delta-y < 0) {
                                    root.zoom-out();
                                    return accept;
                                }
                            }
                            return reject;
                        }

                        // Page Card with soft shadow and rounded corners
                        page-card := Rectangle {
                            x: max(32px, (view-scroll.content-width - self.width) / 2);
                            y: max(32px, (view-scroll.content-height - self.height) / 2);
                            width: root.page-width;
                            height: root.page-height;
                            background: #ffffff;
                            border-radius: 4px;
                            drop-shadow-blur: 24px;
                            drop-shadow-offset-y: 8px;
                            drop-shadow-color: #000000a6;

                            Image {
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                                source: root.page-image;
                                opacity: root.page-opacity;
                                animate opacity {
                                    duration: 160ms;
                                    easing: ease-out;
                                }
                            }
                        }
                    }
                }

                // Continuous Scroll View
                if !root.has-error && root.is-scroll-view: scroll-list := ListView {
                    width: 100%;
                    height: 100%;
                    content-y <=> root.scroll-content-y;

                    for page-item in root.scroll-pages: Rectangle {
                        width: parent.width;
                        height: root.scroll-item-height;

                        page-card-scroll := Rectangle {
                            x: max(32px, (parent.width - self.width) / 2);
                            y: 12px;
                            width: page-item.width;
                            height: page-item.height;
                            background: #ffffff;
                            border-radius: 4px;
                            drop-shadow-blur: 24px;
                            drop-shadow-offset-y: 8px;
                            drop-shadow-color: #000000a6;

                            Image {
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                                source: page-item.image;
                            }

                            TouchArea {
                                scroll-event(event) => {
                                    if (event.modifiers.control) {
                                        if (event.delta-y > 0) {
                                            root.zoom-in();
                                            return accept;
                                        } else if (event.delta-y < 0) {
                                            root.zoom-out();
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
