import { Button, ListView, ScrollView } from "std-widgets.slint";
import "../assets/fonts/Inter-Variable.ttf";

global Theme {
    in-out property <bool> dark: true;

    // Palette derived directly from Image 3:
    // Root bg: #10110C (deep warm olive-charcoal)
    // Card bg: #191A14 (warm elevated obsidian)
    // Main Accent / White CTA: #DADBD6 (warm bone-white pill from "View Plan")
    // On-accent text: #10110C (dark text on bone-white)
    // Border: #2B2D24 / #34362C

    // Base Surfaces
    out property <color> app-bg: root.dark ? #10110C : #F5F6F3;
    out property <color> canvas-bg: root.dark ? #10110C : #EAECE8;
    out property <color> sidebar-bg: root.dark ? #151610 : #FFFFFF;
    out property <color> card-bg: root.dark ? #191A14 : #FFFFFF;
    out property <color> card-subtle: root.dark ? #1E2018 : #F8F9FA;
    out property <color> surface-subtle: root.dark ? #22231C : #F0F2EE;
    out property <color> pill-track: root.dark ? #22231C : #E4E6E1;

    // Borders & Hairline Dividers
    out property <color> border: root.dark ? #2B2D24 : #D8DAD4;
    out property <color> border-subtle: root.dark ? #20211A : #E6E8E2;
    out property <color> border-strong: root.dark ? #3A3C31 : #BFC2B8;

    // Typography
    out property <color> text-primary: root.dark ? #F4F5F0 : #10110C;
    out property <color> text-secondary: root.dark ? #94978C : #65675F;
    out property <color> text-muted: root.dark ? #64665C : #96988E;
    out property <color> text-accent: root.dark ? #DADBD6 : #10110C;

    // Main Accent (Monochrome Bone-White / Dark)
    out property <color> accent: root.dark ? #DADBD6 : #10110C;
    out property <color> accent-hover: root.dark ? #ECEEE9 : #282A22;
    out property <color> accent-border: root.dark ? #DADBD6 : #10110C;
    out property <color> accent-gold: root.dark ? #DADBD6 : #10110C;
    out property <color> accent-pale: root.dark ? #DADBD6 : #10110C;
    out property <color> success: root.dark ? #DADBD6 : #10110C;
    out property <color> on-accent: root.dark ? #10110C : #FFFFFF;

    // Interactive states
    out property <color> hover-bg: root.dark ? #282A22 : #ECEEE8;
    out property <color> active-bg: root.dark ? #32352B : #DFE2DA;

    // Navigation Rail states
    out property <color> rail-active-bg: root.dark ? #DADBD6.transparentize(86%) : #10110C.transparentize(90%);
    out property <color> rail-active-border: root.dark ? #DADBD6 : #10110C;
    out property <color> rail-active-icon: root.dark ? #DADBD6 : #10110C;
    out property <color> text-disabled: root.dark ? #4A4D43 : #B0B4A8;
    out property <color> accent-subtle: root.dark ? #DADBD6.transparentize(86%) : #10110C.transparentize(90%);

    // Annotation Highlight Colors (Soft pastel blend matching PDF text highlighting)
    out property <color> hl-yellow: #fef08a;
    out property <color> hl-green: #bbf7d0;
    out property <color> hl-blue: #bfdbfe;
    out property <color> hl-pink: #fbcfe8;
    out property <color> hl-orange: #fed7aa;
    out property <color> hl-purple: #e9d5ff;

    // Annotation Vibrant Colors (Underline, Note, Strikethrough)
    out property <color> annot-yellow: #facc15;
    out property <color> annot-green: #4ade80;
    out property <color> annot-blue: #60a5fa;
    out property <color> annot-pink: #f472b6;
    out property <color> annot-orange: #fb923c;
    out property <color> annot-purple: #c084fc;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> accent-active: false;
    in property <length> size: 32px;
    in property <length> icon-size: 16px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 8px;
    background: !root.enabled ? transparent : (root.accent-active && root.active) ? Theme.accent : root.active ? Theme.active-bg : ta.pressed ? Theme.active-bg : ta.has-hover ? Theme.hover-bg : transparent;
    border-width: 1px;
    border-color: (root.accent-active && root.active) ? Theme.accent-border : root.active ? Theme.border-strong : ta.has-hover && root.enabled ? Theme.border : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    if root.has-icon: Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? Theme.text-disabled : (root.accent-active && root.active) ? Theme.on-accent : root.active ? Theme.text-primary : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        animate colorize { duration: 120ms; }
    }

    if !root.has-icon: Text {
        text: root.text;
        font-family: "Inter";
        font-size: 16px;
        font-weight: 700;
        color: !root.enabled ? Theme.text-disabled : (root.accent-active && root.active) ? Theme.on-accent : root.active ? Theme.text-primary : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}

component NavRailButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: !root.enabled ? transparent : root.active ? Theme.rail-active-bg : ta.pressed ? Theme.active-bg : ta.has-hover ? Theme.hover-bg : transparent;
    border-width: root.active ? 1.5px : 1px;
    border-color: root.active ? Theme.rail-active-border : ta.has-hover && root.enabled ? Theme.border-strong : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    Image {
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: !root.enabled ? Theme.text-muted : root.active ? Theme.rail-active-icon : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate colorize { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}

component SignaturePillButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> text: "Open PDF";
    callback clicked();

    height: 38px;
    border-radius: 19px;
    background: ta.pressed ? Theme.accent.darker(0.08) : ta.has-hover ? Theme.accent-hover : Theme.accent;
    border-width: 1px;
    border-color: Theme.accent-border;
    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 7px;
        alignment: center;

        if root.has-icon: Image {
            source: root.icon;
            width: 18px;
            height: 18px;
            colorize: Theme.on-accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            font-family: "Inter";
            font-size: 15px;
            font-weight: 700;
            color: Theme.on-accent;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component ViewModeSegment inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 16px;
    background: root.active ? Theme.card-bg : ta.has-hover ? Theme.hover-bg : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border;
    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;

        Image {
            source: root.icon;
            width: 17px;
            height: 17px;
            colorize: root.active ? Theme.text-primary : Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            font-family: "Inter";
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component TabItem inherits Rectangle {
    in property <string> title: "";
    in property <bool> is-active: false;
    in property <bool> is-dirty: false;
    callback clicked();
    callback close-clicked();
    callback context-menu(length, length);

    min-width: 100px;
    max-width: 220px;
    height: 34px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    background: root.is-active ? Theme.card-bg : tab-ta.has-hover ? Theme.hover-bg : transparent;
    border-width: 1px;
    border-color: root.is-active ? Theme.border : transparent;
    clip: true;

    // Top active indicator line
    if root.is-active: Rectangle {
        y: 0;
        height: 2px;
        width: 100%;
        background: Theme.accent;
    }

    tab-ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Image {
                source: @image-url("../assets/icons/file-text.svg");
                width: 14px;
                height: 14px;
                colorize: root.is-active ? Theme.accent : Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.title;
                font-family: "Inter";
                font-size: 13px;
                font-weight: root.is-active ? 600 : 500;
                color: root.is-active ? Theme.text-primary : Theme.text-secondary;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: end;

            if root.is-dirty: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #f59e0b;
                y: (parent.height - self.height) / 2;
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: close-ta.pressed ? Theme.active-bg : close-ta.has-hover ? Theme.hover-bg : transparent;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../assets/icons/x.svg");
                    width: 11px;
                    height: 11px;
                    colorize: close-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                close-ta := TouchArea {
                    clicked => { root.close-clicked(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

export struct TabItemData {
    id: int,
    title: string,
    path: string,
    is-active: bool,
    is-dirty: bool,
}

export struct PageItemData {
    page-index: int,
    offset-y: length,
    width: length,
    height: length,
    image: image,
}

export struct RecentBookItem {
    path: string,
    filename: string,
    page: int,
}

export struct TocItemData {
    id: int,
    title: string,
    page: int,
    display-page: string,
    depth: int,
    has-children: bool,
    is-expanded: bool,
}

export struct PdfLinkData {
    page: int,
    x: length,
    y: length,
    width: length,
    height: length,
    target-page: int,
    uri: string,
}

export struct SelectionRect {
    page: int,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct AnnotationItemData {
    id: int,
    page: int,
    kind: string, // "highlight", "underline", "strikethrough", "note"
    color: color,
    color-hex: string,
    snippet: string,
    comment: string,
    display-page: string,
    display-date: string,
    author: string,
    group-header: string,
}

export struct AnnotationVisual {
    id: int,
    page: int,
    kind: string,
    color: color,
    color-index: int,
    x: length,
    y: length,
    w: length,
    h: length,
    comment: string,
    show-note-icon: bool,
}

export struct SearchResultItem {
    id: int,
    page: int,
    display-page: int,
    snippet: string,
    match-text: string,
    is-active: bool,
}

export struct SearchHighlight {
    page: int,
    x: length,
    y: length,
    width: length,
    height: length,
    is-current: bool,
    page-width: length,
}

export struct DocInfoData {
    file-name: string,
    file-path: string,
    file-size: string,
    page-count: string,
    page-size: string,
    title: string,
    author: string,
    subject: string,
    keywords: string,
    creator: string,
    producer: string,
    creation-date: string,
    mod-date: string,
    pdf-version: string,
    encryption: string,
}

component DocPropRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> is-path: false;
    callback copy-value(string);

    height: 28px;
    border-radius: 6px;
    background: row-ta.has-hover ? Theme.hover-bg : transparent;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: space-between;

        Text {
            width: 120px;
            text: root.label;
            font-family: "Inter";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            horizontal-stretch: 1;

            Text {
                text: root.value;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 500;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-alignment: right;
            }

            if row-ta.has-hover && root.value != "—" && root.value != "": Image {
                source: @image-url("../assets/icons/copy.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    row-ta := TouchArea {
        mouse-cursor: (root.value != "—" && root.value != "") ? pointer : default;
        clicked => {
            if (root.value != "—" && root.value != "") {
                root.copy-value(root.value);
            }
        }
    }
}

export component AppWindow inherits Window {
    default-font-family: "Inter";
    in-out property <bool> dark-mode <=> Theme.dark;
    callback toggle-theme();
    callback open-document();
    title: file-title != "" ? "\{file-title} - Folio" : "Folio";
    min-width: 720px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 860px;
    background: Theme.app-bg;

    in property <image> page-image;
    in property <length> page-width: 595px;
    in property <length> page-height: 842px;
    in property <float> page-opacity: 1.0;

    // Dual-Page Spread properties
    in-out property <bool> is-dual-page: false;
    in property <image> secondary-page-image;
    in property <length> secondary-page-width: 595px;
    in property <length> secondary-page-height: 842px;
    in property <bool> has-secondary-page: false;

    // Page Rotation (0, 90, 180, 270)
    in-out property <int> rotation: 0;

    // Paper Theme (0 = Light, 1 = Sepia, 2 = Scientific Dark)
    in-out property <int> paper-theme: 0;

    callback rotate-clockwise();
    callback set-dual-page(bool);
    callback cycle-paper-theme();
    callback set-paper-theme(int);

    in property <string> file-title: "";
    in property <string> file-path: "";

    // Multi-Tab properties & callbacks
    in property <[TabItemData]> open-tabs: [];
    in-out property <int> active-tab-index: 0;
    callback select-tab(int);
    callback close-tab(int);
    callback close-other-tabs(int);
    callback close-tabs-to-the-right(int);
    callback new-tab();
    callback next-tab();
    callback prev-tab();
    in-out property <bool> show-tab-menu: false;
    in-out property <int> tab-menu-index: -1;
    in-out property <length> tab-menu-x: 0px;
    in-out property <length> tab-menu-y: 38px;
    in property <[RecentBookItem]> recent-books: [];
    in-out property <bool> show-recent-books: false;
    callback open-recent-book(string);
    in-out property <bool> show-doc-info: false;
    in property <DocInfoData> doc-info;
    callback copy-to-clipboard(string);
    callback copy-all-doc-info();
    in property <string> page-display: "1 / 1";
    in-out property <string> current-page-input: "1";
    in property <string> page-suffix-display: "/ 1";
    in-out property <bool> focus-page-input-flag: false;
    in property <string> zoom-display: "200%";
    in property <float> zoom-level: 2.0;
    in-out property <bool> is-ctrl-pressed: false;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    in property <bool> can-nav-back: false;
    in property <bool> can-nav-forward: false;
    callback nav-back();
    callback nav-forward();
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> is-scroll-view: true;
    in-out property <length> scroll-content-y: 0px;
    in property <length> scroll-item-height: 842px + 24px;
    in property <length> total-scroll-height: 0px;
    in property <int> total-pages: 1;
    in-out property <int> current-page: 0;
    in property <[PageItemData]> scroll-pages;

    in-out property <bool> show-sidebar: false;
    in-out property <length> sidebar-width: 350px;
    in-out property <bool> is-sidebar-resizing: false;
    callback save-sidebar-width(length);
    in-out property <int> sidebar-tab: 0; // 0=Contents, 1=Highlights, 2=Notes
    in-out property <bool> show-sort-menu: false;
    in-out property <int> annotation-sort-mode: 0; // 0=Document Order, 1=Newest First, 2=Oldest First
    callback set-annotation-sort-mode(int);
    in property <[TocItemData]> toc-items;
    in property <[AnnotationItemData]> highlight-items;
    in property <[AnnotationItemData]> note-items;
    in property <[AnnotationVisual]> page-annotations;
    in property <[PdfLinkData]> page-links: [];

    // Text selection & floating popup state
    in property <[SelectionRect]> selection-rects;
    in-out property <bool> has-selection: false;
    in-out property <bool> show-popup: false;
    in-out property <int> popup-page: 0;
    in-out property <length> popup-x: 0px;
    in-out property <length> popup-y: 0px;
    in-out property <length> popup-grab-x: 0px;
    in-out property <length> popup-grab-y: 0px;
    in-out property <int> selected-color-index: 0; // 0=Yellow, 1=Green, 2=Blue, 3=Pink, 4=Orange, 5=Purple
    in-out property <int> selected-annotation-id: -1;
    in-out property <string> selected-annotation-kind: "";
    in-out property <int> hovered-annotation-id: -1;
    in-out property <bool> show-note-input: false;
    in-out property <string> current-note-text: "";
    in-out property <length> note-input-width: 308px;
    in-out property <length> note-input-height: 72px;

    in-out property <bool> is-dirty: false;
    in-out property <bool> is-saving: false;
    in-out property <bool> show-saved-badge: false;

    in-out property <bool> suppress-page-change: false;
    in property <bool> has-error: false;
    in property <string> error-message: "";

    // Search state
    in-out property <bool> show-search: false;
    in-out property <string> search-query: "";
    in-out property <bool> search-match-case: false;
    in-out property <bool> search-match-whole-word: false;
    in property <bool> is-searching: false;
    in property <int> active-search-index: -1;
    in property <int> total-search-matches: 0;
    in property <string> search-match-display: "";
    in property <[SearchResultItem]> search-results;
    in property <[SearchHighlight]> page-search-highlights;
    in property <[SearchHighlight]> scroll-search-highlights;

    // Toast notification state
    in-out property <string> toast-message: "";
    in-out property <bool> show-toast: false;

    // Zen / Fullscreen Mode state
    in-out property <bool> is-zen-mode: false;
    in-out property <bool> sidebar-was-open: false;

    // Zen callbacks
    callback toggle-zen-mode();
    callback exit-zen-mode();

    // Export callbacks
    callback copy-annotations-markdown();
    callback export-annotations-markdown();

    callback save-document();
    callback save-document-as();
    callback prev-page();
    callback next-page();
    callback zoom-in();
    callback zoom-out();
    callback zoom-in-at(int);
    callback zoom-out-at(int);
    callback zoom-reset();
    callback zoom-fit();
    callback zoom-fit-width();
    in-out property <bool> is-fit-width: false;
    callback set-view-mode(bool);
    callback visible-page-changed(int);
    callback toggle-sidebar();
    callback jump-to-page(int);
    callback toggle-toc-collapse(int);
    callback open-external-url(string);
    callback go-to-page(string);
    callback reset-page-input();

    // Search callbacks
    callback toggle-search();
    callback close-search();
    callback toggle-search-match-case();
    callback toggle-search-match-whole-word();
    callback search-query-changed(string);
    callback search-next();
    callback search-prev();
    callback select-search-result(int);

    // Text selection & annotation callbacks
    callback copy-selection();
    callback selection-started(int, length, length); // (page, x, y)
    callback selection-dragged(int, length, length); // (page, x, y)
    callback selection-completed(int, length, length); // (page, x, y)
    callback clear-selection();
    callback create-annotation(string, int); // (kind, color_index)
    callback create-note-annotation(string, int); // (comment, color_index)
    callback delete-annotation(int); // (id)
    callback update-annotation-color(int, int); // (id, color_index)
    callback update-annotation-note(int, string); // (id, comment)
    callback undo();
    callback redo();

    public function scroll-to-page(index: int) {
        if (index >= 0 && index < root.scroll-pages.length) {
            root.scroll-content-y = -root.scroll-pages[index].offset-y;
        } else {
            root.scroll-content-y = -index * root.scroll-item-height;
        }
    }

    property <int> visible-page: max(0, min(root.total-pages - 1, round(-root.scroll-content-y / max(1px, root.scroll-item-height))));

    changed visible-page => {
        if (root.is-scroll-view && !root.suppress-page-change) {
            root.visible-page-changed(root.visible-page);
        }
    }

    forward-focus: keyboard-handler;

    public function grab-focus() {
        keyboard-handler.focus();
    }

    changed show-popup => {
        if (!root.show-popup) {
            keyboard-handler.focus();
        }
    }

    changed show-note-input => {
        if (!root.show-note-input) {
            keyboard-handler.focus();
        }
    }

    changed has-selection => {
        if (!root.has-selection && !root.show-note-input) {
            keyboard-handler.focus();
        }
    }

    changed show-search => {
        if (!root.show-search) {
            if (root.sidebar-tab == 3) {
                root.sidebar-tab = root.toc-items.length > 0 ? 0 : 1;
            }
            keyboard-handler.focus();
        }
    }

    changed width => {
        if (root.is-fit-width) {
            root.zoom-fit-width();
        }
    }

    keyboard-handler := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.modifiers.control || event.text == Key.Control || event.text == Key.ControlR || event.text == "\u{11}" || event.text == "\u{16}") {
                root.is-ctrl-pressed = true;
            }

            if (event.text == Key.F11) {
                root.toggle-zen-mode();
                return accept;
            }

            if (event.modifiers.control || event.text == "\u{1a}" || event.text == "\u{13}" || event.text == "\u{19}" || event.text == "\u{15}" || event.text == "\u{2}" || event.text == "\u{14}" || event.text == "\u{17}" || event.text == "\u{6}" || event.text == "\u{3}") {
                if (event.modifiers.shift || (event.modifiers.control && (event.text == "Z" || event.text == "S" || event.text == "W" || event.text == "F"))) {
                    // Ctrl + Shift + S: Save As
                    if (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                        root.save-document-as();
                        return accept;
                    // Ctrl + Shift + Z: Redo
                    } else if (event.text == "z" || event.text == "Z" || event.text == "\u{1a}") {
                        root.redo();
                        return accept;
                    // Ctrl + Shift + W: Fit to Width
                    } else if (event.text == "w" || event.text == "W" || event.text == "\u{17}") {
                        root.is-fit-width = true;
                        root.zoom-fit-width();
                        return accept;
                    // Ctrl + Shift + F: Fit to Page (Window)
                    } else if (event.text == "f" || event.text == "F" || event.text == "\u{6}") {
                        root.is-fit-width = false;
                        root.zoom-fit();
                        return accept;
                    }
                } else if (event.modifiers.alt) {
                    // Ctrl + Alt + S: Strikethrough
                    if (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                        if (root.has-selection) {
                            root.create-annotation("strikethrough", root.selected-color-index);
                            return accept;
                        }
                    // Ctrl + Alt + N: Note
                    } else if (event.text == "n" || event.text == "N" || event.text == "\u{e}") {
                        if (root.has-selection) {
                            root.show-popup = true;
                            root.show-note-input = true;
                            return accept;
                        }
                    // Ctrl + Alt + D: Toggle Dual Page Mode
                    } else if (event.text == "d" || event.text == "D" || event.text == "\u{4}") {
                        root.set-dual-page(!root.is-dual-page);
                        return accept;
                    }
                } else {
                    // Multi-tab shortcuts:
                    // Ctrl + T: New Tab
                    if (event.text == "t" || event.text == "T" || event.text == "\u{14}") {
                        root.new-tab();
                        return accept;
                    // Ctrl + W: Close current Tab
                    } else if (event.text == "w" || event.text == "W" || event.text == "\u{17}") {
                        root.close-tab(root.active-tab-index);
                        return accept;
                    // Ctrl + Tab: Next Tab, Ctrl + Shift + Tab: Previous Tab
                    } else if (event.text == Key.Tab) {
                        if (event.modifiers.shift) {
                            root.prev-tab();
                        } else {
                            root.next-tab();
                        }
                        return accept;
                    // Ctrl + PageDown: Next Tab
                    } else if (event.text == Key.PageDown) {
                        root.next-tab();
                        return accept;
                    // Ctrl + PageUp: Previous Tab
                    } else if (event.text == Key.PageUp) {
                        root.prev-tab();
                        return accept;
                    // Ctrl + 1..9: Select Tab 1..9
                    } else if (event.text == "1") {
                        root.select-tab(0);
                        return accept;
                    } else if (event.text == "2") {
                        root.select-tab(1);
                        return accept;
                    } else if (event.text == "3") {
                        root.select-tab(2);
                        return accept;
                    } else if (event.text == "4") {
                        root.select-tab(3);
                        return accept;
                    } else if (event.text == "5") {
                        root.select-tab(4);
                        return accept;
                    } else if (event.text == "6") {
                        root.select-tab(5);
                        return accept;
                    } else if (event.text == "7") {
                        root.select-tab(6);
                        return accept;
                    } else if (event.text == "8") {
                        root.select-tab(7);
                        return accept;
                    } else if (event.text == "9") {
                        root.select-tab(8);
                        return accept;
                    // Ctrl + F: Toggle Search
                    } else if (event.text == "f" || event.text == "F" || event.text == "\u{6}") {
                        root.toggle-search();
                        return accept;
                    // Ctrl + G: Go to page
                    } else if (event.text == "g" || event.text == "G" || event.text == "\u{7}") {
                        root.focus-page-input-flag = true;
                        return accept;
                    // Ctrl + S: Save Document
                    } else if (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                        root.save-document();
                        return accept;
                    // Ctrl + C: Copy selection or selected annotation
                    } else if (event.text == "c" || event.text == "C" || event.text == "\u{3}") {
                        if (root.has-selection || root.selected-annotation-id > 0) {
                            root.copy-selection();
                            return accept;
                        }
                    // Ctrl + Z: Undo
                    } else if (event.text == "z" || event.text == "Z" || event.text == "\u{1a}") {
                        root.undo();
                        return accept;
                    // Ctrl + Y: Redo
                    } else if (event.text == "y" || event.text == "Y" || event.text == "\u{19}") {
                        root.redo();
                        return accept;
                    // Ctrl + H: Highlight
                    } else if (event.text == "h" || event.text == "H" || (event.modifiers.control && event.text == "\u{8}")) {
                        if (root.has-selection) {
                            root.create-annotation("highlight", root.selected-color-index);
                            return accept;
                        }
                    // Ctrl + U: Underline
                    } else if (event.text == "u" || event.text == "U" || event.text == "\u{15}") {
                        if (root.has-selection) {
                            root.create-annotation("underline", root.selected-color-index);
                            return accept;
                        }
                    } else if (event.text == "+" || event.text == "=") {
                        root.zoom-in();
                        return accept;
                    } else if (event.text == "-" || event.text == "_") {
                        root.zoom-out();
                        return accept;
                    } else if (event.text == "0") {
                        root.zoom-reset();
                        return accept;
                    } else if (event.text == "m" || event.text == "M" || (event.modifiers.control && (event.text == "\n" || event.text == "\u{d}"))) {
                        root.set-view-mode(!root.is-scroll-view);
                        return accept;
                    } else if (event.text == "r" || event.text == "R" || (event.modifiers.control && event.text == "\u{12}")) {
                        root.rotate-clockwise();
                        return accept;
                    // Ctrl + D: Document Properties (Doc Info Modal)
                    } else if (event.text == "d" || event.text == "D" || (event.modifiers.control && event.text == "\u{4}")) {
                        root.show-doc-info = !root.show-doc-info;
                        return accept;
                    } else if (event.text == "b" || event.text == "B" || event.text == "\u{2}") {
                        root.toggle-sidebar();
                        return accept;
                    }
                }
            } else {
                if (event.text == Key.Escape) {
                    if (root.show-tab-menu) {
                        root.show-tab-menu = false;
                        return accept;
                    }
                    if (root.show-doc-info) {
                        root.show-doc-info = false;
                        return accept;
                    }
                    if (root.show-search) {
                        root.close-search();
                        return accept;
                    }
                    if (root.show-popup || root.has-selection || root.selected-annotation-id > 0) {
                        root.clear-selection();
                        root.show-popup = false;
                        root.selected-annotation-id = -1;
                        root.selected-annotation-kind = "";
                        root.hovered-annotation-id = -1;
                        return accept;
                    }
                    if (root.is-zen-mode) {
                        root.exit-zen-mode();
                        return accept;
                    }
                } else if (root.selected-annotation-id > 0) {
                    if (event.text == "1") { root.selected-color-index = 0; root.update-annotation-color(root.selected-annotation-id, 0); return accept; }
                    else if (event.text == "2") { root.selected-color-index = 1; root.update-annotation-color(root.selected-annotation-id, 1); return accept; }
                    else if (event.text == "3") { root.selected-color-index = 2; root.update-annotation-color(root.selected-annotation-id, 2); return accept; }
                    else if (event.text == "4") { root.selected-color-index = 3; root.update-annotation-color(root.selected-annotation-id, 3); return accept; }
                    else if (event.text == "5") { root.selected-color-index = 4; root.update-annotation-color(root.selected-annotation-id, 4); return accept; }
                    else if (event.text == "6") { root.selected-color-index = 5; root.update-annotation-color(root.selected-annotation-id, 5); return accept; }
                    else if (event.text == Key.Delete || event.text == Key.Backspace) {
                        root.delete-annotation(root.selected-annotation-id);
                        root.show-popup = false;
                        root.selected-annotation-id = -1;
                        root.selected-annotation-kind = "";
                        root.hovered-annotation-id = -1;
                        return accept;
                    }
                } else if (root.has-selection && !root.show-note-input) {
                    if (event.text == "1") { root.selected-color-index = 0; return accept; }
                    else if (event.text == "2") { root.selected-color-index = 1; return accept; }
                    else if (event.text == "3") { root.selected-color-index = 2; return accept; }
                    else if (event.text == "4") { root.selected-color-index = 3; return accept; }
                    else if (event.text == "5") { root.selected-color-index = 4; return accept; }
                    else if (event.text == "6") { root.selected-color-index = 5; return accept; }
                } else if (event.modifiers.alt && event.text == Key.LeftArrow) {
                    root.nav-back();
                    return accept;
                } else if (event.modifiers.alt && event.text == Key.RightArrow) {
                    root.nav-forward();
                    return accept;
                } else if (event.text == Key.LeftArrow || event.text == Key.PageUp || event.text == Key.UpArrow) {
                    root.prev-page();
                    return accept;
                } else if (event.text == Key.RightArrow || event.text == Key.PageDown || event.text == Key.DownArrow) {
                    root.next-page();
                    return accept;
                } else if (event.text == "t" || event.text == "T" || event.text == "p" || event.text == "P") {
                    root.cycle-paper-theme();
                    return accept;
                } else if (event.text == "w" || event.text == "W") {
                    root.is-fit-width = true;
                    root.zoom-fit-width();
                    return accept;
                }
            }
            return reject;
        }

        key-released(event) => {
            if (event.text == Key.Control || event.text == Key.ControlR || event.text == "\u{11}" || event.text == "\u{16}") {
                root.is-ctrl-pressed = false;
            }
            return reject;
        }

        focus-lost(reason) => {
            root.is-ctrl-pressed = false;
            root.is-sidebar-resizing = false;
        }

        
VerticalLayout {
            padding: 0;
            spacing: 0;

            // Top Tab Bar (38px)
            if !root.is-zen-mode && root.open-tabs.length > 0: Rectangle {
                height: 38px;
                background: Theme.sidebar-bg;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    spacing: 4px;
                    alignment: start;

                    for tab[idx] in root.open-tabs : tab-item := TabItem {
                        title: tab.title;
                        is-active: tab.is-active;
                        is-dirty: tab.is-dirty;
                        clicked => { root.select-tab(idx); }
                        close-clicked => { root.close-tab(idx); }
                        context-menu(local-x, local-y) => {
                            root.tab-menu-index = idx;
                            root.tab-menu-x = min(root.width - 210px, max(8px, tab-item.x + local-x));
                            root.tab-menu-y = 38px;
                            root.show-tab-menu = true;
                        }
                    }

                    // New Tab Button (+)
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: new-tab-ta.pressed ? Theme.active-bg : new-tab-ta.has-hover ? Theme.hover-bg : transparent;
                        border-width: 1px;
                        border-color: new-tab-ta.has-hover ? Theme.border-subtle : transparent;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "+";
                            font-family: "Inter";
                            font-size: 18px;
                            font-weight: 500;
                            color: new-tab-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        new-tab-ta := TouchArea {
                            clicked => { root.new-tab(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            // Top Header Bar (60px)
            if !root.is-zen-mode: Rectangle {
                height: 60px;
                background: Theme.card-bg;
                border-width: 0;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 14px;
                    alignment: space-between;

                    // Left Group: Document Chip, Open PDF, Save, & History Undo/Redo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Document File Chip (Click to toggle Recent Books list)
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: chip-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                            border-width: 1px;
                            border-color: chip-ta.has-hover ? Theme.border : Theme.border-subtle;
                            animate background { duration: 100ms; }
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/file-text.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: root.file-title != "" ? root.file-title : "Folio Reader";
                                    font-family: "Inter";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 240px;
                                }

                                Image {
                                    source: @image-url("../assets/icons/chevron-down.svg");
                                    width: 15px;
                                    height: 15px;
                                    colorize: Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            chip-ta := TouchArea {
                                clicked => { root.show-recent-books = !root.show-recent-books; }
                                mouse-cursor: pointer;
                            }
                        }

                        // Signature Accent Button: Open PDF (before undo/redo)
                        SignaturePillButton {
                            icon: @image-url("../assets/icons/folder-open.svg");
                            text: "Open PDF";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.open-document(); }
                        }

                        // Save Button (when dirty, after Open PDF)
                        if root.is-dirty: Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: save-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            border-width: 1px;
                            border-color: Theme.accent-border;
                            animate background { duration: 100ms; }
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 7px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/check.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.on-accent;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: root.is-saving ? "Saving..." : "Save";
                                    font-family: "Inter";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.on-accent;
                                    vertical-alignment: center;
                                }
                            }

                            save-ta := TouchArea {
                                clicked => { root.save-document(); }
                                mouse-cursor: pointer;
                            }
                        }

                        // Saved Confirmation Badge
                        if !root.is-dirty && root.show-saved-badge: Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.surface-subtle;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/check.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.text-primary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Saved";
                                    font-family: "Inter";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Undo & Redo
                        IconButton {
                            text: "↺";
                            has-icon: false;
                            enabled: root.can-undo;
                            size: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.undo(); }
                        }

                        IconButton {
                            text: "↻";
                            has-icon: false;
                            enabled: root.can-redo;
                            size: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.redo(); }
                        }
                    }

                    // Center Group: View Mode Switcher & Page Stepper
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        // Segmented View Mode Pill: Page | Dual | Scroll
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.pill-track;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;

                                ViewModeSegment {
                                    icon: @image-url("../assets/icons/book-open.svg");
                                    text: "Page";
                                    active: !root.is-scroll-view && !root.is-dual-page;
                                    clicked => {
                                        root.set-dual-page(false);
                                        root.set-view-mode(false);
                                    }
                                }

                                ViewModeSegment {
                                    icon: @image-url("../assets/icons/columns-2.svg");
                                    text: "Dual";
                                    active: !root.is-scroll-view && root.is-dual-page;
                                    clicked => {
                                        root.set-dual-page(true);
                                    }
                                }

                                ViewModeSegment {
                                    icon: @image-url("../assets/icons/scroll.svg");
                                    text: "Scroll";
                                    active: root.is-scroll-view;
                                    clicked => {
                                        root.set-dual-page(false);
                                        root.set-view-mode(true);
                                    }
                                }
                            }
                        }

                        // Navigation History Pill: Back / Forward
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 2px;
                                alignment: center;

                                IconButton {
                                    icon: @image-url("../assets/icons/arrow-left.svg");
                                    enabled: root.can-nav-back;
                                    size: 30px;
                                    icon-size: 16px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.nav-back(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/arrow-right.svg");
                                    enabled: root.can-nav-forward;
                                    size: 30px;
                                    icon-size: 16px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.nav-forward(); }
                                }
                            }
                        }

                        // Page Stepper Pill: < Page 12 / 145 >
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;
                                alignment: center;

                                IconButton {
                                    icon: @image-url("../assets/icons/chevron-left.svg");
                                    enabled: root.can-prev;
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.prev-page(); }
                                }

                                // Interactive Page Input Field
                                page-input-box := Rectangle {
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    background: page-input.has-focus ? Theme.surface-subtle : Theme.card-subtle;
                                    border-radius: 5px;
                                    border-width: page-input.has-focus ? 1.5px : 1px;
                                    border-color: page-input.has-focus ? Theme.accent : Theme.border-subtle;
                                    min-width: 44px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        page-input := TextInput {
                                            text <=> root.current-page-input;
                                            font-family: "Inter";
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            single-line: true;
                                            min-width: 32px;

                                            property <bool> trigger-focus: root.focus-page-input-flag;
                                            changed trigger-focus => {
                                                if (self.trigger-focus) {
                                                    self.focus();
                                                    root.focus-page-input-flag = false;
                                                }
                                            }

                                            accepted => {
                                                root.go-to-page(self.text);
                                                keyboard-handler.focus();
                                            }

                                            key-pressed(event) => {
                                                if (event.text == Key.Return) {
                                                    root.go-to-page(self.text);
                                                    keyboard-handler.focus();
                                                    return accept;
                                                } else if (event.text == Key.Escape) {
                                                    root.reset-page-input();
                                                    keyboard-handler.focus();
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.page-suffix-display;
                                    font-family: "Inter";
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/chevron-right.svg");
                                    enabled: root.can-next;
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.next-page(); }
                                }
                            }
                        }
                    }

                    // Right Group: Zoom, Rotate, Save, and Signature Open PDF Button
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Zoom & Rotate Pill
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                alignment: center;

                                IconButton {
                                    icon: @image-url("../assets/icons/zoom-out.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.is-fit-width = false; root.zoom-out(); }
                                }

                                Rectangle {
                                    height: 28px;
                                    min-width: 52px;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: root.zoom-display;
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: zoom-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    zoom-ta := TouchArea {
                                        clicked => { root.is-fit-width = false; root.zoom-reset(); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/zoom-in.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.is-fit-width = false; root.zoom-in(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/fit-to-page.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.is-fit-width = false; root.zoom-fit(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/fit-to-width.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    active: root.is-fit-width;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.is-fit-width = true; root.zoom-fit-width(); }
                                }

                                IconButton {
                                    icon: root.is-zen-mode ? @image-url("../assets/icons/minimize-2.svg") : @image-url("../assets/icons/maximize-2.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.toggle-zen-mode(); }
                                }

                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    background: Theme.border;
                                    y: (parent.height - self.height) / 2;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/rotate-cw.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.rotate-clockwise(); }
                                }

                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    background: Theme.border;
                                    y: (parent.height - self.height) / 2;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/info.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.show-doc-info = true; }
                                }
                            }
                        }
                    }
                }
            }

            // Main Workspace Area// Main Workspace Area (Navigation Rail + Sidebar + Document Viewport)
            HorizontalLayout {
                spacing: 0;
                padding: 0;

                // Left Navigation Rail (Vertical Icon Dock)
                if !root.is-zen-mode: Rectangle {
                    width: 58px;
                    background: Theme.card-bg;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        alignment: space-between;

                        // Top Group: Monogram & Tabs
                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Brand Monogram
                            Rectangle {
                                width: 42px;
                                height: 42px;
                                border-radius: 13px;
                                background: Theme.accent;
                                border-width: 1px;
                                border-color: Theme.accent-border;

                                Text {
                                    text: "F";
                                    font-family: "Inter";
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: Theme.on-accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 26px;
                                height: 1px;
                                background: Theme.border;
                                x: (parent.width - self.width) / 2;
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/list.svg");
                                active: root.show-sidebar && root.sidebar-tab == 0;
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 0) {
                                        root.toggle-sidebar();
                                    } else {
                                        root.sidebar-tab = 0;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                    }
                                }
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/highlighter.svg");
                                active: root.show-sidebar && root.sidebar-tab == 1;
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 1) {
                                        root.toggle-sidebar();
                                    } else {
                                        root.sidebar-tab = 1;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                    }
                                }
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/message-square.svg");
                                active: root.show-sidebar && root.sidebar-tab == 2;
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 2) {
                                        root.toggle-sidebar();
                                    } else {
                                        root.sidebar-tab = 2;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                    }
                                }
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/search.svg");
                                active: root.show-sidebar && root.sidebar-tab == 3;
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 3) {
                                        root.close-search();
                                    } else {
                                        root.sidebar-tab = 3;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                        root.show-search = true;
                                    }
                                }
                            }
                        }

                        // Bottom Group: Paper Theme & App Chrome Theme
                        VerticalLayout {
                            spacing: 8px;
                            alignment: end;

                            // Paper Theme (Document Color Mode)
                            NavRailButton {
                                icon: @image-url("../assets/icons/palette.svg");
                                clicked => {
                                    root.cycle-paper-theme();
                                }
                            }

                            // App Chrome Theme (Dark / Light UI)
                            NavRailButton {
                                icon: Theme.dark ? @image-url("../assets/icons/sun.svg") : @image-url("../assets/icons/moon.svg");
                                clicked => {
                                    root.toggle-theme();
                                }
                            }
                        }
                    }
                }

                // Sidebar Drawer (Contents, Highlights, Notes, Search)
                sidebar := Rectangle {
                    width: (root.show-sidebar && !root.is-zen-mode && !root.has-error) ? root.sidebar-width : 0px;
                    clip: true;
                    background: Theme.card-bg;
                    animate width { duration: root.is-sidebar-resizing ? 0ms : 160ms; easing: ease-out; }

                    // Dismiss overlay for sort menu
                    if root.show-sort-menu: TouchArea {
                        width: 100%;
                        height: 100%;
                        z: 45;
                        clicked => {
                            root.show-sort-menu = false;
                        }
                    }

                    // Sort & View Dropdown Popover
                    if root.show-sort-menu: Rectangle {
                        x: parent.width - 190px;
                        y: 44px;
                        width: 178px;
                        height: sm-vl.preferred-height;
                        z: 50;
                        background: Theme.card-bg;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: Theme.dark ? #00000088 : #00000028;
                        clip: true;

                        sm-vl := VerticalLayout {
                            padding: 6px;
                            spacing: 3px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 6px;
                                padding-bottom: 4px;
                                Text {
                                    text: "SORT & VIEW";
                                    font-family: "Inter";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-muted;
                                }
                            }

                            // 0: Document Order (with chapters)
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: sm0-ta.has-hover ? Theme.hover-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "Document Order";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: root.annotation-sort-mode == 0 ? 600 : 400;
                                        color: root.annotation-sort-mode == 0 ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    if root.annotation-sort-mode == 0: Image {
                                        source: @image-url("../assets/icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                sm0-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-sort-menu = false;
                                        root.set-annotation-sort-mode(0);
                                    }
                                }
                            }

                            // 1: Newest First
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: sm1-ta.has-hover ? Theme.hover-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "Newest First";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: root.annotation-sort-mode == 1 ? 600 : 400;
                                        color: root.annotation-sort-mode == 1 ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    if root.annotation-sort-mode == 1: Image {
                                        source: @image-url("../assets/icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                sm1-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-sort-menu = false;
                                        root.set-annotation-sort-mode(1);
                                    }
                                }
                            }

                            // 2: Oldest First
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: sm2-ta.has-hover ? Theme.hover-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "Oldest First";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: root.annotation-sort-mode == 2 ? 600 : 400;
                                        color: root.annotation-sort-mode == 2 ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    if root.annotation-sort-mode == 2: Image {
                                        source: @image-url("../assets/icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                sm2-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-sort-menu = false;
                                        root.set-annotation-sort-mode(2);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        width: root.sidebar-width;
                        height: 100%;
                        padding: 0;
                        spacing: 0;

                        // Sidebar Header
                        Rectangle {
                            height: 54px;
                            background: Theme.surface-subtle;

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                width: 100%;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    Text {
                                        text: root.sidebar-tab == 0 ? "Document Outline" : root.sidebar-tab == 1 ? "Highlights" : root.sidebar-tab == 2 ? "Notes" : "Search";
                                        font-family: "Inter";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }

                                    // Count badge
                                    if root.sidebar-tab == 1 && root.highlight-items.length > 0: Rectangle {
                                        height: 24px;
                                        min-width: 24px;
                                        border-radius: 12px;
                                        background: Theme.card-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.highlight-items.length;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.sidebar-tab == 2 && root.note-items.length > 0: Rectangle {
                                        height: 24px;
                                        min-width: 24px;
                                        border-radius: 12px;
                                        background: Theme.card-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.note-items.length;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.sidebar-tab == 3 && root.search-query != "" && root.search-results.length > 0: Rectangle {
                                        height: 24px;
                                        min-width: 24px;
                                        border-radius: 12px;
                                        background: Theme.card-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.search-results.length;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    y: (parent.height - 32px) / 2;

                                    if (root.sidebar-tab == 1 || root.sidebar-tab == 2) && (root.highlight-items.length > 0 || root.note-items.length > 0): IconButton {
                                        icon: @image-url("../assets/icons/arrow-down-up.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        active: root.show-sort-menu || root.annotation-sort-mode > 0;
                                        clicked => {
                                            root.show-sort-menu = !root.show-sort-menu;
                                        }
                                    }

                                    if (root.sidebar-tab == 1 || root.sidebar-tab == 2) && (root.highlight-items.length > 0 || root.note-items.length > 0): IconButton {
                                        icon: @image-url("../assets/icons/copy.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        clicked => { root.copy-annotations-markdown(); }
                                    }

                                    if (root.sidebar-tab == 1 || root.sidebar-tab == 2) && (root.highlight-items.length > 0 || root.note-items.length > 0): IconButton {
                                        icon: @image-url("../assets/icons/download.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        clicked => { root.export-annotations-markdown(); }
                                    }

                                    IconButton {
                                        icon: @image-url("../assets/icons/x.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        clicked => {
                                            if (root.sidebar-tab == 3) {
                                                root.close-search();
                                            } else {
                                                root.toggle-sidebar();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 0 Body: Table of Contents
                        if root.sidebar-tab == 0: VerticalLayout {
                            vertical-stretch: 1;

                            if root.toc-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Outline";
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "This document does not provide a table of contents.";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.toc-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.toc-items: row := Rectangle {
                                    height: 42px;
                                    width: parent.width;
                                    background: item.page == root.current-page ? Theme.active-bg : row-ta.has-hover ? Theme.hover-bg : transparent;
                                    animate background { duration: 100ms; }

                                    if item.page == root.current-page: Rectangle {
                                        x: 0;
                                        width: 4px;
                                        height: 100%;
                                        background: Theme.accent;
                                    }

                                    row-ta := TouchArea {
                                        clicked => { root.jump-to-page(item.page); }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px + item.depth * 18px;
                                        padding-right: 16px;
                                        spacing: 8px;

                                        if item.has-children: chevron-btn := Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 6px;
                                            background: chev-ta.has-hover ? Theme.hover-bg : transparent;

                                            Image {
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                                width: 16px;
                                                height: 16px;
                                                source: item.is-expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg");
                                                colorize: chev-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                            }

                                            chev-ta := TouchArea {
                                                clicked => { root.toggle-toc-collapse(item.id); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        if !item.has-children: Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: item.title;
                                            font-family: "Inter";
                                            font-size: 15px;
                                            font-weight: item.page == root.current-page ? 600 : 400;
                                            color: item.page == root.current-page ? Theme.text-primary : row-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: item.display-page;
                                            font-family: "Inter";
                                            font-size: 14px;
                                            color: item.page == root.current-page ? Theme.accent : Theme.text-muted;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 1 Body: Highlights & Markups
                        if root.sidebar-tab == 1: VerticalLayout {
                            vertical-stretch: 1;

                            if root.highlight-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Highlights Yet";
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Select text on any page to highlight, underline, or strike through.";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.highlight-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.highlight-items: VerticalLayout {
                                    spacing: 0;

                                    if item.group-header != "": Rectangle {
                                        height: 32px;
                                        background: Theme.surface-subtle;

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.border-subtle;
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: start;

                                            Text {
                                                text: item.group-header;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    h-card := Rectangle {
                                        height: 68px;
                                        width: parent.width;
                                        background: h-ta.has-hover ? Theme.hover-bg : transparent;
                                        border-width: 0;

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.border-subtle;
                                        }

                                        // Color swatch line
                                        Rectangle {
                                            x: 0;
                                            width: 4px;
                                            height: 100%;
                                            background: item.color;
                                        }

                                        h-ta := TouchArea {
                                            x: 0;
                                            y: 0;
                                            width: parent.width - 48px;
                                            height: parent.height;
                                            clicked => { root.jump-to-page(item.page); }
                                            mouse-cursor: pointer;
                                        }

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: space-between;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                horizontal-stretch: 1;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;

                                                    Text {
                                                        text: item.kind == "highlight" ? "Highlight" : item.kind == "underline" ? "Underline" : "Strikethrough";
                                                        font-family: "Inter";
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: item.color;
                                                    }

                                                    Text {
                                                        text: item.display-date != "" ? "• p. \{item.display-page} • \{item.display-date}" : "• p. \{item.display-page}";
                                                        font-family: "Inter";
                                                        font-size: 12px;
                                                        color: Theme.text-muted;
                                                    }
                                                }

                                                Text {
                                                    text: "\{item.snippet}";
                                                    font-family: "Inter";
                                                    font-size: 15px;
                                                    color: Theme.text-primary;
                                                    overflow: elide;
                                                    max-width: root.sidebar-width - 80px;
                                                }
                                            }

                                            // Delete icon button
                                            IconButton {
                                                icon: @image-url("../assets/icons/trash.svg");
                                                size: 32px;
                                                icon-size: 18px;
                                                border-radius: 8px;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.delete-annotation(item.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 2 Body: Notes
                        if root.sidebar-tab == 2: VerticalLayout {
                            vertical-stretch: 1;

                            if root.note-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Notes Yet";
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Select text on any page and click the note icon to attach a thought.";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.note-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.note-items: VerticalLayout {
                                    spacing: 0;

                                    if item.group-header != "": Rectangle {
                                        height: 32px;
                                        background: Theme.surface-subtle;

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.border-subtle;
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: start;

                                            Text {
                                                text: item.group-header;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    n-card := Rectangle {
                                        height: 82px;
                                        width: parent.width;
                                        background: n-ta.has-hover ? Theme.hover-bg : transparent;

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.border-subtle;
                                        }

                                        // Color swatch line
                                        Rectangle {
                                            x: 0;
                                            width: 4px;
                                            height: 100%;
                                            background: item.color;
                                        }

                                        n-ta := TouchArea {
                                            x: 0;
                                            y: 0;
                                            width: parent.width - 48px;
                                            height: parent.height;
                                            clicked => { root.jump-to-page(item.page); }
                                            mouse-cursor: pointer;
                                        }

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: space-between;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 4px;
                                                horizontal-stretch: 1;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;

                                                    Text {
                                                        text: "Note";
                                                        font-family: "Inter";
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: item.color;
                                                    }

                                                    Text {
                                                        text: item.display-date != "" ? "• p. \{item.display-page} • \{item.display-date}" : "• p. \{item.display-page}";
                                                        font-family: "Inter";
                                                        font-size: 12px;
                                                        color: Theme.text-muted;
                                                    }
                                                }

                                                Text {
                                                    text: item.comment;
                                                    font-family: "Inter";
                                                    font-size: 15px;
                                                    font-weight: 600;
                                                    color: Theme.text-primary;
                                                    overflow: elide;
                                                    max-width: root.sidebar-width - 80px;
                                                }

                                                Text {
                                                    text: "“\{item.snippet}”";
                                                    font-family: "Inter";
                                                    font-size: 13px;
                                                    color: Theme.text-muted;
                                                    overflow: elide;
                                                    max-width: root.sidebar-width - 80px;
                                                }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/trash.svg");
                                                size: 32px;
                                                icon-size: 18px;
                                                border-radius: 8px;
                                                y: (parent.height - self.height) / 2;
                                                clicked => {
                                                    if (item.kind == "note") {
                                                        root.delete-annotation(item.id);
                                                    } else {
                                                        root.update-annotation-note(item.id, "");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 3 Body: Search in Document
                        if root.sidebar-tab == 3: VerticalLayout {
                            vertical-stretch: 1;
                            padding: 0;
                            spacing: 0;

                            // Search Controls Area (Search input + options row)
                            Rectangle {
                                background: Theme.surface-subtle;

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: 100%;
                                    background: Theme.border;
                                }

                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 12px;
                                    padding-bottom: 12px;
                                    spacing: 10px;

                                    // Row 1: Search Input Pill
                                    search-box := Rectangle {
                                        height: 40px;
                                        background: Theme.card-bg;
                                        border-radius: 20px;
                                        border-width: 1px;
                                        border-color: search-input.has-focus ? Theme.border-strong : Theme.border;
                                        animate border-color { duration: 100ms; }

                                        TouchArea {
                                            clicked => { search-input.focus(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            Image {
                                                source: @image-url("../assets/icons/search.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: Theme.text-secondary;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            search-input := TextInput {
                                                init => { self.focus(); }
                                                text <=> root.search-query;
                                                font-family: "Inter";
                                                font-size: 15px;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                                single-line: true;

                                                edited => {
                                                    root.search-query-changed(self.text);
                                                }

                                                key-pressed(event) => {
                                                    if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                                        root.toggle-search-match-case();
                                                        return accept;
                                                    } else if (event.modifiers.alt && (event.text == "w" || event.text == "W")) {
                                                        root.toggle-search-match-whole-word();
                                                        return accept;
                                                    } else if (event.text == Key.Return) {
                                                        if (event.modifiers.shift) {
                                                            root.search-prev();
                                                        } else {
                                                            root.search-next();
                                                        }
                                                        return accept;
                                                    } else if (event.text == Key.Escape) {
                                                        root.close-search();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }

                                            if root.search-query != "": IconButton {
                                                icon: @image-url("../assets/icons/x.svg");
                                                size: 26px;
                                                icon-size: 16px;
                                                border-radius: 13px;
                                                y: (parent.height - self.height) / 2;
                                                clicked => {
                                                    root.search-query = "";
                                                    root.search-query-changed("");
                                                }
                                            }
                                        }
                                    }

                                    // Row 2: Options & Navigation Controls
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: space-between;

                                        // Left: Modifiers (Aa and [W])
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;

                                            IconButton {
                                                icon: @image-url("../assets/icons/case-sensitive.svg");
                                                active: root.search-match-case;
                                                accent-active: true;
                                                size: 34px;
                                                icon-size: 19px;
                                                border-radius: 8px;
                                                clicked => { root.toggle-search-match-case(); }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/whole-word.svg");
                                                active: root.search-match-whole-word;
                                                accent-active: true;
                                                size: 34px;
                                                icon-size: 19px;
                                                border-radius: 8px;
                                                clicked => { root.toggle-search-match-whole-word(); }
                                            }
                                        }

                                        // Right: Match Count Badge & Steppers
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: end;

                                            // Count badge (only displayed when there is a query typed in the field)
                                            if root.search-query != "": Rectangle {
                                                height: 30px;
                                                background: Theme.card-bg;
                                                border-radius: 15px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                y: (parent.height - self.height) / 2;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    alignment: center;

                                                    Text {
                                                        text: root.search-match-display != "" ? root.search-match-display : (root.is-searching ? "Searching..." : "0 results");
                                                        font-family: "Inter";
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: root.total-search-matches > 0 ? Theme.text-primary : Theme.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/chevron-up.svg");
                                                enabled: root.total-search-matches > 0;
                                                size: 30px;
                                                icon-size: 18px;
                                                border-radius: 8px;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.search-prev(); }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/chevron-down.svg");
                                                enabled: root.total-search-matches > 0;
                                                size: 30px;
                                                icon-size: 18px;
                                                border-radius: 8px;
                                                y: (parent.height - self.height) / 2;
                                                clicked => { root.search-next(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Search Results List
                            if root.search-results.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: root.is-searching ? "Searching..." : (root.search-query != "" ? "No Matches Found" : "Search in Document");
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.is-searching ? "Scanning pages for matches..." : (root.search-query != "" ? "No matches found for \"" + root.search-query + "\"" : "Enter a word or phrase to find matches across all pages.");
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.search-results.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.search-results: s-card := Rectangle {
                                    height: 72px;
                                    width: parent.width;
                                    background: item.is-active ? Theme.active-bg : (s-ta.has-hover ? Theme.hover-bg : transparent);
                                    animate background { duration: 100ms; }

                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        width: 100%;
                                        background: Theme.border-subtle;
                                    }

                                    // Active indicator bar
                                    Rectangle {
                                        x: 0;
                                        width: item.is-active ? 4px : 0px;
                                        height: 100%;
                                        background: Theme.accent;
                                    }

                                    s-ta := TouchArea {
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => {
                                            root.select-search-result(item.id);
                                        }
                                        mouse-cursor: pointer;
                                    }

                                    VerticalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        alignment: center;
                                        spacing: 5px;

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;

                                            Rectangle {
                                                height: 22px;
                                                border-radius: 5px;
                                                background: item.is-active ? Theme.accent : Theme.surface-subtle;
                                                border-width: 1px;
                                                border-color: item.is-active ? Theme.accent-border : Theme.border-subtle;

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    alignment: center;

                                                    Text {
                                                        text: "Page \{item.display-page}";
                                                        font-family: "Inter";
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: item.is-active ? Theme.on-accent : Theme.text-secondary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if item.is-active: Text {
                                                text: "● Current";
                                                font-family: "Inter";
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: Theme.accent;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: item.snippet;
                                            font-family: "Inter";
                                            font-size: 15px;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                            max-width: parent.width - 32px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Sidebar Splitter / Drag Resize Handle
                if root.show-sidebar && !root.is-zen-mode && !root.has-error: sidebar-splitter := Rectangle {
                    width: 5px;
                    background: (splitter-ta.has-hover || root.is-sidebar-resizing) ? Theme.accent : transparent;
                    animate background { duration: 100ms; }

                    if !(splitter-ta.has-hover || root.is-sidebar-resizing): Rectangle {
                        width: 1px;
                        height: 100%;
                        background: Theme.border;
                        x: 0;
                    }

                    splitter-ta := TouchArea {
                        mouse-cursor: col-resize;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {
                                    root.is-sidebar-resizing = true;
                                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                    root.is-sidebar-resizing = false;
                                    root.save-sidebar-width(root.sidebar-width);
                                }
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.is-sidebar-resizing = true;
                                root.sidebar-width = max(240px, min(min(root.width - 250px, 750px), root.sidebar-width + self.mouse-x - self.pressed-x));
                            }
                        }
                    }
                }

                // Document Viewport / Error Area
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.dark
                        ? (root.paper-theme == 1 ? #22201B : #10110C)
                        : (root.paper-theme == 1 ? #EFE9D9 : root.paper-theme == 2 ? #22231C : Theme.canvas-bg);
                    clip: true;

                    if root.has-error: Rectangle {
                        width: root.recent-books.length > 0 ? 520px : 460px;
                        height: root.recent-books.length > 0 ? min(parent.height - 48px, 520px) : 260px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: Theme.card-bg;
                        border-radius: 20px;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 24px;
                        drop-shadow-color: Theme.dark ? #000000a0 : #00000015;
                        clip: true;

                        VerticalLayout {
                            padding: root.recent-books.length > 0 ? 24px : 32px;
                            spacing: root.recent-books.length > 0 ? 14px : 16px;
                            alignment: root.recent-books.length > 0 ? start : center;

                            Rectangle {
                                width: root.recent-books.length > 0 ? 44px : 52px;
                                height: root.recent-books.length > 0 ? 44px : 52px;
                                border-radius: 14px;
                                background: Theme.accent-subtle;
                                border-width: 1px;
                                border-color: Theme.accent-border;
                                x: (parent.width - self.width) / 2;

                                Image {
                                    source: @image-url("../assets/icons/folder-open.svg");
                                    width: root.recent-books.length > 0 ? 20px : 24px;
                                    height: root.recent-books.length > 0 ? 20px : 24px;
                                    colorize: Theme.on-accent;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: "Welcome to Folio";
                                    font-family: "Inter";
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.error-message != "" ? root.error-message : "Open a PDF document to begin reading with rich annotations and dual-page view.";
                                    font-family: "Inter";
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            SignaturePillButton {
                                icon: @image-url("../assets/icons/folder-open.svg");
                                text: "Select PDF Document";
                                x: (parent.width - self.width) / 2;
                                clicked => { root.open-document(); }
                            }

                            if root.recent-books.length > 0: Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }

                            if root.recent-books.length > 0: HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Image {
                                        source: @image-url("../assets/icons/clock.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: "RECENT DOCUMENTS";
                                        font-family: "Inter";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "\{root.recent-books.length} recent";
                                    font-family: "Inter";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            if root.recent-books.length > 0: ScrollView {
                                width: 100%;
                                height: min(200px, root.recent-books.length * 44px);

                                VerticalLayout {
                                    spacing: 2px;
                                    padding-right: 6px;

                                    for item in root.recent-books : Rectangle {
                                        height: 40px;
                                        border-radius: 8px;
                                        background: welcome-rec-ta.has-hover ? Theme.hover-bg : transparent;
                                        animate background { duration: 80ms; }

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                Image {
                                                    source: @image-url("../assets/icons/file-text.svg");
                                                    width: 15px;
                                                    height: 15px;
                                                    colorize: welcome-rec-ta.has-hover ? Theme.accent : Theme.text-secondary;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 1px;

                                                    Text {
                                                        text: item.filename;
                                                        font-family: "Inter";
                                                        font-size: 13px;
                                                        font-weight: 500;
                                                        color: Theme.text-primary;
                                                        overflow: elide;
                                                        max-width: 320px;
                                                    }

                                                    Text {
                                                        text: item.path;
                                                        font-family: "Inter";
                                                        font-size: 11px;
                                                        color: Theme.text-muted;
                                                        overflow: elide;
                                                        max-width: 320px;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                width: 58px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: Theme.accent-subtle;
                                                y: (parent.height - self.height) / 2;

                                                Text {
                                                    text: "p. \{item.page}";
                                                    font-family: "Inter";
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                    color: Theme.on-accent;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        welcome-rec-ta := TouchArea {
                                            clicked => {
                                                root.open-recent-book(item.path);
                                            }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Single Page / Dual Page View
                    if !root.has-error && !root.is-scroll-view: view-scroll := Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: max(parent.width, (root.is-dual-page && root.has-secondary-page) ? (root.page-width + root.secondary-page-width + 88px) : (root.page-width + 64px));
                        content-height: max(parent.height, (root.is-dual-page && root.has-secondary-page) ? (max(root.page-height, root.secondary-page-height) + 64px) : (root.page-height + 64px));

                        viewport-touch := TouchArea {
                            width: view-scroll.content-width;
                            height: view-scroll.content-height;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.move) {
                                    root.hovered-annotation-id = -1;
                                    keyboard-handler.focus();
                                } else if (event.kind == PointerEventKind.down) {
                                    keyboard-handler.focus();
                                }
                            }

                            scroll-event(event) => {
                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                    if (event.delta-y > 0) {
                                        root.zoom-in();
                                        return accept;
                                    } else if (event.delta-y < 0) {
                                        root.zoom-out();
                                        return accept;
                                    }
                                }
                                return reject;
                            }

                            // Page Card with soft shadow and rounded corners
                            page-card := Rectangle {
                                x: (root.is-dual-page && root.has-secondary-page)
                                    ? max(32px, (view-scroll.content-width - (root.page-width + root.secondary-page-width + 24px)) / 2)
                                    : max(32px, (view-scroll.content-width - self.width) / 2);
                                y: max(32px, (view-scroll.content-height - self.height) / 2);
                                width: root.page-width;
                                height: root.page-height;
                                background: root.paper-theme == 1 ? #F4ECD8 : root.paper-theme == 2 ? #18181A : #ffffff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.paper-theme == 2 ? #2B2D24 : root.paper-theme == 1 ? #DCD4BC : Theme.border;
                                drop-shadow-blur: root.paper-theme == 2 ? 24px : Theme.dark ? 16px : 0px;
                                drop-shadow-offset-y: Theme.dark ? 4px : 0px;
                                drop-shadow-color: root.paper-theme == 2 ? #00000080 : Theme.dark ? #00000050 : #00000000;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: root.page-image;
                                    opacity: root.page-opacity;
                                    animate opacity {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }
                                }

                                // Interactive Text Selection Highlights directly on actual text
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        if sel-r.page == root.current-page: Rectangle {
                                            x: sel-r.x;
                                            y: sel-r.y;
                                            width: sel-r.width;
                                            height: sel-r.height;
                                            background: #3b82f640;
                                            border-radius: 2px;
                                        }
                                    }
                                }

                                // Search Match Highlights on Document Paper (Single Page View)
                                if root.show-search: Rectangle {
                                    for hl in root.page-search-highlights: Rectangle {
                                        x: hl.x;
                                        y: hl.y;
                                        width: hl.width;
                                        height: hl.height;
                                        background: hl.is-current ? #f59e0b35 : #fde04730;
                                        border-radius: 2px;
                                        border-width: hl.is-current ? 1.5px : 0px;
                                        border-color: hl.is-current ? #ea580c : transparent;
                                    }
                                }

                                // TouchArea for dragging text selection
                                page-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;

                                    scroll-event(event) => {
                                        if (event.modifiers.control || root.is-ctrl-pressed) {
                                            if (event.delta-y > 0) {
                                                root.zoom-in();
                                                return accept;
                                            } else if (event.delta-y < 0) {
                                                root.zoom-out();
                                                return accept;
                                            }
                                        }
                                        return reject;
                                    }

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move) {
                                            root.hovered-annotation-id = -1;
                                            keyboard-handler.focus();
                                        } else if (event.button == PointerEventButton.left) {
                                            if (event.kind == PointerEventKind.down) {
                                                keyboard-handler.focus();
                                                root.selected-annotation-id = -1;
                                                root.selected-annotation-kind = "";
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-started(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                            } else if (event.kind == PointerEventKind.up) {
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-completed(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                            }
                                        }
                                    }

                                    moved => {
                                        if (page-ta.pressed) {
                                            root.selection-dragged(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                        }
                                    }
                                }

                                // Embedded Document Links (Table of Contents, internal jumps, external URLs)
                                for link in root.page-links: Rectangle {
                                    if link.page == root.current-page: Rectangle {
                                        x: link.x;
                                        y: link.y;
                                        width: link.width;
                                        height: link.height;
                                        background: link-ta.has-hover ? #3b82f618 : transparent;
                                        border-radius: 2px;
                                        border-width: link-ta.has-hover ? 1px : 0px;
                                        border-color: link-ta.has-hover ? #3b82f640 : transparent;

                                        link-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = -1;
                                                    keyboard-handler.focus();
                                                } else if (event.button == PointerEventButton.left) {
                                                    if (event.kind == PointerEventKind.down) {
                                                        keyboard-handler.focus();
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.selection-started(root.current-page, link.x + link-ta.mouse-x, link.y + link-ta.mouse-y);
                                                    } else if (event.kind == PointerEventKind.up) {
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.selection-completed(root.current-page, link.x + link-ta.mouse-x, link.y + link-ta.mouse-y);
                                                    }
                                                }
                                            }

                                            moved => {
                                                if (link-ta.pressed) {
                                                    root.selection-dragged(root.current-page, link.x + link-ta.mouse-x, link.y + link-ta.mouse-y);
                                                }
                                            }

                                            clicked => {
                                                if (link.target-page >= 0) {
                                                    root.jump-to-page(link.target-page);
                                                } else if (link.uri != "") {
                                                    root.open-external-url(link.uri);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Render Page Annotations on top of page-ta so hover and click are intercepted
                                for annot in root.page-annotations: Rectangle {
                                    if annot.page == root.current-page: Rectangle {
                                        x: annot.x;
                                        y: annot.y;
                                        width: annot.w;
                                        height: annot.h;

                                        // Selection visual recognition feedback rectangle (clean, non-obscuring)
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.selected-annotation-id == annot.id ? #3b82f618 : transparent;
                                            border-width: root.selected-annotation-id == annot.id ? 1px : 0px;
                                            border-color: root.selected-annotation-id == annot.id ? #3b82f680 : transparent;
                                        }

                                        // Underline (anchored with breathing space below character baseline, scaling with zoom)
                                        if annot.kind == "underline": Rectangle {
                                            y: parent.height * 0.88;
                                            width: 100%;
                                            height: max(1.2px, root.zoom-level * 1.35px);
                                            background: annot.color;
                                        }

                                        // Strikethrough (centered directly through lowercase x-height, scaling with zoom)
                                        if annot.kind == "strikethrough": Rectangle {
                                            y: parent.height * 0.52;
                                            width: 100%;
                                            height: max(1.0px, root.zoom-level * 1.0px);
                                            background: annot.color;
                                        }

                                        // Margin Gutter Note Pin: positioned in the right page margin so text is never covered
                                        if annot.show-note-icon: margin-pin := Rectangle {
                                            x: root.page-width - annot.x - 28px;
                                            y: (parent.height - self.height) / 2;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 6px;
                                            background: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? annot.color : annot.color.darker(0.15);
                                            border-width: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? 2px : 1px;
                                            border-color: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? #ffffff : #ffffff50;
                                            drop-shadow-blur: (root.hovered-annotation-id == annot.id || pin-ta.has-hover) ? 6px : 3px;
                                            drop-shadow-color: #00000080;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Image {
                                                source: @image-url("../assets/icons/message-square.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: #ffffff;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            pin-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                scroll-event(event) => {
                                                    if (event.modifiers.control || root.is-ctrl-pressed) {
                                                        if (event.delta-y > 0) {
                                                            root.zoom-in();
                                                            return accept;
                                                        } else if (event.delta-y < 0) {
                                                            root.zoom-out();
                                                            return accept;
                                                        }
                                                    }
                                                    return reject;
                                                }
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.move) {
                                                        root.hovered-annotation-id = annot.id;
                                                        keyboard-handler.focus();
                                                    }
                                                }
                                                clicked => {
                                                    keyboard-handler.focus();
                                                    root.popup-page = root.current-page;
                                                    root.selected-annotation-id = annot.id;
                                                    root.selected-annotation-kind = annot.kind;
                                                    root.selected-color-index = annot.color-index;
                                                    root.has-selection = false;
                                                    root.current-note-text = annot.comment;
                                                    root.show-note-input = true;
                                                    let p_width = max(root.note-input-width + 16px, 320px);
                                                    let p_height = root.note-input-height + 66px;
                                                    root.popup-x = round(max(8px, min(root.page-width - p_width - 8px, root.page-width - p_width - 16px)) / 1px) * 1px;
                                                    root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                    root.show-popup = true;
                                                }
                                            }
                                        }

                                        annot-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = annot.id;
                                                    keyboard-handler.focus();
                                                }
                                            }

                                            clicked => {
                                                keyboard-handler.focus();
                                                root.popup-page = root.current-page;
                                                root.selected-annotation-id = annot.id;
                                                root.selected-annotation-kind = annot.kind;
                                                root.selected-color-index = annot.color-index;
                                                root.has-selection = false;
                                                root.current-note-text = annot.comment;
                                                root.show-note-input = annot.comment != "" || annot.kind == "note";
                                                let p_width = root.show-note-input ? max(root.note-input-width + 16px, 320px) : 256px;
                                                let p_height = root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                                root.popup-x = round(max(8px, min(root.page-width - p_width - 8px, annot.x + (annot.w - p_width) / 2)) / 1px) * 1px;
                                                root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                root.show-popup = true;
                                            }
                                        }
                                    }
                                }

                                // Floating Annotation Icon Popup
                                if root.show-popup && root.popup-page == root.current-page: popup := Rectangle {
                                    x: round(root.popup-x / 1px) * 1px;
                                    y: round(root.popup-y / 1px) * 1px;
                                    width: root.show-note-input ? max(root.note-input-width + 16px, 350px) : (root.selected-annotation-id > 0 ? 310px : 350px);
                                    height: root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                    border-radius: 12px;
                                    background: Theme.card-bg;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    drop-shadow-blur: 10px;
                                    drop-shadow-offset-y: 3px;
                                    drop-shadow-color: Theme.dark ? #00000088 : #00000022;
                                    animate height { duration: 120ms; }
                                    animate width { duration: 120ms; }

                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 5px;
                                        padding-bottom: 7px;
                                        spacing: 5px;

                                        // Drag Grip Handle Bar (allows dragging anywhere on the paper)
                                        Rectangle {
                                            height: 6px;
                                            width: 100%;

                                            Rectangle {
                                                width: 32px;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: drag-ta.has-hover ? Theme.text-secondary : Theme.border-subtle;
                                                x: (parent.width - self.width) / 2;
                                                y: 1px;
                                            }

                                            drag-ta := TouchArea {
                                                mouse-cursor: move;
                                                pointer-event(event) => {
                                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                        root.popup-grab-x = self.mouse-x;
                                                        root.popup-grab-y = self.mouse-y;
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed) {
                                                        let max-w = max(8px, root.page-width - popup.width - 8px);
                                                        let max-h = max(8px, root.page-height - popup.height - 8px);
                                                        root.popup-x = round(max(8px, min(max-w, root.popup-x + self.mouse-x - root.popup-grab-x)) / 1px) * 1px;
                                                        root.popup-y = round(max(8px, min(max-h, root.popup-y + self.mouse-y - root.popup-grab-y)) / 1px) * 1px;
                                                    }
                                                }
                                            }
                                        }

                                        // UPDATE MODE: When existing annotation recognized
                                        if root.selected-annotation-id > 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Actions
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                // Copy Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cp-ta-edit.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/copy.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cp-ta-edit := TouchArea {
                                                        clicked => { root.copy-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: root.show-note-input ? Theme.active-bg : note-ta-edit.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/message-square.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: root.show-note-input ? Theme.accent : Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    note-ta-edit := TouchArea {
                                                        clicked => { root.show-note-input = !root.show-note-input; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Done Button (active when note input is open)
                                                if root.show-note-input: Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: note-save-ta-update.has-hover ? Theme.accent-hover : Theme.accent;
                                                    border-width: 1px;
                                                    border-color: Theme.accent-border;

                                                    Image {
                                                        source: @image-url("../assets/icons/check.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.on-accent;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    note-save-ta-update := TouchArea {
                                                        clicked => {
                                                            root.update-annotation-note(root.selected-annotation-id, root.current-note-text);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.selected-annotation-kind = "";
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: del-ta.has-hover ? #ef444425 : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/trash.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: #ef4444;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    del-ta := TouchArea {
                                                        clicked => {
                                                            root.delete-annotation(root.selected-annotation-id);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.selected-annotation-kind = "";
                                                            root.hovered-annotation-id = -1;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-yellow : Theme.annot-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 0;
                                                                root.update-annotation-color(root.selected-annotation-id, 0);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-green : Theme.annot-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 1;
                                                                root.update-annotation-color(root.selected-annotation-id, 1);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-blue : Theme.annot-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 2;
                                                                root.update-annotation-color(root.selected-annotation-id, 2);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-pink : Theme.annot-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 3;
                                                                root.update-annotation-color(root.selected-annotation-id, 3);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-orange : Theme.annot-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 4;
                                                                root.update-annotation-color(root.selected-annotation-id, 4);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-purple : Theme.annot-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 5;
                                                                root.update-annotation-color(root.selected-annotation-id, 5);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Button
                                                Rectangle {
                                                    width: 26px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cls-ta-edit.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/x.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-secondary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cls-ta-edit := TouchArea {
                                                        clicked => {
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.selected-annotation-kind = "";
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // CREATE MODE: When text selection is active
                                        if root.selected-annotation-id <= 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Action Icons + Done Button (if note active)
                                            HorizontalLayout {
                                                spacing: 3px;
                                                alignment: start;

                                                // Copy Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cp-ta.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/copy.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cp-ta := TouchArea {
                                                        clicked => { root.copy-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Highlight Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: hl-ta.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/highlighter.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    hl-ta := TouchArea {
                                                        clicked => { root.create-annotation("highlight", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Underline Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: ul-ta.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/underline.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    ul-ta := TouchArea {
                                                        clicked => { root.create-annotation("underline", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Strikethrough Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: st-ta.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/strikethrough.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    st-ta := TouchArea {
                                                        clicked => { root.create-annotation("strikethrough", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Note Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: root.show-note-input ? Theme.active-bg : note-ta.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/message-square.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: root.show-note-input ? Theme.accent : Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    note-ta := TouchArea {
                                                        clicked => {
                                                            if (!root.show-note-input) {
                                                                root.current-note-text = "";
                                                            }
                                                            root.show-note-input = !root.show-note-input;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Done Button between Note and X (active when note input is open)
                                                if root.show-note-input: Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: note-save-ta-create.has-hover ? Theme.accent-hover : Theme.accent;
                                                    border-width: 1px;
                                                    border-color: Theme.accent-border;

                                                    Image {
                                                        source: @image-url("../assets/icons/check.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.on-accent;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    note-save-ta-create := TouchArea {
                                                        clicked => {
                                                            root.create-note-annotation(root.current-note-text, root.selected-color-index);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 0; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 1; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 2; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 3; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 4; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 5; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Icon
                                                Rectangle {
                                                    width: 26px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cls-ta-new.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/x.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-secondary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cls-ta-new := TouchArea {
                                                        clicked => { root.clear-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // Bottom Row: Inline Note Input Box (Resizable, full width of popover)
                                        if root.show-note-input: HorizontalLayout {
                                            alignment: center;

                                            // Resizable Note Input Box
                                            Rectangle {
                                                width: root.note-input-width;
                                                height: root.note-input-height;
                                                border-radius: 8px;
                                                background: Theme.surface-subtle;
                                                border-width: 1px;
                                                border-color: Theme.border;

                                                if root.current-note-text == "": Text {
                                                    x: 10px;
                                                    y: 8px;
                                                    text: root.selected-annotation-id > 0 ? "Add note to annotation..." : "Write a note...";
                                                    font-family: "Inter";
                                                    font-size: 13px;
                                                    color: Theme.text-muted;
                                                }

                                                ScrollView {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width;
                                                    height: parent.height - 12px;

                                                    VerticalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 14px;
                                                        padding-top: 8px;
                                                        padding-bottom: 8px;

                                                        note-input := TextInput {
                                                            init => { self.focus(); }
                                                            text <=> root.current-note-text;
                                                            font-family: "Inter";
                                                            font-size: 13px;
                                                            color: Theme.text-primary;
                                                            wrap: word-wrap;
                                                            single-line: false;
                                                            width: 100%;
                                                        }
                                                    }
                                                }

                                                // Resize handle grip in bottom-right corner
                                                Rectangle {
                                                    x: parent.width - 16px;
                                                    y: parent.height - 16px;
                                                    width: 16px;
                                                    height: 16px;

                                                    Image {
                                                        source: @image-url("../assets/icons/maximize-2.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: Theme.text-muted;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    resize-ta := TouchArea {
                                                        mouse-cursor: nwse-resize;
                                                        moved => {
                                                            if (self.pressed) {
                                                                root.note-input-width = max(300px, min(560px, root.note-input-width + self.mouse-x - self.pressed-x));
                                                                root.note-input-height = max(50px, min(360px, root.note-input-height + self.mouse-y - self.pressed-y));
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Secondary Page Card for Dual Page Spread
                            if root.is-dual-page && root.has-secondary-page: secondary-page-card := Rectangle {
                                x: page-card.x + page-card.width + 24px;
                                y: max(32px, (view-scroll.content-height - self.height) / 2);
                                width: root.secondary-page-width;
                                height: root.secondary-page-height;
                                background: root.paper-theme == 1 ? #F4ECD8 : root.paper-theme == 2 ? #18181A : #ffffff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.paper-theme == 2 ? #2B2D24 : root.paper-theme == 1 ? #DCD4BC : Theme.border;
                                drop-shadow-blur: root.paper-theme == 2 ? 24px : Theme.dark ? 16px : 0px;
                                drop-shadow-offset-y: Theme.dark ? 4px : 0px;
                                drop-shadow-color: root.paper-theme == 2 ? #00000080 : Theme.dark ? #00000050 : #00000000;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: root.secondary-page-image;
                                    opacity: root.page-opacity;
                                    animate opacity {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }
                                }

                                // Interactive Text Selection Highlights on Secondary Page
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        if sel-r.page == root.current-page + 1: Rectangle {
                                            x: sel-r.x;
                                            y: sel-r.y;
                                            width: sel-r.width;
                                            height: sel-r.height;
                                            background: #3b82f640;
                                            border-radius: 2px;
                                        }
                                    }
                                }

                                // Embedded Document Links on Secondary Page
                                for link in root.page-links: Rectangle {
                                    if link.page == root.current-page + 1: Rectangle {
                                        x: link.x;
                                        y: link.y;
                                        width: link.width;
                                        height: link.height;
                                        background: link-sec-ta.has-hover ? #3b82f618 : transparent;
                                        border-radius: 2px;
                                        border-width: link-sec-ta.has-hover ? 1px : 0px;
                                        border-color: link-sec-ta.has-hover ? #3b82f640 : transparent;

                                        link-sec-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            clicked => {
                                                if (link.target-page >= 0) {
                                                    root.jump-to-page(link.target-page);
                                                } else if (link.uri != "") {
                                                    root.open-external-url(link.uri);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Continuous Scroll View
                    if !root.has-error && root.is-scroll-view: scroll-view := ScrollView {
                        width: 100%;
                        height: 100%;
                        content-y <=> root.scroll-content-y;
                        content-height: root.total-scroll-height;
                        content-width: max(parent.width, root.page-width + 64px);

                        scroll-bg-ta := TouchArea {
                            width: scroll-view.content-width;
                            height: max(scroll-view.content-height, parent.height);

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.move) {
                                    root.hovered-annotation-id = -1;
                                    keyboard-handler.focus();
                                } else if (event.kind == PointerEventKind.down) {
                                    keyboard-handler.focus();
                                }
                            }

                            scroll-event(event) => {
                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                    if (event.delta-y > 0) {
                                        root.zoom-in();
                                        return accept;
                                    } else if (event.delta-y < 0) {
                                        root.zoom-out();
                                        return accept;
                                    }
                                }
                                return reject;
                            }
                        }

                        for page-item in root.scroll-pages: Rectangle {
                            y: page-item.offset-y;
                            width: scroll-view.content-width;
                            height: page-item.height + 24px;

                            margin-ta := TouchArea {
                                width: 100%;
                                height: 100%;

                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.move) {
                                        root.hovered-annotation-id = -1;
                                        keyboard-handler.focus();
                                    } else if (event.kind == PointerEventKind.down) {
                                        keyboard-handler.focus();
                                    }
                                }

                                scroll-event(event) => {
                                    if (event.modifiers.control || root.is-ctrl-pressed) {
                                        if (event.delta-y > 0) {
                                            root.zoom-in();
                                            return accept;
                                        } else if (event.delta-y < 0) {
                                            root.zoom-out();
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }

                            page-card-scroll := Rectangle {
                                x: max(32px, (parent.width - self.width) / 2);
                                y: 12px;
                                width: page-item.width;
                                height: page-item.height;
                                background: root.paper-theme == 1 ? #F4ECD8 : root.paper-theme == 2 ? #18181A : #ffffff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.paper-theme == 2 ? #2B2D24 : root.paper-theme == 1 ? #DCD4BC : Theme.border;
                                drop-shadow-blur: root.paper-theme == 2 ? 24px : Theme.dark ? 16px : 0px;
                                drop-shadow-offset-y: Theme.dark ? 4px : 0px;
                                drop-shadow-color: root.paper-theme == 2 ? #00000080 : Theme.dark ? #00000050 : #00000000;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: page-item.image;
                                }

                                // Interactive Text Selection Highlights directly on actual text
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        if sel-r.page == page-item.page-index: Rectangle {
                                            x: sel-r.x;
                                            y: sel-r.y;
                                            width: sel-r.width;
                                            height: sel-r.height;
                                            background: #3b82f640;
                                            border-radius: 2px;
                                        }
                                    }
                                }



                                page-scroll-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;

                                    scroll-event(event) => {
                                        if (event.modifiers.control || root.is-ctrl-pressed) {
                                            if (event.delta-y > 0) {
                                                root.zoom-in();
                                                return accept;
                                            } else if (event.delta-y < 0) {
                                                root.zoom-out();
                                                return accept;
                                            }
                                        }
                                        return reject;
                                    }

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move) {
                                            root.hovered-annotation-id = -1;
                                            keyboard-handler.focus();
                                        } else if (event.button == PointerEventButton.left) {
                                            if (event.kind == PointerEventKind.down) {
                                                keyboard-handler.focus();
                                                root.selected-annotation-id = -1;
                                                root.selected-annotation-kind = "";
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.current-page = page-item.page-index;
                                                root.selection-started(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                            } else if (event.kind == PointerEventKind.up) {
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-completed(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                            }
                                        }
                                    }

                                    moved => {
                                        if (page-scroll-ta.pressed) {
                                            root.selection-dragged(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                        }
                                    }
                                }

                                // Embedded Document Links in Scroll View
                                for link in root.page-links: Rectangle {
                                    if link.page == page-item.page-index: Rectangle {
                                        x: link.x;
                                        y: link.y;
                                        width: link.width;
                                        height: link.height;
                                        background: link-scroll-ta.has-hover ? #3b82f618 : transparent;
                                        border-radius: 2px;
                                        border-width: link-scroll-ta.has-hover ? 1px : 0px;
                                        border-color: link-scroll-ta.has-hover ? #3b82f640 : transparent;

                                        link-scroll-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = -1;
                                                    keyboard-handler.focus();
                                                } else if (event.button == PointerEventButton.left) {
                                                    if (event.kind == PointerEventKind.down) {
                                                        keyboard-handler.focus();
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.current-page = page-item.page-index;
                                                        root.selection-started(page-item.page-index, link.x + link-scroll-ta.mouse-x, link.y + link-scroll-ta.mouse-y);
                                                    } else if (event.kind == PointerEventKind.up) {
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.selection-completed(page-item.page-index, link.x + link-scroll-ta.mouse-x, link.y + link-scroll-ta.mouse-y);
                                                    }
                                                }
                                            }

                                            moved => {
                                                if (link-scroll-ta.pressed) {
                                                    root.selection-dragged(page-item.page-index, link.x + link-scroll-ta.mouse-x, link.y + link-scroll-ta.mouse-y);
                                                }
                                            }

                                            clicked => {
                                                if (link.target-page >= 0) {
                                                    root.jump-to-page(link.target-page);
                                                } else if (link.uri != "") {
                                                    root.open-external-url(link.uri);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Render Page Annotations in Scroll View on top of page-scroll-ta
                                for annot in root.page-annotations: Rectangle {
                                    if annot.page == page-item.page-index: Rectangle {
                                        x: annot.x;
                                        y: annot.y;
                                        width: annot.w;
                                        height: annot.h;

                                        // Selection visual recognition feedback rectangle (clean, non-obscuring)
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.selected-annotation-id == annot.id ? #3b82f618 : transparent;
                                            border-width: root.selected-annotation-id == annot.id ? 1px : 0px;
                                            border-color: root.selected-annotation-id == annot.id ? #3b82f680 : transparent;
                                        }

                                        // Underline (anchored with breathing space below character baseline, scaling with zoom)
                                        if annot.kind == "underline": Rectangle {
                                            y: parent.height * 0.88;
                                            width: 100%;
                                            height: max(1.2px, root.zoom-level * 1.35px);
                                            background: annot.color;
                                        }

                                        // Strikethrough (centered directly through lowercase x-height, scaling with zoom)
                                        if annot.kind == "strikethrough": Rectangle {
                                            y: parent.height * 0.52;
                                            width: 100%;
                                            height: max(1.0px, root.zoom-level * 1.0px);
                                            background: annot.color;
                                        }

                                        // Margin Gutter Note Pin in Scroll View
                                        if annot.show-note-icon: margin-pin2 := Rectangle {
                                            x: page-item.width - annot.x - 28px;
                                            y: (parent.height - self.height) / 2;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 6px;
                                            background: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? annot.color : annot.color.darker(0.15);
                                            border-width: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? 2px : 1px;
                                            border-color: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? #ffffff : #ffffff50;
                                            drop-shadow-blur: (root.hovered-annotation-id == annot.id || pin-ta2.has-hover) ? 6px : 3px;
                                            drop-shadow-color: #00000080;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Image {
                                                source: @image-url("../assets/icons/message-square.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: #ffffff;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            pin-ta2 := TouchArea {
                                                mouse-cursor: pointer;
                                                scroll-event(event) => {
                                                    if (event.modifiers.control || root.is-ctrl-pressed) {
                                                        if (event.delta-y > 0) {
                                                            root.zoom-in();
                                                            return accept;
                                                        } else if (event.delta-y < 0) {
                                                            root.zoom-out();
                                                            return accept;
                                                        }
                                                    }
                                                    return reject;
                                                }
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.move) {
                                                        root.hovered-annotation-id = annot.id;
                                                        keyboard-handler.focus();
                                                    }
                                                }
                                                clicked => {
                                                    keyboard-handler.focus();
                                                    root.current-page = page-item.page-index;
                                                    root.popup-page = page-item.page-index;
                                                    root.selected-annotation-id = annot.id;
                                                    root.selected-annotation-kind = annot.kind;
                                                    root.selected-color-index = annot.color-index;
                                                    root.has-selection = false;
                                                    root.current-note-text = annot.comment;
                                                    root.show-note-input = true;
                                                    let p_width = max(root.note-input-width + 16px, 320px);
                                                    let p_height = root.note-input-height + 66px;
                                                    root.popup-x = round(max(8px, min(page-item.width - p_width - 8px, page-item.width - p_width - 16px)) / 1px) * 1px;
                                                    root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                    root.show-popup = true;
                                                }
                                            }
                                        }

                                        annot-ta2 := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = annot.id;
                                                    keyboard-handler.focus();
                                                }
                                            }

                                            clicked => {
                                                keyboard-handler.focus();
                                                root.current-page = page-item.page-index;
                                                root.popup-page = page-item.page-index;
                                                root.selected-annotation-id = annot.id;
                                                root.selected-annotation-kind = annot.kind;
                                                root.selected-color-index = annot.color-index;
                                                root.has-selection = false;
                                                root.current-note-text = annot.comment;
                                                root.show-note-input = annot.comment != "" || annot.kind == "note";
                                                let p_width = root.show-note-input ? max(root.note-input-width + 16px, 320px) : 256px;
                                                let p_height = root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                                root.popup-x = round(max(8px, min(page-item.width - p_width - 8px, annot.x + (annot.w - p_width) / 2)) / 1px) * 1px;
                                                root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                root.show-popup = true;
                                            }
                                        }
                                    }
                                }

                                // Floating Annotation Icon Popup in Scroll View
                                if root.show-popup && root.popup-page == page-item.page-index: popup2 := Rectangle {
                                    x: round(root.popup-x / 1px) * 1px;
                                    y: round(root.popup-y / 1px) * 1px;
                                    width: root.show-note-input ? max(root.note-input-width + 16px, 350px) : (root.selected-annotation-id > 0 ? 310px : 350px);
                                    height: root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                    border-radius: 12px;
                                    background: Theme.card-bg;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    drop-shadow-blur: 10px;
                                    drop-shadow-offset-y: 3px;
                                    drop-shadow-color: Theme.dark ? #00000088 : #00000022;
                                    animate height { duration: 120ms; }
                                    animate width { duration: 120ms; }

                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 5px;
                                        padding-bottom: 7px;
                                        spacing: 5px;

                                        // Drag Grip Handle Bar (allows dragging anywhere on the paper)
                                        Rectangle {
                                            height: 6px;
                                            width: 100%;

                                            Rectangle {
                                                width: 32px;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: drag-ta2.has-hover ? Theme.text-secondary : Theme.border-subtle;
                                                x: (parent.width - self.width) / 2;
                                                y: 1px;
                                            }

                                            drag-ta2 := TouchArea {
                                                mouse-cursor: move;
                                                pointer-event(event) => {
                                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                        root.popup-grab-x = self.mouse-x;
                                                        root.popup-grab-y = self.mouse-y;
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed) {
                                                        let max-w = max(8px, page-item.width - popup2.width - 8px);
                                                        let max-h = max(8px, page-item.height - popup2.height - 8px);
                                                        root.popup-x = round(max(8px, min(max-w, root.popup-x + self.mouse-x - root.popup-grab-x)) / 1px) * 1px;
                                                        root.popup-y = round(max(8px, min(max-h, root.popup-y + self.mouse-y - root.popup-grab-y)) / 1px) * 1px;
                                                    }
                                                }
                                            }
                                        }

                                        // UPDATE MODE: When existing annotation recognized
                                        if root.selected-annotation-id > 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Actions
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                // Copy Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cp-ta-edit2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/copy.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cp-ta-edit2 := TouchArea {
                                                        clicked => { root.copy-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: root.show-note-input ? Theme.active-bg : note-ta-edit2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/message-square.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: root.show-note-input ? Theme.accent : Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    note-ta-edit2 := TouchArea {
                                                        clicked => { root.show-note-input = !root.show-note-input; }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Done Button (active when note input is open)
                                                if root.show-note-input: Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: note-save-ta-update2.has-hover ? Theme.accent-hover : Theme.accent;
                                                    border-width: 1px;
                                                    border-color: Theme.accent-border;

                                                    Image {
                                                        source: @image-url("../assets/icons/check.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.on-accent;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    note-save-ta-update2 := TouchArea {
                                                        clicked => {
                                                            root.update-annotation-note(root.selected-annotation-id, root.current-note-text);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.selected-annotation-kind = "";
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: del-ta2.has-hover ? #ef444425 : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/trash.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: #ef4444;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    del-ta2 := TouchArea {
                                                        clicked => {
                                                            root.delete-annotation(root.selected-annotation-id);
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.selected-annotation-kind = "";
                                                            root.hovered-annotation-id = -1;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-yellow : Theme.annot-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 0;
                                                                root.update-annotation-color(root.selected-annotation-id, 0);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-green : Theme.annot-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 1;
                                                                root.update-annotation-color(root.selected-annotation-id, 1);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-blue : Theme.annot-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 2;
                                                                root.update-annotation-color(root.selected-annotation-id, 2);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-pink : Theme.annot-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 3;
                                                                root.update-annotation-color(root.selected-annotation-id, 3);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-orange : Theme.annot-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 4;
                                                                root.update-annotation-color(root.selected-annotation-id, 4);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-purple : Theme.annot-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 5;
                                                                root.update-annotation-color(root.selected-annotation-id, 5);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Button
                                                Rectangle {
                                                    width: 26px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cls-ta-edit2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/x.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-secondary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cls-ta-edit2 := TouchArea {
                                                        clicked => {
                                                            root.show-popup = false;
                                                            root.selected-annotation-id = -1;
                                                            root.selected-annotation-kind = "";
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // CREATE MODE: When text selection is active
                                        if root.selected-annotation-id <= 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Action Icons + Done Button (if note active)
                                            HorizontalLayout {
                                                spacing: 3px;
                                                alignment: start;

                                                // Copy Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cp-ta2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/copy.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cp-ta2 := TouchArea {
                                                        clicked => { root.copy-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Highlight Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: hl-ta2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/highlighter.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    hl-ta2 := TouchArea {
                                                        clicked => { root.create-annotation("highlight", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Underline Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: ul-ta2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/underline.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    ul-ta2 := TouchArea {
                                                        clicked => { root.create-annotation("underline", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Strikethrough Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: st-ta2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/strikethrough.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    st-ta2 := TouchArea {
                                                        clicked => { root.create-annotation("strikethrough", root.selected-color-index); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Note Icon
                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: root.show-note-input ? Theme.active-bg : note-ta2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/message-square.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: root.show-note-input ? Theme.accent : Theme.text-primary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    note-ta2 := TouchArea {
                                                        clicked => {
                                                            if (!root.show-note-input) {
                                                                root.current-note-text = "";
                                                            }
                                                            root.show-note-input = !root.show-note-input;
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }

                                                // Done Button between Note and X (active when note input is open)
                                                if root.show-note-input: Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: note-save-ta-create2.has-hover ? Theme.accent-hover : Theme.accent;
                                                    border-width: 1px;
                                                    border-color: Theme.accent-border;

                                                    Image {
                                                        source: @image-url("../assets/icons/check.svg");
                                                        width: 18px;
                                                        height: 18px;
                                                        colorize: Theme.on-accent;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    note-save-ta-create2 := TouchArea {
                                                        clicked => {
                                                            root.create-note-annotation(root.current-note-text, root.selected-color-index);
                                                        }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 0; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 1; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 2; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 3; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 4; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 5; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Icon
                                                Rectangle {
                                                    width: 26px;
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: cls-ta-new2.has-hover ? Theme.hover-bg : transparent;
                                                    Image {
                                                        source: @image-url("../assets/icons/x.svg");
                                                        width: 17px;
                                                        height: 17px;
                                                        colorize: Theme.text-secondary;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    cls-ta-new2 := TouchArea {
                                                        clicked => { root.clear-selection(); }
                                                        mouse-cursor: pointer;
                                                    }
                                                }
                                            }
                                        }

                                        // Bottom Row: Inline Note Input Box (Resizable, full width of popover)
                                        if root.show-note-input: HorizontalLayout {
                                            alignment: center;

                                            // Resizable Note Input Box
                                            Rectangle {
                                                width: root.note-input-width;
                                                height: root.note-input-height;
                                                border-radius: 8px;
                                                background: Theme.surface-subtle;
                                                border-width: 1px;
                                                border-color: Theme.border;

                                                if root.current-note-text == "": Text {
                                                    x: 10px;
                                                    y: 8px;
                                                    text: root.selected-annotation-id > 0 ? "Add note to annotation..." : "Write a note...";
                                                    font-family: "Inter";
                                                    font-size: 13px;
                                                    color: Theme.text-muted;
                                                }

                                                ScrollView {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width;
                                                    height: parent.height - 12px;

                                                    VerticalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 14px;
                                                        padding-top: 8px;
                                                        padding-bottom: 8px;

                                                        note-input2 := TextInput {
                                                            init => { self.focus(); }
                                                            text <=> root.current-note-text;
                                                            font-family: "Inter";
                                                            font-size: 13px;
                                                            color: Theme.text-primary;
                                                            wrap: word-wrap;
                                                            single-line: false;
                                                            width: 100%;
                                                        }
                                                    }
                                                }

                                                // Resize handle grip in bottom-right corner
                                                Rectangle {
                                                    x: parent.width - 16px;
                                                    y: parent.height - 16px;
                                                    width: 16px;
                                                    height: 16px;

                                                    Image {
                                                        source: @image-url("../assets/icons/maximize-2.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: Theme.text-muted;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    resize-ta2 := TouchArea {
                                                        mouse-cursor: nwse-resize;
                                                        moved => {
                                                            if (self.pressed) {
                                                                root.note-input-width = max(300px, min(560px, root.note-input-width + self.mouse-x - self.pressed-x));
                                                                root.note-input-height = max(50px, min(360px, root.note-input-height + self.mouse-y - self.pressed-y));
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Flattened Search Match Highlights across entire continuous document
                        if root.show-search: Rectangle {
                            width: 100%;
                            height: root.total-scroll-height;

                            for hl in root.scroll-search-highlights: Rectangle {
                                x: max(32px, (parent.width - hl.page-width) / 2) + hl.x;
                                y: hl.y;
                                width: hl.width;
                                height: hl.height;
                                background: hl.is-current ? #f59e0b35 : #fde04730;
                                border-radius: 2px;
                                border-width: hl.is-current ? 1.5px : 0px;
                                border-color: hl.is-current ? #ea580c : transparent;
                            }
                        }
                    }
                }
            }
        }
    }

    // Top Hover Sensor to reveal Zen Controls in Zen Mode
    top-sensor := TouchArea {
        x: (parent.width - 480px) / 2;
        y: 0;
        width: 480px;
        height: root.is-zen-mode ? 60px : 0px;
        enabled: root.is-zen-mode;
    }

    // Floating Zen Mode Controls Bar
    if root.is-zen-mode: Rectangle {
        x: (parent.width - self.width) / 2;
        y: top-sensor.has-hover ? 16px : -54px;
        height: 44px;
        border-radius: 22px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.dark ? #00000080 : #00000018;
        animate y { duration: 160ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            alignment: center;

            IconButton {
                icon: @image-url("../assets/icons/arrow-left.svg");
                enabled: root.can-nav-back;
                y: (parent.height - self.height) / 2;
                clicked => { root.nav-back(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/arrow-right.svg");
                enabled: root.can-nav-forward;
                y: (parent.height - self.height) / 2;
                clicked => { root.nav-forward(); }
            }

            Rectangle {
                width: 1px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                background: Theme.border;
            }

            IconButton {
                icon: @image-url("../assets/icons/chevron-left.svg");
                enabled: root.can-prev;
                y: (parent.height - self.height) / 2;
                clicked => { root.prev-page(); }
            }

            Text {
                text: root.page-display;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            IconButton {
                icon: @image-url("../assets/icons/chevron-right.svg");
                enabled: root.can-next;
                y: (parent.height - self.height) / 2;
                clicked => { root.next-page(); }
            }

            Rectangle {
                width: 1px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                background: Theme.border;
            }

            IconButton {
                icon: @image-url("../assets/icons/zoom-out.svg");
                y: (parent.height - self.height) / 2;
                clicked => { root.is-fit-width = false; root.zoom-out(); }
            }

            Text {
                text: root.zoom-display;
                font-family: "Inter";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            IconButton {
                icon: @image-url("../assets/icons/zoom-in.svg");
                y: (parent.height - self.height) / 2;
                clicked => { root.is-fit-width = false; root.zoom-in(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/fit-to-page.svg");
                y: (parent.height - self.height) / 2;
                clicked => { root.is-fit-width = false; root.zoom-fit(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/fit-to-width.svg");
                active: root.is-fit-width;
                y: (parent.height - self.height) / 2;
                clicked => { root.is-fit-width = true; root.zoom-fit-width(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/rotate-cw.svg");
                y: (parent.height - self.height) / 2;
                clicked => { root.rotate-clockwise(); }
            }

            Rectangle {
                width: 1px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                background: Theme.border;
            }

            // Exit Zen Button
            Rectangle {
                height: 28px;
                border-radius: 14px;
                y: (parent.height - self.height) / 2;
                background: exit-zen-ta.has-hover ? Theme.hover-bg : transparent;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 5px;
                    alignment: center;

                    Image {
                        source: @image-url("../assets/icons/minimize-2.svg");
                        width: 15px;
                        height: 15px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Exit Zen (F11)";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                exit-zen-ta := TouchArea {
                    clicked => { root.exit-zen-mode(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // Floating Notification Toast
    if root.show-toast: Rectangle {
        width: toast-hl.preferred-width;
        height: 38px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 56px;
        z: 200;
        border-radius: 19px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.accent-border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.dark ? #00000070 : #00000018;

        toast-hl := HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 8px;
            alignment: center;

            Image {
                source: @image-url("../assets/icons/check.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.accent;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.toast-message;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
    }

    // Dismiss overlay for Tab Context Menu
    if root.show-tab-menu: TouchArea {
        width: 100%;
        height: 100%;
        z: 94;
        clicked => {
            root.show-tab-menu = false;
        }
    }

    // Tab Context Menu Popover
    if root.show-tab-menu: Rectangle {
        x: root.tab-menu-x;
        y: root.tab-menu-y;
        width: 200px;
        height: tab-cm-vl.preferred-height;
        z: 105;
        background: Theme.card-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000099 : #00000020;
        clip: true;

        tab-cm-vl := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            // Close Tab
            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: cm-close-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Close Tab";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                cm-close-ta := TouchArea {
                    clicked => {
                        root.show-tab-menu = false;
                        root.close-tab(root.tab-menu-index);
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Close Other Tabs
            cm-other-row := Rectangle {
                property <bool> is-row-enabled: root.open-tabs.length > 1;
                height: 32px;
                border-radius: 6px;
                background: self.is-row-enabled && cm-other-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 13px;
                        height: 13px;
                        colorize: cm-other-row.is-row-enabled ? Theme.text-secondary : Theme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Close Other Tabs";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 500;
                        color: cm-other-row.is-row-enabled ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                cm-other-ta := TouchArea {
                    clicked => {
                        if (cm-other-row.is-row-enabled) {
                            root.show-tab-menu = false;
                            root.close-other-tabs(root.tab-menu-index);
                        }
                    }
                    mouse-cursor: cm-other-row.is-row-enabled ? pointer : default;
                }
            }

            // Close Tabs to the Right
            cm-right-row := Rectangle {
                property <bool> is-row-enabled: root.tab-menu-index < root.open-tabs.length - 1;
                height: 32px;
                border-radius: 6px;
                background: self.is-row-enabled && cm-right-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/chevron-right.svg");
                        width: 13px;
                        height: 13px;
                        colorize: cm-right-row.is-row-enabled ? Theme.text-secondary : Theme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Close Tabs to the Right";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 500;
                        color: cm-right-row.is-row-enabled ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                cm-right-ta := TouchArea {
                    clicked => {
                        if (cm-right-row.is-row-enabled) {
                            root.show-tab-menu = false;
                            root.close-tabs-to-the-right(root.tab-menu-index);
                        }
                    }
                    mouse-cursor: cm-right-row.is-row-enabled ? pointer : default;
                }
            }
        }
    }

    // Dismiss overlay for Recent Books menu
    if root.show-recent-books: TouchArea {
        width: 100%;
        height: 100%;
        z: 90;
        clicked => {
            root.show-recent-books = false;
        }
    }

    // Recent Books Dropdown Popover
    if root.show-recent-books: Rectangle {
        x: 16px;
        y: 46px;
        width: 320px;
        height: recent-vl.preferred-height;
        z: 100;
        background: Theme.card-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000080 : #00000015;

        recent-vl := VerticalLayout {
            padding: 8px;
            spacing: 4px;
            alignment: start;

            // Header
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: space-between;

                Text {
                    text: "RECENT BOOKS";
                    font-family: "Inter";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            if root.recent-books.length == 0: Rectangle {
                height: 44px;
                Text {
                    text: "No recent books yet";
                    font-family: "Inter";
                    font-size: 13px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for item in root.recent-books: Rectangle {
                height: 38px;
                border-radius: 8px;
                background: item-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/icons/book-open.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: item.filename;
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 210px;
                        }
                    }

                    Text {
                        text: "p. \{item.page}";
                        font-family: "Inter";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                item-ta := TouchArea {
                    clicked => {
                        root.show-recent-books = false;
                        root.open-recent-book(item.path);
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Bottom actions: Document Properties & Open PDF
            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: doc-props-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/icons/info.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-primary;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Document Properties";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Ctrl+D";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                doc-props-ta := TouchArea {
                    clicked => {
                        root.show-recent-books = false;
                        root.show-doc-info = true;
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: open-other-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/folder-open.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Open other file...";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                open-other-ta := TouchArea {
                    clicked => {
                        root.show-recent-books = false;
                        root.open-document();
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // Backdrop click-to-dismiss for Doc Info Modal
    if root.show-doc-info: TouchArea {
        width: 100%;
        height: 100%;
        z: 190;
        clicked => {
            root.show-doc-info = false;
        }
    }

    // Modal Dim Backdrop
    if root.show-doc-info: Rectangle {
        width: 100%;
        height: 100%;
        z: 195;
        background: Theme.dark ? #000000a6 : #00000045;
        animate background { duration: 140ms; }
    }

    // Document Properties Modal Card
    if root.show-doc-info: Rectangle {
        width: root.width > 600px ? 560px : root.width - 32px;
        height: doc-info-vl.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        z: 200;
        background: Theme.card-bg;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.dark ? #000000cc : #00000035;
        clip: true;

        doc-info-vl := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            alignment: start;

            // Modal Header
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        y: (parent.height - self.height) / 2;

                        Image {
                            source: @image-url("../assets/icons/file-text.svg");
                            width: 20px;
                            height: 20px;
                            colorize: Theme.text-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Document Properties";
                            font-family: "Inter";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: root.doc-info.file-name != "" ? root.doc-info.file-name : "No file loaded";
                            font-family: "Inter";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            overflow: elide;
                            max-width: 380px;
                        }
                    }
                }

                IconButton {
                    icon: @image-url("../assets/icons/x.svg");
                    size: 30px;
                    icon-size: 16px;
                    border-radius: 15px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.show-doc-info = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Section 1: File Specs
            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "FILE SPECIFICATIONS";
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    letter-spacing: 0.5px;
                }

                DocPropRow {
                    label: "Location";
                    value: root.doc-info.file-path;
                    is-path: true;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "File Size";
                    value: root.doc-info.file-size;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Modified";
                    value: root.doc-info.mod-date;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Section 2: Metadata
            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "METADATA";
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    letter-spacing: 0.5px;
                }

                DocPropRow {
                    label: "Title";
                    value: root.doc-info.title;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Author";
                    value: root.doc-info.author;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Subject";
                    value: root.doc-info.subject;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Keywords";
                    value: root.doc-info.keywords;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Section 3: PDF Details
            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "PDF SPECIFICATIONS";
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    letter-spacing: 0.5px;
                }

                DocPropRow {
                    label: "Page Count";
                    value: root.doc-info.page-count;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Page Dimensions";
                    value: root.doc-info.page-size;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Format / Version";
                    value: root.doc-info.pdf-version;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Security";
                    value: root.doc-info.encryption;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Created";
                    value: root.doc-info.creation-date;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Producer";
                    value: root.doc-info.producer;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Creator";
                    value: root.doc-info.creator;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Modal Footer: Actions
            HorizontalLayout {
                padding-top: 4px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    // Copy Path Button
                    Rectangle {
                        height: 32px;
                        border-radius: 16px;
                        background: copy-path-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 80ms; }
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/copy.svg");
                                width: 15px;
                                height: 15px;
                                colorize: Theme.text-primary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Copy Path";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        copy-path-ta := TouchArea {
                            clicked => {
                                root.copy-to-clipboard(root.doc-info.file-path);
                            }
                            mouse-cursor: pointer;
                        }
                    }

                    // Copy All Markdown Button
                    Rectangle {
                        height: 32px;
                        border-radius: 16px;
                        background: copy-all-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 80ms; }
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/copy.svg");
                                width: 15px;
                                height: 15px;
                                colorize: Theme.text-primary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Copy All";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        copy-all-ta := TouchArea {
                            clicked => {
                                root.copy-all-doc-info();
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }

                // Done Close Button
                Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: done-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    animate background { duration: 80ms; }
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;

                        Text {
                            text: "Done";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.on-accent;
                            vertical-alignment: center;
                        }
                    }

                    done-ta := TouchArea {
                        clicked => {
                            root.show-doc-info = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}
