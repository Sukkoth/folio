import { Button, ListView, ScrollView } from "std-widgets.slint";
import "../assets/fonts/Inter-Variable.ttf";

global Theme {
    in-out property <bool> dark: true;

    // Palette derived directly from Orgelux UI Design reference:
    // Dark: Warm Charcoal Slate (#212124 / #1A1A1D), elevated cards (#2C2D31 / #35363B),
    //       signature warm Sunglow Gold accent (#F4CD45), crisp white typography (#FFFFFF),
    //       and refined micro-surfaces (#3A3B41).
    // Light: Clean architectural warm slate (#F3F3F5), pure white cards (#FFFFFF),
    //        deep charcoal CTA pill (#18181C), rich amber-gold accent (#C99400 / #F4CD45),
    //        and warm neutral borders (#DCDEE4).

    // Base Surfaces
    out property <color> app-bg: root.dark ? #212124 : #F3F3F5;
    out property <color> canvas-bg: root.dark ? #1A1A1D : #E8E8EC;
    out property <color> sidebar-bg: root.dark ? #212124 : #FFFFFF;
    out property <color> card-bg: root.dark ? #2C2D31 : #FFFFFF;
    out property <color> card-elevated: root.dark ? #35363B : #FFFFFF;
    out property <color> card-subtle: root.dark ? #26272B : #F7F7FA;
    out property <color> surface-subtle: root.dark ? #3A3B41 : #EFEFF3;
    out property <color> pill-track: root.dark ? #2C2D32 : #E5E6EA;

    // Borders & Hairline Dividers
    out property <color> border: root.dark ? #3A3B41 : #DCDEE4;
    out property <color> border-subtle: root.dark ? #2D2E33 : #E9EAEF;
    out property <color> border-strong: root.dark ? #4A4B53 : #C6C8D0;

    // Typography
    out property <color> text-primary: root.dark ? #FFFFFF : #18181C;
    out property <color> text-secondary: root.dark ? #A0A1A8 : #5A5C64;
    out property <color> text-muted: root.dark ? #707178 : #8B8D96;
    out property <color> text-accent: root.dark ? #F4CD45 : #C99400;
    out property <color> text-disabled: root.dark ? #4D4E55 : #CBD0D8;

    // Signature Brand Accent: Orgelux Sunglow Gold
    out property <color> accent: root.dark ? #F4CD45 : #F4CD45;
    out property <color> accent-hover: root.dark ? #FFD95A : #E5BF35;
    out property <color> accent-border: root.dark ? #F4CD45 : #D49D00;
    out property <color> accent-subtle: root.dark ? #F4CD45.transparentize(85%) : #F4CD45.transparentize(86%);
    out property <color> on-accent: #181710;

    // High-Contrast CTA Pill
    out property <color> cta-bg: root.dark ? #F4CD45 : #18181C;
    out property <color> cta-hover: root.dark ? #FFD95A : #2E2F35;
    out property <color> on-cta: root.dark ? #181710 : #FFFFFF;

    // Warm Gold/Amber for Badges & Highlights
    out property <color> accent-gold: root.dark ? #F4CD45 : #D49D00;
    out property <color> accent-pale: root.dark ? #F4CD45.transparentize(86%) : #FEF3C7;
    out property <color> success: root.dark ? #34D399 : #059669;

    // Interactive states
    out property <color> hover-bg: root.dark ? #35363B : #EBECEF;
    out property <color> active-bg: root.dark ? #3E3F45 : #E0E1E6;

    // Navigation Rail states (Gold active pill in dark, dark pill in light)
    out property <color> rail-active-bg: root.dark ? #F4CD45 : #18181C;
    out property <color> rail-active-border: root.dark ? #F4CD45 : #18181C;
    out property <color> rail-active-icon: root.dark ? #181710 : #F4CD45;

    // Tooltip
    out property <color> tooltip-bg: root.dark ? #26272B : #FFFFFF;
    out property <color> tooltip-border: root.dark ? #3E3F45 : #D4D6DC;

    // Annotation Highlight Colors (Soft pastel blend matching PDF text highlighting)
    out property <color> hl-yellow: #fef08a;
    out property <color> hl-green: #bbf7d0;
    out property <color> hl-blue: #bfdbfe;
    out property <color> hl-pink: #fbcfe8;
    out property <color> hl-orange: #fed7aa;
    out property <color> hl-purple: #e9d5ff;

    // Annotation Vibrant Colors (Underline, Note, Strikethrough)
    out property <color> annot-yellow: #facc15;
    out property <color> annot-green: #4ade80;
    out property <color> annot-blue: #60a5fa;
    out property <color> annot-pink: #f472b6;
    out property <color> annot-orange: #fb923c;
    out property <color> annot-purple: #c084fc;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> accent-active: false;
    in property <length> size: 32px;
    in property <length> icon-size: 16px;
    in property <string> tooltip: "";
    in property <string> tooltip-position: "bottom"; // "bottom", "top", "left", "right"
    in property <string> tooltip-align: "center"; // "center", "left", "right"
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: 10px;
    background: !root.enabled ? transparent : (root.accent-active && root.active) ? Theme.accent : root.active ? Theme.active-bg : ta.pressed ? Theme.active-bg : ta.has-hover ? Theme.hover-bg : transparent;
    border-width: ((root.accent-active && root.active) || (ta.has-hover && root.enabled)) ? 1px : 0px;
    border-color: (root.accent-active && root.active) ? Theme.accent-border : Theme.border;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    if root.has-icon: Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        image-fit: contain;
        colorize: !root.enabled ? Theme.text-disabled : (root.accent-active && root.active) ? Theme.on-accent : root.active ? Theme.text-primary : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        animate colorize { duration: 120ms; }
    }

    if !root.has-icon: Text {
        text: root.text;
        font-family: "Inter";
        font-size: 16px;
        font-weight: 700;
        color: !root.enabled ? Theme.text-disabled : (root.accent-active && root.active) ? Theme.on-accent : root.active ? Theme.text-primary : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    if root.tooltip != "" && ta.has-hover && root.enabled: Rectangle {
        x: root.tooltip-position == "left" ? (-self.width - 6px) :
           root.tooltip-position == "right" ? (root.width + 6px) :
           root.tooltip-align == "left" ? 0px :
           root.tooltip-align == "right" ? (root.width - self.width) :
           (root.width - self.width) / 2;
        y: root.tooltip-position == "top" ? (-self.height - 6px) :
           root.tooltip-position == "left" || root.tooltip-position == "right" ? (root.height - self.height) / 2 :
           (root.height + 6px);
        width: tip-text.preferred-width + 16px;
        height: 24px;
        background: Theme.tooltip-bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.tooltip-border;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
        z: 1000;

        tip-text := Text {
            text: root.tooltip;
            font-family: "Inter";
            font-size: 11px;
            font-weight: 500;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component NavRailButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    callback clicked();

    width: 40px;
    height: 40px;
    background: transparent;

    // Mathematically perfect vector circle background rendered via resvg with full 360-degree anti-aliasing
    if root.active: Image {
        width: 40px;
        height: 40px;
        source: @image-url("../assets/icons/circle-fill.svg");
        colorize: Theme.rail-active-bg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if !root.active && (ta.has-hover || ta.pressed) && root.enabled: Image {
        width: 40px;
        height: 40px;
        source: @image-url("../assets/icons/circle-fill.svg");
        colorize: ta.pressed ? Theme.active-bg : Theme.hover-bg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Image {
        width: 20px;
        height: 20px;
        image-fit: contain;
        source: root.icon;
        colorize: !root.enabled ? Theme.text-muted : root.active ? Theme.rail-active-icon : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate colorize { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    if root.tooltip != "" && ta.has-hover && root.enabled: Rectangle {
        x: root.width + 8px;
        y: (root.height - self.height) / 2;
        width: rail-tip-text.preferred-width + 16px;
        height: 24px;
        background: Theme.tooltip-bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.tooltip-border;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
        z: 1000;

        rail-tip-text := Text {
            text: root.tooltip;
            font-family: "Inter";
            font-size: 11px;
            font-weight: 500;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component SignaturePillButton inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> has-chevron: false;
    in property <string> text: "Open PDF";
    in property <string> tooltip: "";
    callback clicked();

    height: 38px;
    border-radius: 19px;
    background: ta.pressed ? Theme.cta-bg.darker(0.06) : ta.has-hover ? Theme.cta-hover : Theme.cta-bg;
    border-width: 1px;
    border-color: Theme.border-subtle;
    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: root.has-chevron ? 12px : 16px;
        spacing: 7px;
        alignment: center;

        if root.has-icon: Image {
            source: root.icon;
            width: 17px;
            height: 17px;
            image-fit: contain;
            colorize: Theme.on-cta;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            font-family: "Inter";
            font-size: 14px;
            font-weight: 600;
            color: Theme.on-cta;
            vertical-alignment: center;
        }

        if root.has-chevron: Image {
            source: @image-url("../assets/icons/chevron-down.svg");
            width: 14px;
            height: 14px;
            colorize: Theme.on-cta;
            y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    if root.tooltip != "" && ta.has-hover: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height + 6px;
        width: sig-tip-text.preferred-width + 16px;
        height: 24px;
        background: Theme.tooltip-bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.tooltip-border;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
        z: 1000;

        sig-tip-text := Text {
            text: root.tooltip;
            font-family: "Inter";
            font-size: 11px;
            font-weight: 500;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component ViewModeSegment inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active: false;
    in property <string> tooltip: "";
    callback clicked();

    height: 32px;
    border-radius: 16px;
    background: root.active ? Theme.card-elevated : ta.has-hover ? Theme.hover-bg : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border;
    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;

        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            image-fit: contain;
            colorize: root.active ? Theme.text-primary : Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            font-family: "Inter";
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    if root.tooltip != "" && ta.has-hover: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height + 6px;
        width: vm-tip-text.preferred-width + 16px;
        height: 24px;
        background: Theme.tooltip-bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.tooltip-border;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
        z: 1000;

        vm-tip-text := Text {
            text: root.tooltip;
            font-family: "Inter";
            font-size: 11px;
            font-weight: 500;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component TabItem inherits Rectangle {
    in property <string> title: "";
    in property <bool> is-active: false;
    in property <bool> is-dirty: false;
    callback clicked();
    callback close-clicked();
    callback context-menu(length, length);

    min-width: 120px;
    max-width: 230px;
    height: 38px;
    border-radius: 9px;
    background: root.is-active ? Theme.card-elevated : tab-ta.has-hover ? Theme.hover-bg : transparent;
    border-width: root.is-active ? 1px : 0px;
    border-color: Theme.border;
    clip: false;

    // Small active indicator dot or bar
    if root.is-active: Rectangle {
        x: 4px;
        y: (parent.height - 18px) / 2;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    tab-ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: root.is-active ? 12px : 10px;
        padding-right: 6px;
        spacing: 6px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Image {
                source: @image-url("../assets/icons/file-text.svg");
                width: 14px;
                height: 14px;
                image-fit: contain;
                colorize: root.is-active ? Theme.accent : Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.title;
                font-family: "Inter";
                font-size: 13px;
                font-weight: root.is-active ? 600 : 500;
                color: root.is-active ? Theme.text-primary : Theme.text-secondary;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: end;

            if root.is-dirty: Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.accent-gold;
                y: (parent.height - self.height) / 2;
            }

            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                background: close-ta.pressed ? Theme.active-bg : close-ta.has-hover ? Theme.hover-bg : transparent;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../assets/icons/x.svg");
                    width: 12px;
                    height: 12px;
                    colorize: close-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                close-ta := TouchArea {
                    clicked => { root.close-clicked(); }
                    mouse-cursor: pointer;
                }

                if close-ta.has-hover: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height + 6px;
                    width: tabclose-tip.preferred-width + 16px;
                    height: 24px;
                    background: Theme.tooltip-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.tooltip-border;
                    drop-shadow-blur: 10px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
                    z: 1000;

                    tabclose-tip := Text {
                        text: "Close tab (Ctrl+W)";
                        font-family: "Inter";
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export struct TabItemData {
    id: int,
    title: string,
    path: string,
    is-active: bool,
    is-dirty: bool,
}

export struct PageItemData {
    page-index: int,
    offset-y: length,
    width: length,
    height: length,
    image: image,
}

