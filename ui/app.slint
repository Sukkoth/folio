    file-path: string,
    file-size: string,
    page-count: string,
    page-size: string,
    title: string,
    author: string,
    subject: string,
    keywords: string,
    creator: string,
    producer: string,
    creation-date: string,
    mod-date: string,
    pdf-version: string,
    encryption: string,
}

component DocPropRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> is-path: false;
    in property <bool> can-copy: false;
    callback copy-value(string);

    height: 28px;
    border-radius: 6px;
    background: (root.can-copy && row-ta.has-hover) ? Theme.hover-bg : transparent;
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        alignment: space-between;

        Text {
            width: 120px;
            text: root.label;
            font-family: "Inter";
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            horizontal-stretch: 1;

            Text {
                text: root.value;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 500;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-alignment: right;
            }

            if root.can-copy && row-ta.has-hover && root.value != "—" && root.value != "": Image {
                source: @image-url("../assets/icons/copy.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    row-ta := TouchArea {
        enabled: root.can-copy;
        mouse-cursor: (root.can-copy && root.value != "—" && root.value != "") ? pointer : default;
        clicked => {
            if (root.can-copy && root.value != "—" && root.value != "") {
                root.copy-value(root.value);
            }
        }
    }
}

component KeyBadge inherits Rectangle {
    in property <string> text;

    height: 22px;
    width: Math.max(24px, round((key-label.preferred-width + 14px) / 2px) * 2px);
    border-radius: 5px;
    background: Theme.surface-subtle;
    border-width: 1px;
    border-color: Theme.border-strong;

    key-label := Text {
        text: root.text;
        font-family: "Inter";
        font-size: 11px;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ShortcutItem inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <string> shortcut-alt: "";

    height: 28px;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        alignment: space-between;

        Text {
            text: root.label;
            font-family: "Inter";
            font-size: 13px;
            font-weight: 500;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: end;

            KeyBadge {
                text: root.shortcut;
                y: (parent.height - self.height) / 2;
            }

            if root.shortcut-alt != "": Text {
                text: "/";
                font-family: "Inter";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            if root.shortcut-alt != "": KeyBadge {
                text: root.shortcut-alt;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

component ShortcutSectionHeader inherits Rectangle {
    in property <string> title;

    height: 26px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        alignment: start;

        Text {
            text: root.title;
            font-family: "Inter";
            font-size: 11px;
            font-weight: 700;
            color: Theme.text-accent;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    default-font-family: "Inter";
    icon: @image-url("../assets/icons/png/folio-512.png");
    in-out property <bool> dark-mode <=> Theme.dark;
    callback toggle-theme();
    callback open-document();
    title: file-title != "" ? "\{file-title} - Folio" : "Folio";
    min-width: 720px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 860px;
    background: Theme.app-bg;

    in property <image> page-image;
    in property <length> page-width: 595px;
    in property <length> page-height: 842px;
    in property <float> page-opacity: 1.0;

    // Dual-Page Spread properties
    in-out property <bool> is-dual-page: false;
    in property <image> secondary-page-image;
    in property <length> secondary-page-width: 595px;
    in property <length> secondary-page-height: 842px;
    in property <bool> has-secondary-page: false;
    in-out property <int> secondary-page: -1;
    in-out property <bool> dual-page-cover-alone: true;
    callback toggle-cover-alone(bool);

    // Page Rotation (0, 90, 180, 270)
    in-out property <int> rotation: 0;

    // Paper Theme (0 = Light, 1 = Sepia, 2 = Scientific Dark)
    in-out property <int> paper-theme: 0;

    callback rotate-clockwise();
    callback set-dual-page(bool);
    callback cycle-paper-theme();
    callback set-paper-theme(int);

    in property <string> file-title: "";
    in property <string> file-path: "";

    // Multi-Tab properties & callbacks
    in property <[TabItemData]> open-tabs: [];
    in-out property <int> active-tab-index: 0;
    callback select-tab(int);
    callback close-tab(int);
    callback close-other-tabs(int);
    callback close-tabs-to-the-right(int);
    callback new-tab();
    callback next-tab();
    callback prev-tab();
    in-out property <bool> show-tab-menu: false;
    in-out property <int> tab-menu-index: -1;
    in-out property <length> tab-menu-x: 0px;
    in-out property <length> tab-menu-y: 38px;
    in property <[RecentBookItem]> recent-books: [];
    in-out property <bool> show-recent-books: false;
    callback open-recent-book(string);
    in-out property <bool> show-doc-info: false;
    in-out property <bool> show-shortcuts-modal: false;
    in property <DocInfoData> doc-info;
    callback copy-to-clipboard(string);
    callback copy-all-doc-info();
    in property <string> page-display: "1 / 1";
    in-out property <string> current-page-input: "1";
    in property <string> page-suffix-display: "/ 1";
    in-out property <bool> focus-page-input-flag: false;
    in property <string> zoom-display: "200%";
    in property <float> zoom-level: 2.0;
    in-out property <bool> is-ctrl-pressed: false;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    callback nav-back();
    callback nav-forward();
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    // Password Unlock Modal
    in-out property <bool> show-password-modal: false;
    in-out property <string> password-file-name: "";
    in-out property <string> password-input: "";
    in-out property <string> password-error: "";
    callback submit-password(string);
    callback cancel-password();

    // Print Modal
    in-out property <bool> show-print-modal: false;
    in-out property <[string]> available-printers: [];
    in-out property <string> selected-printer: "";
    in-out property <int> print-page-mode: 0; // 0: all, 1: current, 2: custom
    in-out property <string> print-page-range: "";
    in-out property <int> print-copies: 1;
    in-out property <string> print-error: "";
    callback open-print-dialog();
    callback cycle-printer();
    callback request-print(string, int, string, int); // (printer, mode, range, copies)
    callback cancel-print();

    // Unsaved Changes Confirmation Modal
    in-out property <bool> show-unsaved-modal: false;
    in-out property <string> unsaved-file-name: "";
    in-out property <int> unsaved-tab-index: -1;
    in-out property <bool> unsaved-is-quitting: false;
    in-out property <int> unsaved-remaining-count: 0;
    callback confirm-save-and-close(int, bool);
    callback confirm-discard-and-close(int, bool);
    callback cancel-unsaved-close();

    in-out property <bool> is-scroll-view: true;
    in-out property <length> scroll-content-y: 0px;
    in property <length> scroll-item-height: 842px + 24px;
    in property <length> total-scroll-height: 0px;
    in-out property <length> scroll-viewport-height: doc-viewport.height;
    in-out property <length> scroll-viewport-width: doc-viewport.width;
    in property <int> total-pages: 1;
    in-out property <int> current-page: 0;
    in property <[PageItemData]> scroll-pages;

    in-out property <bool> show-sidebar: false;
    in-out property <length> sidebar-width: 350px;
    in-out property <bool> is-sidebar-resizing: false;
    callback save-sidebar-width(length);
    in-out property <int> sidebar-tab: 0; // 0=Contents, 1=Highlights, 2=Notes
    in-out property <bool> show-sort-menu: false;
    in-out property <int> annotation-sort-mode: 0; // 0=Document Order, 1=Newest First, 2=Oldest First
    callback set-annotation-sort-mode(int);
    in property <[TocItemData]> toc-items;
    in property <[AnnotationItemData]> highlight-items;
    in property <[AnnotationItemData]> note-items;
    in property <[AnnotationVisual]> page-annotations;
    in property <[PdfLinkData]> page-links: [];

    // Text selection & floating popup state
    in property <[SelectionRect]> selection-rects;
    in-out property <bool> has-selection: false;
    in-out property <bool> show-popup: false;
    in-out property <int> popup-page: 0;
    in-out property <length> popup-x: 0px;
    in-out property <length> popup-y: 0px;
    in-out property <length> popup-grab-x: 0px;
    in-out property <length> popup-grab-y: 0px;
    in-out property <int> selected-color-index: 0; // 0=Yellow, 1=Green, 2=Blue, 3=Pink, 4=Orange, 5=Purple
    in-out property <int> selected-annotation-id: -1;
    in-out property <string> selected-annotation-kind: "";
    in-out property <int> hovered-annotation-id: -1;
    in-out property <bool> show-note-input: false;
    in-out property <string> current-note-text: "";
    in-out property <length> note-input-width: 308px;
    in-out property <length> note-input-height: 72px;

    in-out property <bool> is-dirty: false;
    in-out property <bool> is-saving: false;
    in-out property <bool> show-saved-badge: false;

    in-out property <bool> suppress-page-change: false;
    in property <bool> has-error: false;
    in property <string> error-message: "";

    // Search state
    in-out property <bool> show-search: false;
    in-out property <string> search-query: "";
    in-out property <bool> search-match-case: false;
    in-out property <bool> search-match-whole-word: false;
    in property <bool> is-searching: false;
    in property <int> active-search-index: -1;
    in property <int> total-search-matches: 0;
    in property <string> search-match-display: "";
    in property <[SearchResultItem]> search-results;
    in property <[SearchHighlight]> page-search-highlights;
    in property <[SearchHighlight]> scroll-search-highlights;

    // Toast notification state
    in-out property <string> toast-message: "";
    in-out property <bool> show-toast: false;

    // Zen / Fullscreen Mode state
    in-out property <bool> is-zen-mode: false;
    in-out property <bool> sidebar-was-open: false;

    // Zen callbacks
    callback toggle-zen-mode();
    callback exit-zen-mode();

    // Export callbacks
    callback copy-annotations-markdown();
    callback export-annotations-markdown();

    callback save-document();
    callback save-document-as();
    callback prev-page();
    callback next-page();
    callback zoom-in();
    callback zoom-out();
    callback zoom-in-at(int);
    callback zoom-out-at(int);
    callback zoom-reset();
    callback zoom-fit();
    callback zoom-fit-width();
    in-out property <bool> is-fit-width: false;
    callback set-view-mode(bool);
    callback visible-page-changed(int);
    callback toggle-sidebar();
    callback jump-to-page(int);
    callback toggle-toc-collapse(int);
    callback open-external-url(string);
    callback go-to-page(string);
    callback reset-page-input();

    // Search callbacks
    callback toggle-search();
    callback close-search();
    callback toggle-search-match-case();
    callback toggle-search-match-whole-word();
    callback search-query-changed(string);
    callback search-next();
    callback search-prev();
    callback select-search-result(int);

    // Text selection & annotation callbacks
    callback copy-selection();
    callback selection-started(int, length, length); // (page, x, y)
    callback selection-dragged(int, length, length); // (page, x, y)
    callback selection-completed(int, length, length); // (page, x, y)
    callback clear-selection();
    callback create-annotation(string, int); // (kind, color_index)
    callback create-note-annotation(string, int); // (comment, color_index)
    callback delete-annotation(int); // (id)
    callback update-annotation-color(int, int); // (id, color_index)
    callback update-annotation-note(int, string); // (id, comment)
    callback undo();
    callback redo();
    callback scroll-content-y-changed(length);

    public function scroll-to-page(index: int) {
        root.scroll-content-y = -index * root.scroll-item-height;
    }

    property <int> visible-page: max(0, min(root.total-pages - 1, round(-root.scroll-content-y / max(1px, root.scroll-item-height))));

    changed visible-page => {
        if (root.is-scroll-view && !root.suppress-page-change) {
            root.visible-page-changed(root.visible-page);
        }
    }

    changed scroll-content-y => {
        if (root.is-scroll-view) {
            root.scroll-content-y-changed(root.scroll-content-y);
        }
    }

    forward-focus: keyboard-handler;

    public function grab-focus() {
        keyboard-handler.focus();
    }

    changed show-popup => {
        if (!root.show-popup) {
            keyboard-handler.focus();
        }
    }

    changed show-note-input => {
        if (!root.show-note-input) {
            keyboard-handler.focus();
        }
    }

    changed has-selection => {
        if (!root.has-selection && !root.show-note-input) {
            keyboard-handler.focus();
        }
    }

    changed show-search => {
        if (!root.show-search) {
            if (root.sidebar-tab == 3) {
                root.sidebar-tab = root.toc-items.length > 0 ? 0 : 1;
            }
            keyboard-handler.focus();
        }
    }

    changed width => {
        if (root.is-fit-width) {
            root.zoom-fit-width();
        }
    }

    keyboard-handler := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.modifiers.control || event.text == Key.Control || event.text == Key.ControlR || event.text == "\u{11}" || event.text == "\u{16}") {
                root.is-ctrl-pressed = true;
            }

            // Shortcuts modal interactions: close on Esc/F1/Ctrl+/ or absorb input
            if (root.show-shortcuts-modal) {
                if (event.text == Key.Escape || event.text == Key.F1 || ((event.modifiers.control) && (event.text == "/" || event.text == "?" || event.text == "\u{1f}"))) {
                    root.show-shortcuts-modal = false;
                    return accept;
                }
                return accept;
            }

            // Toggle Shortcuts Modal: F1, Ctrl + /, Ctrl + ?, or ? (outside input fields)
            if (event.text == Key.F1 || ((event.modifiers.control) && (event.text == "/" || event.text == "?" || event.text == "\u{1f}")) || (event.text == "?" && !root.show-search && !root.focus-page-input-flag && !root.show-password-modal)) {
                root.show-shortcuts-modal = true;
                return accept;
            }

            if (event.text == Key.F11) {
                root.toggle-zen-mode();
                return accept;
            }

            if (event.modifiers.control || event.text == "\u{1a}" || event.text == "\u{13}" || event.text == "\u{19}" || event.text == "\u{15}" || event.text == "\u{2}" || event.text == "\u{14}" || event.text == "\u{17}" || event.text == "\u{6}" || event.text == "\u{3}") {
                if (event.modifiers.shift || (event.modifiers.control && (event.text == "Z" || event.text == "S" || event.text == "W" || event.text == "F"))) {
                    // Ctrl + Shift + S: Save As
                    if (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                        root.save-document-as();
                        return accept;
                    // Ctrl + Shift + Z: Redo
                    } else if (event.text == "z" || event.text == "Z" || event.text == "\u{1a}") {
                        root.redo();
                        return accept;
                    // Ctrl + Shift + W: Fit to Width
                    } else if (event.text == "w" || event.text == "W" || event.text == "\u{17}") {
                        root.is-fit-width = true;
                        root.zoom-fit-width();
                        return accept;
                    // Ctrl + Shift + F: Fit to Page (Window)
                    } else if (event.text == "f" || event.text == "F" || event.text == "\u{6}") {
                        root.is-fit-width = false;
                        root.zoom-fit();
                        return accept;
                    }
                } else if (event.modifiers.alt) {
                    // Ctrl + Alt + S: Strikethrough
                    if (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                        if (root.has-selection) {
                            root.create-annotation("strikethrough", root.selected-color-index);
                            return accept;
                        }
                    // Ctrl + Alt + N: Note
                    } else if (event.text == "n" || event.text == "N" || event.text == "\u{e}") {
                        if (root.has-selection) {
                            root.show-popup = true;
                            root.show-note-input = true;
                            return accept;
                        }
                    // Ctrl + Alt + D: Toggle Dual Page Mode
                    } else if (event.text == "d" || event.text == "D" || event.text == "\u{4}") {
                        root.set-dual-page(!root.is-dual-page);
                        return accept;
                    // Ctrl + Alt + C: Toggle Cover Page Offset
                    } else if (event.text == "c" || event.text == "C" || event.text == "\u{3}") {
                        if (root.is-dual-page) {
                            root.toggle-cover-alone(!root.dual-page-cover-alone);
                            return accept;
                        }
                    }
                } else {
                    // Multi-tab shortcuts:
                    // Ctrl + T: New Tab
                    if (event.text == "t" || event.text == "T" || event.text == "\u{14}") {
                        root.new-tab();
                        return accept;
                    // Ctrl + W: Close current Tab
                    } else if (event.text == "w" || event.text == "W" || event.text == "\u{17}") {
                        root.close-tab(root.active-tab-index);
                        return accept;
                    // Ctrl + O: Open Document
                    } else if (event.text == "o" || event.text == "O" || event.text == "\u{f}") {
                        root.open-document();
                        return accept;
                    // Ctrl + Tab: Next Tab, Ctrl + Shift + Tab: Previous Tab
                    } else if (event.text == Key.Tab) {
                        if (event.modifiers.shift) {
                            root.prev-tab();
                        } else {
                            root.next-tab();
                        }
                        return accept;
                    // Ctrl + PageDown: Next Tab
                    } else if (event.text == Key.PageDown) {
                        root.next-tab();
                        return accept;
                    // Ctrl + PageUp: Previous Tab
                    } else if (event.text == Key.PageUp) {
                        root.prev-tab();
                        return accept;
                    // Ctrl + 1..9: Select Tab 1..9
                    } else if (event.text == "1") {
                        root.select-tab(0);
                        return accept;
                    } else if (event.text == "2") {
                        root.select-tab(1);
                        return accept;
                    } else if (event.text == "3") {
                        root.select-tab(2);
                        return accept;
                    } else if (event.text == "4") {
                        root.select-tab(3);
                        return accept;
                    } else if (event.text == "5") {
                        root.select-tab(4);
                        return accept;
                    } else if (event.text == "6") {
                        root.select-tab(5);
                        return accept;
                    } else if (event.text == "7") {
                        root.select-tab(6);
                        return accept;
                    } else if (event.text == "8") {
                        root.select-tab(7);
                        return accept;
                    } else if (event.text == "9") {
                        root.select-tab(8);
                        return accept;
                    // Ctrl + F: Toggle Search
                    } else if (event.text == "f" || event.text == "F" || event.text == "\u{6}") {
                        root.toggle-search();
                        return accept;
                    // Ctrl + G: Go to page
                    } else if (event.text == "g" || event.text == "G" || event.text == "\u{7}") {
                        root.focus-page-input-flag = true;
                        return accept;
                    // Ctrl + S: Save Document
                    } else if (event.text == "s" || event.text == "S" || event.text == "\u{13}") {
                        root.save-document();
                        return accept;
                    // Ctrl + C: Copy selection or selected annotation
                    } else if (event.text == "c" || event.text == "C" || event.text == "\u{3}") {
                        if (root.has-selection || root.selected-annotation-id > 0) {
                            root.copy-selection();
                            return accept;
                        }
                    // Ctrl + Z: Undo
                    } else if (event.text == "z" || event.text == "Z" || event.text == "\u{1a}") {
                        root.undo();
                        return accept;
                    // Ctrl + Y: Redo
                    } else if (event.text == "y" || event.text == "Y" || event.text == "\u{19}") {
                        root.redo();
                        return accept;
                    // Ctrl + H: Highlight
                    } else if (event.text == "h" || event.text == "H" || (event.modifiers.control && event.text == "\u{8}")) {
                        if (root.has-selection) {
                            root.create-annotation("highlight", root.selected-color-index);
                            return accept;
                        }
                    // Ctrl + U: Underline
                    } else if (event.text == "u" || event.text == "U" || event.text == "\u{15}") {
                        if (root.has-selection) {
                            root.create-annotation("underline", root.selected-color-index);
                            return accept;
                        }
                    } else if (event.text == "+" || event.text == "=") {
                        root.zoom-in();
                        return accept;
                    } else if (event.text == "-" || event.text == "_") {
                        root.zoom-out();
                        return accept;
                    } else if (event.text == "0") {
                        root.zoom-reset();
                        return accept;
                    } else if (event.text == "m" || event.text == "M" || (event.modifiers.control && (event.text == "\n" || event.text == "\u{d}"))) {
                        root.set-view-mode(!root.is-scroll-view);
                        return accept;
                    } else if (event.text == "r" || event.text == "R" || (event.modifiers.control && event.text == "\u{12}")) {
                        root.rotate-clockwise();
                        return accept;
                    // Ctrl + D / Ctrl + I: Document Properties (Doc Info Modal)
                    } else if (event.text == "d" || event.text == "D" || event.text == "i" || event.text == "I" || (event.modifiers.control && (event.text == "\u{4}" || event.text == "\u{9}"))) {
                        root.show-doc-info = !root.show-doc-info;
                        return accept;
                    // Ctrl + P: Print Document
                    } else if (event.text == "p" || event.text == "P" || (event.modifiers.control && event.text == "\u{10}")) {
                        root.open-print-dialog();
                        return accept;
                    } else if (event.text == "b" || event.text == "B" || event.text == "\u{2}") {
                        root.toggle-sidebar();
                        return accept;
                    }
                }
            } else {
                if (event.text == Key.Escape) {
                    if (root.show-shortcuts-modal) {
                        root.show-shortcuts-modal = false;
                        return accept;
                    }
                    if (root.show-unsaved-modal) {
                        root.cancel-unsaved-close();
                        return accept;
                    }
                    if (root.show-password-modal) {
                        root.cancel-password();
                        return accept;
                    }
                    if (root.show-print-modal) {
                        root.cancel-print();
                        return accept;
                    }
                    if (root.show-tab-menu) {
                        root.show-tab-menu = false;
                        return accept;
                    }
                    if (root.show-doc-info) {
                        root.show-doc-info = false;
                        return accept;
                    }
                    if (root.show-search) {
                        root.close-search();
                        return accept;
                    }
                    if (root.show-popup || root.has-selection || root.selected-annotation-id > 0) {
                        root.clear-selection();
                        root.show-popup = false;
                        root.selected-annotation-id = -1;
                        root.selected-annotation-kind = "";
                        root.hovered-annotation-id = -1;
                        return accept;
                    }
                    if (root.is-zen-mode) {
                        root.exit-zen-mode();
                        return accept;
                    }
                } else if (event.text == Key.Return) {
                    if (root.show-unsaved-modal) {
                        root.confirm-save-and-close(root.unsaved-tab-index, root.unsaved-is-quitting);
                        return accept;
                    }
                    if (root.show-password-modal) {
                        root.submit-password(root.password-input);
                        return accept;
                    }
                    if (root.show-print-modal) {
                        root.request-print(root.selected-printer, root.print-page-mode, root.print-page-range, root.print-copies);
                        return accept;
                    }
                } else if (root.selected-annotation-id > 0) {
                    if (event.text == "1") { root.selected-color-index = 0; root.update-annotation-color(root.selected-annotation-id, 0); return accept; }
                    else if (event.text == "2") { root.selected-color-index = 1; root.update-annotation-color(root.selected-annotation-id, 1); return accept; }
                    else if (event.text == "3") { root.selected-color-index = 2; root.update-annotation-color(root.selected-annotation-id, 2); return accept; }
                    else if (event.text == "4") { root.selected-color-index = 3; root.update-annotation-color(root.selected-annotation-id, 3); return accept; }
                    else if (event.text == "5") { root.selected-color-index = 4; root.update-annotation-color(root.selected-annotation-id, 4); return accept; }
                    else if (event.text == "6") { root.selected-color-index = 5; root.update-annotation-color(root.selected-annotation-id, 5); return accept; }
                    else if (event.text == Key.Delete || event.text == Key.Backspace) {
                        root.delete-annotation(root.selected-annotation-id);
                        root.show-popup = false;
                        root.selected-annotation-id = -1;
                        root.selected-annotation-kind = "";
                        root.hovered-annotation-id = -1;
                        return accept;
                    }
                } else if (root.has-selection && !root.show-note-input) {
                    if (event.text == "1") { root.selected-color-index = 0; return accept; }
                    else if (event.text == "2") { root.selected-color-index = 1; return accept; }
                    else if (event.text == "3") { root.selected-color-index = 2; return accept; }
                    else if (event.text == "4") { root.selected-color-index = 3; return accept; }
                    else if (event.text == "5") { root.selected-color-index = 4; return accept; }
                    else if (event.text == "6") { root.selected-color-index = 5; return accept; }
                } else if (event.modifiers.alt && event.text == Key.LeftArrow) {
                    root.nav-back();
                    return accept;
                } else if (event.modifiers.alt && event.text == Key.RightArrow) {
                    root.nav-forward();
                    return accept;
                } else if (event.text == Key.LeftArrow || event.text == Key.PageUp || event.text == Key.UpArrow) {
                    root.prev-page();
                    return accept;
                } else if (event.text == Key.RightArrow || event.text == Key.PageDown || event.text == Key.DownArrow) {
                    root.next-page();
                    return accept;
                } else if (event.text == "t" || event.text == "T" || event.text == "p" || event.text == "P") {
                    root.cycle-paper-theme();
                    return accept;
                } else if (event.text == "w" || event.text == "W") {
                    root.is-fit-width = true;
                    root.zoom-fit-width();
                    return accept;
                }
            }
            return reject;
        }

        key-released(event) => {
            if (event.text == Key.Control || event.text == Key.ControlR || event.text == "\u{11}" || event.text == "\u{16}") {
                root.is-ctrl-pressed = false;
            }
            return reject;
        }

        focus-lost(reason) => {
            root.is-ctrl-pressed = false;
            root.is-sidebar-resizing = false;
        }

        
VerticalLayout {
            padding: 0;
            spacing: 0;

            // Top Tab Bar (46px)
            if !root.is-zen-mode && root.open-tabs.length > 0: Rectangle {
                height: 46px;
                background: Theme.sidebar-bg;
                z: 70;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 5px;
                    alignment: start;

                    for tab[idx] in root.open-tabs : tab-item := TabItem {
                        title: tab.title;
                        is-active: tab.is-active;
                        is-dirty: tab.is-dirty;
                        clicked => { root.select-tab(idx); }
                        close-clicked => { root.close-tab(idx); }
                        context-menu(local-x, local-y) => {
                            root.tab-menu-index = idx;
                            root.tab-menu-x = min(root.width - 210px, max(8px, tab-item.x + local-x));
                            root.tab-menu-y = 46px;
                            root.show-tab-menu = true;
                        }
                    }

                    // New Tab Button (+)
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: new-tab-ta.pressed ? Theme.active-bg : new-tab-ta.has-hover ? Theme.hover-bg : transparent;
                        border-width: 1px;
                        border-color: new-tab-ta.has-hover ? Theme.border-subtle : transparent;
                        y: (parent.height - self.height) / 2;

                        Text {
                            text: "+";
                            font-family: "Inter";
                            font-size: 18px;
                            font-weight: 500;
                            color: new-tab-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        new-tab-ta := TouchArea {
                            clicked => { root.new-tab(); }
                            mouse-cursor: pointer;
                        }

                        if new-tab-ta.has-hover: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height + 6px;
                            width: newtab-tip.preferred-width + 16px;
                            height: 24px;
                            background: Theme.tooltip-bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.tooltip-border;
                            drop-shadow-blur: 10px;
                            drop-shadow-offset-y: 3px;
                            drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
                            z: 1000;

                            newtab-tip := Text {
                                text: "New tab (Ctrl+T)";
                                font-family: "Inter";
                                font-size: 11px;
                                font-weight: 500;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // Top Header Bar (60px)
            if !root.is-zen-mode: Rectangle {
                height: 60px;
                background: Theme.card-bg;
                border-width: 0;
                z: 60;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 14px;
                    alignment: space-between;

                    // Left Group: Open PDF (Recent Documents), Save, & History Undo/Redo
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        // Signature Accent Button: Open PDF (triggers Recent Documents list)
                        SignaturePillButton {
                            icon: @image-url("../assets/icons/folder-open.svg");
                            text: "Open PDF";
                            has-chevron: true;
                            tooltip: "Open PDF or recent documents (Ctrl+O)";
                            y: (parent.height - self.height) / 2;
                            clicked => { root.show-recent-books = !root.show-recent-books; }
                        }

                        // Save Button (when dirty, after Open PDF)
                        if root.is-dirty: Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: save-ta.has-hover ? Theme.cta-hover : Theme.cta-bg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            animate background { duration: 100ms; }
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 7px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/check.svg");
                                    width: 17px;
                                    height: 17px;
                                    colorize: Theme.on-cta;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: root.is-saving ? "Saving..." : "Save";
                                    font-family: "Inter";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.on-cta;
                                    vertical-alignment: center;
                                }
                            }

                            save-ta := TouchArea {
                                clicked => { root.save-document(); }
                                mouse-cursor: pointer;
                            }

                            if save-ta.has-hover: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.height + 6px;
                                width: save-tip.preferred-width + 16px;
                                height: 24px;
                                background: Theme.tooltip-bg;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.tooltip-border;
                                drop-shadow-blur: 10px;
                                drop-shadow-offset-y: 3px;
                                drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
                                z: 1000;

                                save-tip := Text {
                                    text: "Save annotations to PDF (Ctrl+S)";
                                    font-family: "Inter";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Saved Confirmation Badge
                        if !root.is-dirty && root.show-saved-badge: Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.surface-subtle;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/check.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.text-primary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Saved";
                                    font-family: "Inter";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Undo & Redo
                        if !root.has-error: IconButton {
                            text: "↺";
                            has-icon: false;
                            enabled: root.can-undo;
                            size: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            tooltip: "Undo (Ctrl+Z)";
                            clicked => { root.undo(); }
                        }

                        if !root.has-error: IconButton {
                            text: "↻";
                            has-icon: false;
                            enabled: root.can-redo;
                            size: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            tooltip: "Redo (Ctrl+Y)";
                            clicked => { root.redo(); }
                        }
                    }

                    // Center Group: View Mode Switcher & Page Stepper
                    if !root.has-error: HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        // Segmented View Mode Pill: Page | Dual | Scroll
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.pill-track;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;

                                ViewModeSegment {
                                    icon: @image-url("../assets/icons/book-open.svg");
                                    text: "Page";
                                    active: !root.is-scroll-view && !root.is-dual-page;
                                    tooltip: "Single page view (Ctrl+1)";
                                    clicked => {
                                        root.set-dual-page(false);
                                        root.set-view-mode(false);
                                    }
                                }

                                ViewModeSegment {
                                    icon: @image-url("../assets/icons/columns-2.svg");
                                    text: "Dual";
                                    active: !root.is-scroll-view && root.is-dual-page;
                                    tooltip: "Dual page spread (Ctrl+Alt+D)";
                                    clicked => {
                                        root.set-dual-page(true);
                                    }
                                }

                                ViewModeSegment {
                                    icon: @image-url("../assets/icons/scroll.svg");
                                    text: "Scroll";
                                    active: root.is-scroll-view;
                                    tooltip: "Continuous scroll view (Ctrl+3)";
                                    clicked => {
                                        root.set-dual-page(false);
                                        root.set-view-mode(true);
                                    }
                                }
                            }
                        }

                        // Cover Page Offset Toggle (visible in Dual-Page view)
                        if root.is-dual-page && !root.is-scroll-view: Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            y: (parent.height - self.height) / 2;
                            background: root.dual-page-cover-alone ? Theme.card-bg : Theme.pill-track;
                            border-width: 1px;
                            border-color: root.dual-page-cover-alone ? Theme.border-strong : Theme.border;
                            animate background { duration: 120ms; easing: ease-out; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/book-open.svg");
                                    width: 15px;
                                    height: 15px;
                                    colorize: root.dual-page-cover-alone ? Theme.text-primary : Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Cover";
                                    font-family: "Inter";
                                    font-size: 13px;
                                    font-weight: root.dual-page-cover-alone ? 700 : 500;
                                    color: root.dual-page-cover-alone ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            cover-ta := TouchArea {
                                clicked => {
                                    root.toggle-cover-alone(!root.dual-page-cover-alone);
                                }
                                mouse-cursor: pointer;
                            }

                            if cover-ta.has-hover: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.height + 6px;
                                width: cover-tip-text.preferred-width + 16px;
                                height: 24px;
                                background: Theme.tooltip-bg;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.tooltip-border;
                                drop-shadow-blur: 10px;
                                drop-shadow-offset-y: 3px;
                                drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
                                z: 1000;

                                cover-tip-text := Text {
                                    text: "First page as cover (alone) (Ctrl+Alt+C)";
                                    font-family: "Inter";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Page Stepper Pill: < Page 12 / 145 >
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;
                                alignment: center;

                                IconButton {
                                    icon: @image-url("../assets/icons/chevron-left.svg");
                                    enabled: root.can-prev;
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Previous page (PageUp / ←)";
                                    clicked => { root.prev-page(); }
                                }

                                // Interactive Page Input Field
                                page-input-box := Rectangle {
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    background: page-input.has-focus ? Theme.surface-subtle : Theme.card-subtle;
                                    border-radius: 5px;
                                    border-width: page-input.has-focus ? 1.5px : 1px;
                                    border-color: page-input.has-focus ? Theme.accent : Theme.border-subtle;
                                    min-width: 44px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        page-input := TextInput {
                                            text <=> root.current-page-input;
                                            font-family: "Inter";
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            single-line: true;
                                            min-width: 32px;

                                            property <bool> trigger-focus: root.focus-page-input-flag;
                                            changed trigger-focus => {
                                                if (self.trigger-focus) {
                                                    self.focus();
                                                    root.focus-page-input-flag = false;
                                                }
                                            }

                                            accepted => {
                                                root.go-to-page(self.text);
                                                keyboard-handler.focus();
                                            }

                                            key-pressed(event) => {
                                                if (event.text == Key.Return) {
                                                    root.go-to-page(self.text);
                                                    keyboard-handler.focus();
                                                    return accept;
                                                } else if (event.text == Key.Escape) {
                                                    root.reset-page-input();
                                                    keyboard-handler.focus();
                                                    return accept;
                                                }
                                                return reject;
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.page-suffix-display;
                                    font-family: "Inter";
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/chevron-right.svg");
                                    enabled: root.can-next;
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Next page (PageDown / →)";
                                    clicked => { root.next-page(); }
                                }
                            }
                        }
                    }

                    // Right Group: Zoom, Rotate, Save, and Signature Open PDF Button
                    if !root.has-error: HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Zoom & Rotate Pill
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.card-bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                alignment: center;

                                IconButton {
                                    icon: @image-url("../assets/icons/zoom-out.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Zoom out (Ctrl+-)";
                                    clicked => { root.is-fit-width = false; root.zoom-out(); }
                                }

                                Rectangle {
                                    height: 28px;
                                    min-width: 52px;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: root.zoom-display;
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: zoom-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    zoom-ta := TouchArea {
                                        clicked => { root.is-fit-width = false; root.zoom-reset(); }
                                        mouse-cursor: pointer;
                                    }

                                    if zoom-ta.has-hover: Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: parent.height + 6px;
                                        width: zoom-tip.preferred-width + 16px;
                                        height: 24px;
                                        background: Theme.tooltip-bg;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.tooltip-border;
                                        drop-shadow-blur: 10px;
                                        drop-shadow-offset-y: 3px;
                                        drop-shadow-color: Theme.dark ? #000000B0 : #00000025;
                                        z: 1000;

                                        zoom-tip := Text {
                                            text: "Reset zoom to 200%";
                                            font-family: "Inter";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/zoom-in.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Zoom in (Ctrl+=)";
                                    clicked => { root.is-fit-width = false; root.zoom-in(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/fit-to-page.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Fit to page (Ctrl+0)";
                                    clicked => { root.is-fit-width = false; root.zoom-fit(); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/fit-to-width.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    active: root.is-fit-width;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Fit to width (Ctrl+2 / W)";
                                    clicked => { root.is-fit-width = true; root.zoom-fit-width(); }
                                }

                                IconButton {
                                    icon: root.is-zen-mode ? @image-url("../assets/icons/minimize-2.svg") : @image-url("../assets/icons/maximize-2.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: root.is-zen-mode ? "Exit Zen mode (F11)" : "Zen mode (F11)";
                                    clicked => { root.toggle-zen-mode(); }
                                }

                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    background: Theme.border;
                                    y: (parent.height - self.height) / 2;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/rotate-cw.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Rotate clockwise (R)";
                                    clicked => { root.rotate-clockwise(); }
                                }

                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    background: Theme.border;
                                    y: (parent.height - self.height) / 2;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/info.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Document properties (Ctrl+I)";
                                    clicked => { root.show-doc-info = true; }
                                }

                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    background: Theme.border;
                                    y: (parent.height - self.height) / 2;
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/printer.svg");
                                    size: 30px;
                                    icon-size: 18px;
                                    border-radius: 15px;
                                    y: (parent.height - self.height) / 2;
                                    tooltip: "Print document (Ctrl+P)";
                                    tooltip-align: "right";
                                    clicked => { root.open-print-dialog(); }
                                }
                            }
                        }
                    }
                }
            }

            // Main Workspace Area// Main Workspace Area (Navigation Rail + Sidebar + Document Viewport)
            HorizontalLayout {
                spacing: 0;
                padding: 0;

                // Left Navigation Rail (Vertical Icon Dock)
                if !root.is-zen-mode: Rectangle {
                    width: 58px;
                    background: Theme.card-bg;
                    z: 50;
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Theme.border;
                    }

                    VerticalLayout {
                        padding-top: 14px;
                        padding-bottom: 14px;
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 12px;
                        alignment: space-between;

                        // Top Group: Monogram & Tabs
                        VerticalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Brand Icon
                            Image {
                                source: @image-url("../assets/icons/folio-icon-dark.svg");
                                width: 40px;
                                height: 40px;
                            }

                            Rectangle {
                                width: 24px;
                                height: 1px;
                                background: Theme.border;
                                x: (parent.width - self.width) / 2;
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/list.svg");
                                active: root.show-sidebar && root.sidebar-tab == 0;
                                tooltip: "Table of contents";
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 0) {
                                        root.toggle-sidebar();
                                    } else {
                                        root.sidebar-tab = 0;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                    }
                                }
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/highlighter.svg");
                                active: root.show-sidebar && root.sidebar-tab == 1;
                                tooltip: "Highlights";
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 1) {
                                        root.toggle-sidebar();
                                    } else {
                                        root.sidebar-tab = 1;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                    }
                                }
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/message-square.svg");
                                active: root.show-sidebar && root.sidebar-tab == 2;
                                tooltip: "Notes";
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 2) {
                                        root.toggle-sidebar();
                                    } else {
                                        root.sidebar-tab = 2;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                    }
                                }
                            }

                            NavRailButton {
                                icon: @image-url("../assets/icons/search.svg");
                                active: root.show-sidebar && root.sidebar-tab == 3;
                                tooltip: "Search document (Ctrl+F)";
                                clicked => {
                                    if (root.show-sidebar && root.sidebar-tab == 3) {
                                        root.close-search();
                                    } else {
                                        root.sidebar-tab = 3;
                                        if (!root.show-sidebar) { root.toggle-sidebar(); }
                                        root.show-search = true;
                                    }
                                }
                            }
                        }

                        // Bottom Group: Paper Theme & App Chrome Theme
                        VerticalLayout {
                            spacing: 8px;
                            alignment: end;

                            // Paper Theme (Document Color Mode)
                            NavRailButton {
                                icon: @image-url("../assets/icons/palette.svg");
                                tooltip: "Document theme (Light / Sepia / Dark)";
                                clicked => {
                                    root.cycle-paper-theme();
                                }
                            }

                            // App Chrome Theme (Dark / Light UI)
                            NavRailButton {
                                icon: Theme.dark ? @image-url("../assets/icons/sun.svg") : @image-url("../assets/icons/moon.svg");
                                tooltip: Theme.dark ? "Switch to light UI" : "Switch to dark UI";
                                clicked => {
                                    root.toggle-theme();
                                }
                            }
                        }
                    }
                }

                // Sidebar Drawer (Contents, Highlights, Notes, Search)
                sidebar := Rectangle {
                    width: (root.show-sidebar && !root.is-zen-mode && !root.has-error) ? root.sidebar-width : 0px;
                    clip: true;
                    background: Theme.card-bg;
                    animate width { duration: root.is-sidebar-resizing ? 0ms : 160ms; easing: ease-out; }

                    // Dismiss overlay for sort menu
                    if root.show-sort-menu: TouchArea {
                        width: 100%;
                        height: 100%;
                        z: 45;
                        clicked => {
                            root.show-sort-menu = false;
                        }
                    }

                    // Sort & View Dropdown Popover
                    if root.show-sort-menu: Rectangle {
                        x: parent.width - 190px;
                        y: 44px;
                        width: 178px;
                        height: sm-vl.preferred-height;
                        z: 50;
                        background: Theme.card-bg;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: Theme.dark ? #00000088 : #00000028;
                        clip: true;

                        sm-vl := VerticalLayout {
                            padding: 6px;
                            spacing: 3px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 6px;
                                padding-bottom: 4px;
                                Text {
                                    text: "SORT & VIEW";
                                    font-family: "Inter";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.text-muted;
                                }
                            }

                            // 0: Document Order (with chapters)
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: sm0-ta.has-hover ? Theme.hover-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "Document Order";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: root.annotation-sort-mode == 0 ? 600 : 400;
                                        color: root.annotation-sort-mode == 0 ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    if root.annotation-sort-mode == 0: Image {
                                        source: @image-url("../assets/icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                sm0-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-sort-menu = false;
                                        root.set-annotation-sort-mode(0);
                                    }
                                }
                            }

                            // 1: Newest First
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: sm1-ta.has-hover ? Theme.hover-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "Newest First";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: root.annotation-sort-mode == 1 ? 600 : 400;
                                        color: root.annotation-sort-mode == 1 ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    if root.annotation-sort-mode == 1: Image {
                                        source: @image-url("../assets/icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                sm1-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-sort-menu = false;
                                        root.set-annotation-sort-mode(1);
                                    }
                                }
                            }

                            // 2: Oldest First
                            Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: sm2-ta.has-hover ? Theme.hover-bg : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    Text {
                                        text: "Oldest First";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        font-weight: root.annotation-sort-mode == 2 ? 600 : 400;
                                        color: root.annotation-sort-mode == 2 ? Theme.accent : Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    if root.annotation-sort-mode == 2: Image {
                                        source: @image-url("../assets/icons/check.svg");
                                        width: 16px;
                                        height: 16px;
                                        colorize: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                sm2-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-sort-menu = false;
                                        root.set-annotation-sort-mode(2);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        width: root.sidebar-width;
                        height: 100%;
                        padding: 0;
                        spacing: 0;

                        // Sidebar Header
                        Rectangle {
                            z: 20;
                            height: 54px;
                            background: Theme.surface-subtle;

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                width: 100%;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    Text {
                                        text: root.sidebar-tab == 0 ? "Document Outline" : root.sidebar-tab == 1 ? "Highlights" : root.sidebar-tab == 2 ? "Notes" : "Search";
                                        font-family: "Inter";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }

                                    // Count badge
                                    if root.sidebar-tab == 1 && root.highlight-items.length > 0: Rectangle {
                                        height: 24px;
                                        min-width: 24px;
                                        border-radius: 12px;
                                        background: Theme.card-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.highlight-items.length;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.sidebar-tab == 2 && root.note-items.length > 0: Rectangle {
                                        height: 24px;
                                        min-width: 24px;
                                        border-radius: 12px;
                                        background: Theme.card-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.note-items.length;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.sidebar-tab == 3 && root.search-query != "" && root.search-results.length > 0: Rectangle {
                                        height: 24px;
                                        min-width: 24px;
                                        border-radius: 12px;
                                        background: Theme.card-bg;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        y: (parent.height - self.height) / 2;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.search-results.length;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    y: (parent.height - 32px) / 2;

                                    if (root.sidebar-tab == 1 || root.sidebar-tab == 2) && (root.highlight-items.length > 0 || root.note-items.length > 0): IconButton {
                                        icon: @image-url("../assets/icons/arrow-down-up.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        active: root.show-sort-menu || root.annotation-sort-mode > 0;
                                        tooltip: "Sort & view";
                                        clicked => {
                                            root.show-sort-menu = !root.show-sort-menu;
                                        }
                                    }

                                    if (root.sidebar-tab == 1 || root.sidebar-tab == 2) && (root.highlight-items.length > 0 || root.note-items.length > 0): IconButton {
                                        icon: @image-url("../assets/icons/copy.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        tooltip: "Copy annotations to clipboard";
                                        clicked => { root.copy-annotations-markdown(); }
                                    }

                                    if (root.sidebar-tab == 1 || root.sidebar-tab == 2) && (root.highlight-items.length > 0 || root.note-items.length > 0): IconButton {
                                        icon: @image-url("../assets/icons/download.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        tooltip: "Export annotations as Markdown";
                                        clicked => { root.export-annotations-markdown(); }
                                    }

                                    IconButton {
                                        icon: @image-url("../assets/icons/x.svg");
                                        size: 32px;
                                        icon-size: 18px;
                                        border-radius: 8px;
                                        tooltip: "Close sidebar";
                                        tooltip-align: "right";
                                        clicked => {
                                            if (root.sidebar-tab == 3) {
                                                root.close-search();
                                            } else {
                                                root.toggle-sidebar();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 0 Body: Table of Contents
                        if root.sidebar-tab == 0: VerticalLayout {
                            vertical-stretch: 1;

                            if root.toc-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Outline";
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "This document does not provide a table of contents.";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.toc-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.toc-items: row := Rectangle {
                                    height: 42px;
                                    width: parent.width;
                                    background: (item.page == root.current-page || row-ta.has-hover) ? Theme.hover-bg : transparent;
                                    animate background { duration: 100ms; }

                                    row-ta := TouchArea {
                                        clicked => { root.jump-to-page(item.page); }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px + item.depth * 18px;
                                        padding-right: 16px;
                                        spacing: 8px;

                                        if item.has-children: chevron-btn := Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 6px;
                                            background: chev-ta.has-hover ? Theme.hover-bg : transparent;

                                            Image {
                                                x: (parent.width - 16px) / 2;
                                                y: (parent.height - 16px) / 2;
                                                width: 16px;
                                                height: 16px;
                                                source: item.is-expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg");
                                                colorize: chev-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                            }

                                            chev-ta := TouchArea {
                                                clicked => { root.toggle-toc-collapse(item.id); }
                                                mouse-cursor: pointer;
                                            }
                                        }

                                        if !item.has-children: Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: item.title;
                                            font-family: "Inter";
                                            font-size: 15px;
                                            font-weight: item.page == root.current-page ? 600 : 400;
                                            color: item.page == root.current-page ? Theme.text-primary : row-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: item.display-page;
                                            font-family: "Inter";
                                            font-size: 14px;
                                            color: item.page == root.current-page ? Theme.accent : Theme.text-muted;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            horizontal-stretch: 0;
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 1 Body: Highlights & Markups
                        if root.sidebar-tab == 1: VerticalLayout {
                            vertical-stretch: 1;

                            if root.highlight-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Highlights Yet";
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Select text on any page to highlight, underline, or strike through.";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.highlight-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.highlight-items: VerticalLayout {
                                    spacing: 0;

                                    if item.group-header != "": Rectangle {
                                        height: 32px;
                                        background: Theme.surface-subtle;

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.border-subtle;
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: start;

                                            Text {
                                                text: item.group-header;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    h-card := Rectangle {
                                        height: 72px;
                                        width: parent.width;
                                        background: transparent;

                                        inner-h-card := Rectangle {
                                            x: 8px;
                                            y: 3px;
                                            width: parent.width - 16px;
                                            height: parent.height - 6px;
                                            border-radius: 10px;
                                            background: h-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                                            border-width: 1px;
                                            border-color: h-ta.has-hover ? Theme.border : Theme.border-subtle;
                                            animate background { duration: 80ms; }

                                            // Color indicator rounded pill on left
                                            Rectangle {
                                                x: 5px;
                                                y: (parent.height - 36px) / 2;
                                                width: 4px;
                                                height: 36px;
                                                border-radius: 2px;
                                                background: item.color;
                                            }

                                            h-ta := TouchArea {
                                                x: 0;
                                                y: 0;
                                                width: parent.width - 44px;
                                                height: parent.height;
                                                clicked => { root.jump-to-page(item.page); }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                padding-left: 18px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: space-between;

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 4px;
                                                    horizontal-stretch: 1;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;

                                                        Text {
                                                            text: item.kind == "highlight" ? "Highlight" : item.kind == "underline" ? "Underline" : "Strikethrough";
                                                            font-family: "Inter";
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: item.color;
                                                            vertical-alignment: center;
                                                        }

                                                        Rectangle {
                                                            height: 18px;
                                                            border-radius: 9px;
                                                            background: Theme.card-bg;
                                                            y: (parent.height - self.height) / 2;

                                                            HorizontalLayout {
                                                                padding-left: 6px;
                                                                padding-right: 6px;
                                                                alignment: center;

                                                                Text {
                                                                    text: "p. \{item.display-page}";
                                                                    font-family: "Inter";
                                                                    font-size: 10px;
                                                                    font-weight: 600;
                                                                    color: Theme.text-secondary;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        if item.display-date != "": Text {
                                                            text: item.display-date;
                                                            font-family: "Inter";
                                                            font-size: 10px;
                                                            color: Theme.text-muted;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Text {
                                                        text: item.snippet;
                                                        font-family: "Inter";
                                                        font-size: 13px;
                                                        font-weight: 500;
                                                        color: Theme.text-primary;
                                                        overflow: elide;
                                                        max-width: root.sidebar-width - 96px;
                                                    }
                                                }

                                                // Delete icon button
                                                IconButton {
                                                    icon: @image-url("../assets/icons/trash.svg");
                                                    size: 28px;
                                                    icon-size: 16px;
                                                    border-radius: 8px;
                                                    y: (parent.height - self.height) / 2;
                                                    tooltip: "Delete highlight";
                                                    tooltip-align: "right";
                                                    clicked => { root.delete-annotation(item.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 2 Body: Notes
                        if root.sidebar-tab == 2: VerticalLayout {
                            vertical-stretch: 1;

                            if root.note-items.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: "No Notes Yet";
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Select text on any page and click the note icon to attach a thought.";
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.note-items.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.note-items: VerticalLayout {
                                    spacing: 0;

                                    if item.group-header != "": Rectangle {
                                        height: 32px;
                                        background: Theme.surface-subtle;

                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.border-subtle;
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: start;

                                            Text {
                                                text: item.group-header;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    n-card := Rectangle {
                                        height: 86px;
                                        width: parent.width;
                                        background: transparent;

                                        inner-n-card := Rectangle {
                                            x: 8px;
                                            y: 3px;
                                            width: parent.width - 16px;
                                            height: parent.height - 6px;
                                            border-radius: 10px;
                                            background: n-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                                            border-width: 1px;
                                            border-color: n-ta.has-hover ? Theme.border : Theme.border-subtle;
                                            animate background { duration: 80ms; }

                                            // Color indicator rounded pill on left
                                            Rectangle {
                                                x: 5px;
                                                y: (parent.height - 40px) / 2;
                                                width: 4px;
                                                height: 40px;
                                                border-radius: 2px;
                                                background: item.color;
                                            }

                                            n-ta := TouchArea {
                                                x: 0;
                                                y: 0;
                                                width: parent.width - 44px;
                                                height: parent.height;
                                                clicked => { root.jump-to-page(item.page); }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                padding-left: 18px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: space-between;

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 3px;
                                                    horizontal-stretch: 1;

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;

                                                        Text {
                                                            text: "Note";
                                                            font-family: "Inter";
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: item.color;
                                                            vertical-alignment: center;
                                                        }

                                                        Rectangle {
                                                            height: 18px;
                                                            border-radius: 9px;
                                                            background: Theme.card-bg;
                                                            y: (parent.height - self.height) / 2;

                                                            HorizontalLayout {
                                                                padding-left: 6px;
                                                                padding-right: 6px;
                                                                alignment: center;

                                                                Text {
                                                                    text: "p. \{item.display-page}";
                                                                    font-family: "Inter";
                                                                    font-size: 10px;
                                                                    font-weight: 600;
                                                                    color: Theme.text-secondary;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        if item.display-date != "": Text {
                                                            text: item.display-date;
                                                            font-family: "Inter";
                                                            font-size: 10px;
                                                            color: Theme.text-muted;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    Text {
                                                        text: item.comment;
                                                        font-family: "Inter";
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text-primary;
                                                        overflow: elide;
                                                        max-width: root.sidebar-width - 96px;
                                                    }

                                                    if item.snippet != "": Text {
                                                        text: "“\{item.snippet}”";
                                                        font-family: "Inter";
                                                        font-size: 11px;
                                                        color: Theme.text-muted;
                                                        overflow: elide;
                                                        max-width: root.sidebar-width - 96px;
                                                    }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/trash.svg");
                                                    size: 28px;
                                                    icon-size: 16px;
                                                    border-radius: 8px;
                                                    y: (parent.height - self.height) / 2;
                                                    tooltip: "Delete note";
                                                    tooltip-align: "right";
                                                    clicked => {
                                                        if (item.kind == "note") {
                                                            root.delete-annotation(item.id);
                                                        } else {
                                                            root.update-annotation-note(item.id, "");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Tab 3 Body: Search in Document
                        if root.sidebar-tab == 3: VerticalLayout {
                            vertical-stretch: 1;
                            padding: 0;
                            spacing: 0;

                            // Search Controls Area (Search input + options row)
                            Rectangle {
                                background: Theme.surface-subtle;

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: 100%;
                                    background: Theme.border;
                                }

                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 12px;
                                    padding-bottom: 12px;
                                    spacing: 10px;

                                    // Row 1: Search Input Pill
                                    search-box := Rectangle {
                                        height: 40px;
                                        background: Theme.card-bg;
                                        border-radius: 20px;
                                        border-width: 1px;
                                        border-color: search-input.has-focus ? Theme.border-strong : Theme.border;
                                        animate border-color { duration: 100ms; }

                                        TouchArea {
                                            clicked => { search-input.focus(); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            Image {
                                                source: @image-url("../assets/icons/search.svg");
                                                width: 18px;
                                                height: 18px;
                                                colorize: Theme.text-secondary;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            search-input := TextInput {
                                                init => { self.focus(); }
                                                text <=> root.search-query;
                                                font-family: "Inter";
                                                font-size: 15px;
                                                color: Theme.text-primary;
                                                vertical-alignment: center;
                                                single-line: true;

                                                edited => {
                                                    root.search-query-changed(self.text);
                                                }

                                                key-pressed(event) => {
                                                    if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                                        root.toggle-search-match-case();
                                                        return accept;
                                                    } else if (event.modifiers.alt && (event.text == "w" || event.text == "W")) {
                                                        root.toggle-search-match-whole-word();
                                                        return accept;
                                                    } else if (event.text == Key.Return) {
                                                        if (event.modifiers.shift) {
                                                            root.search-prev();
                                                        } else {
                                                            root.search-next();
                                                        }
                                                        return accept;
                                                    } else if (event.text == Key.Escape) {
                                                        root.close-search();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }

                                            if root.search-query != "": IconButton {
                                                icon: @image-url("../assets/icons/x.svg");
                                                size: 26px;
                                                icon-size: 16px;
                                                border-radius: 13px;
                                                y: (parent.height - self.height) / 2;
                                                tooltip: "Clear search";
                                                clicked => {
                                                    root.search-query = "";
                                                    root.search-query-changed("");
                                                }
                                            }
                                        }
                                    }

                                    // Row 2: Options & Navigation Controls
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: space-between;

                                        // Left: Modifiers (Aa and [W])
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;

                                            IconButton {
                                                icon: @image-url("../assets/icons/case-sensitive.svg");
                                                active: root.search-match-case;
                                                accent-active: true;
                                                size: 34px;
                                                icon-size: 19px;
                                                border-radius: 8px;
                                                tooltip: "Match case (Alt+C)";
                                                clicked => { root.toggle-search-match-case(); }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/whole-word.svg");
                                                active: root.search-match-whole-word;
                                                accent-active: true;
                                                size: 34px;
                                                icon-size: 19px;
                                                border-radius: 8px;
                                                tooltip: "Match whole word (Alt+W)";
                                                clicked => { root.toggle-search-match-whole-word(); }
                                            }
                                        }

                                        // Right: Match Count Badge & Steppers
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: end;

                                            // Count badge (only displayed when there is a query typed in the field)
                                            if root.search-query != "": Rectangle {
                                                height: 30px;
                                                background: Theme.card-bg;
                                                border-radius: 15px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                y: (parent.height - self.height) / 2;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    alignment: center;

                                                    Text {
                                                        text: root.search-match-display != "" ? root.search-match-display : (root.is-searching ? "Searching..." : "0 results");
                                                        font-family: "Inter";
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: root.total-search-matches > 0 ? Theme.text-primary : Theme.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/chevron-up.svg");
                                                enabled: root.total-search-matches > 0;
                                                size: 30px;
                                                icon-size: 18px;
                                                border-radius: 8px;
                                                y: (parent.height - self.height) / 2;
                                                tooltip: "Previous match (Shift+Enter)";
                                                clicked => { root.search-prev(); }
                                            }

                                            IconButton {
                                                icon: @image-url("../assets/icons/chevron-down.svg");
                                                enabled: root.total-search-matches > 0;
                                                size: 30px;
                                                icon-size: 18px;
                                                border-radius: 8px;
                                                y: (parent.height - self.height) / 2;
                                                tooltip: "Next match (Enter)";
                                                clicked => { root.search-next(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Search Results List
                            if root.search-results.length == 0: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 24px;

                                    Text {
                                        text: root.is-searching ? "Searching..." : (root.search-query != "" ? "No Matches Found" : "Search in Document");
                                        font-family: "Inter";
                                        font-size: 17px;
                                        font-weight: 600;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.is-searching ? "Scanning pages for matches..." : (root.search-query != "" ? "No matches found for \"" + root.search-query + "\"" : "Enter a word or phrase to find matches across all pages.");
                                        font-family: "Inter";
                                        font-size: 14px;
                                        color: Theme.text-muted;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.search-results.length > 0: ListView {
                                vertical-stretch: 1;

                                for item in root.search-results: s-card := Rectangle {
                                    height: 74px;
                                    width: parent.width;
                                    background: transparent;

                                    inner-s-card := Rectangle {
                                        x: 8px;
                                        y: 3px;
                                        width: parent.width - 16px;
                                        height: parent.height - 6px;
                                        border-radius: 10px;
                                        background: item.is-active ? Theme.hover-bg : s-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                                        border-width: 1px;
                                        border-color: item.is-active ? Theme.accent : s-ta.has-hover ? Theme.border : Theme.border-subtle;
                                        animate background { duration: 80ms; }

                                        s-ta := TouchArea {
                                            clicked => {
                                                root.select-search-result(item.id);
                                            }
                                            mouse-cursor: pointer;
                                        }

                                        VerticalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            alignment: center;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: space-between;

                                                Rectangle {
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: item.is-active ? Theme.accent : Theme.card-bg;
                                                    border-width: 1px;
                                                    border-color: item.is-active ? Theme.accent-border : Theme.border-subtle;

                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        alignment: center;

                                                        Text {
                                                            text: "Page \{item.display-page}";
                                                            font-family: "Inter";
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: item.is-active ? Theme.on-accent : Theme.text-secondary;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                if item.is-active: Text {
                                                    text: "● Current";
                                                    font-family: "Inter";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: Theme.accent;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: item.snippet;
                                                font-family: "Inter";
                                                font-size: 13px;
                                                font-weight: 500;
                                                color: Theme.text-primary;
                                                overflow: elide;
                                                max-width: root.sidebar-width - 48px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Sidebar Splitter / Drag Resize Handle
                if root.show-sidebar && !root.is-zen-mode && !root.has-error: sidebar-splitter := Rectangle {
                    width: 5px;
                    background: (splitter-ta.has-hover || root.is-sidebar-resizing) ? Theme.accent : transparent;
                    animate background { duration: 100ms; }

                    if !(splitter-ta.has-hover || root.is-sidebar-resizing): Rectangle {
                        width: 1px;
                        height: 100%;
                        background: Theme.border;
                        x: 0;
                    }

                    splitter-ta := TouchArea {
                        mouse-cursor: col-resize;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {
                                    root.is-sidebar-resizing = true;
                                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                    root.is-sidebar-resizing = false;
                                    root.save-sidebar-width(root.sidebar-width);
                                }
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.is-sidebar-resizing = true;
                                root.sidebar-width = max(240px, min(min(root.width - 250px, 750px), root.sidebar-width + self.mouse-x - self.pressed-x));
                            }
                        }
                    }
                }

                // Document Viewport / Error Area
                doc-viewport := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.dark
                        ? (root.paper-theme == 1 ? #22201B : Theme.canvas-bg)
                        : (root.paper-theme == 1 ? #EFE9D9 : root.paper-theme == 2 ? #22231C : Theme.canvas-bg);
                    clip: true;

                    if root.has-error: Rectangle {
                        width: 100%;
                        height: 100%;

                        ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                width: doc-viewport.width;
                                min-height: doc-viewport.height;
                                alignment: center;
                                padding-top: 36px;
                                padding-bottom: 36px;
                                padding-left: 24px;
                                padding-right: 24px;

                                HorizontalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: min(720px, doc-viewport.width - 64px);
                                        background: Theme.card-bg;
                                        border-radius: 20px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        drop-shadow-blur: 24px;
                                        drop-shadow-color: Theme.dark ? #00000090 : #00000015;

                                        VerticalLayout {
                                            padding: 24px;
                                            spacing: 20px;

                                            // Top Banner
                                            HorizontalLayout {
                                                alignment: space-between;

                                                HorizontalLayout {
                                                    spacing: 14px;
                                                    alignment: start;

                                                    Image {
                                                        source: @image-url("../assets/icons/folio-icon-dark.svg");
                                                        width: 44px;
                                                        height: 44px;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    VerticalLayout {
                                                        spacing: 2px;
                                                        alignment: center;

                                                        Text {
                                                            text: "Folio";
                                                            font-family: "Inter";
                                                            font-size: 20px;
                                                            font-weight: 700;
                                                            color: Theme.text-primary;
                                                        }

                                                        if root.error-message != "": Text {
                                                            text: root.error-message;
                                                            font-family: "Inter";
                                                            font-size: 12px;
                                                            color: #ef4444;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }

                                                SignaturePillButton {
                                                    icon: @image-url("../assets/icons/folder-open.svg");
                                                    text: "Open PDF";
                                                    tooltip: "Open PDF file (Ctrl+O)";
                                                    y: (parent.height - self.height) / 2;
                                                    clicked => { root.open-document(); }
                                                }
                                            }

                                            // Recent Documents List (No feature cards)
                                            VerticalLayout {
                                                spacing: 12px;

                                                HorizontalLayout {
                                                    alignment: space-between;

                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        alignment: start;

                                                        Image {
                                                            source: @image-url("../assets/icons/clock.svg");
                                                            width: 14px;
                                                            height: 14px;
                                                            colorize: Theme.text-secondary;
                                                            y: (parent.height - self.height) / 2;
                                                        }

                                                        Text {
                                                            text: "RECENT DOCUMENTS";
                                                            font-family: "Inter";
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: Theme.text-secondary;
                                                            vertical-alignment: center;
                                                            letter-spacing: 0.5px;
                                                        }
                                                    }

                                                    if root.recent-books.length > 0: Text {
                                                        text: "\{root.recent-books.length} files";
                                                        font-family: "Inter";
                                                        font-size: 12px;
                                                        color: Theme.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                if root.recent-books.length > 0: Rectangle {
                                                    background: Theme.card-elevated;
                                                    border-radius: 14px;
                                                    border-width: 1px;
                                                    border-color: Theme.border;
                                                    clip: true;

                                                    VerticalLayout {
                                                        padding: 6px;
                                                        spacing: 2px;

                                                        // Clean Table Subheader
                                                        Rectangle {
                                                            height: 28px;
                                                            background: transparent;

                                                            HorizontalLayout {
                                                                padding-left: 14px;
                                                                padding-right: 14px;
                                                                alignment: space-between;

                                                                Text {
                                                                    text: "DOCUMENT";
                                                                    font-family: "Inter";
                                                                    font-size: 10px;
                                                                    font-weight: 700;
                                                                    color: Theme.text-muted;
                                                                    vertical-alignment: center;
                                                                    letter-spacing: 0.6px;
                                                                }

                                                                Text {
                                                                    text: "STATUS / PROGRESS";
                                                                    font-family: "Inter";
                                                                    font-size: 10px;
                                                                    font-weight: 700;
                                                                    color: Theme.text-muted;
                                                                    vertical-alignment: center;
                                                                    letter-spacing: 0.6px;
                                                                }
                                                            }
                                                        }

                                                        for item in root.recent-books : Rectangle {
                                                            height: 48px;
                                                            border-radius: 10px;
                                                            background: welcome-rec-ta.has-hover ? Theme.hover-bg : transparent;
                                                            border-width: welcome-rec-ta.has-hover ? 1px : 0px;
                                                            border-color: Theme.border-subtle;
                                                            animate background { duration: 80ms; }

                                                            HorizontalLayout {
                                                                padding-left: 12px;
                                                                padding-right: 12px;
                                                                spacing: 12px;
                                                                alignment: space-between;

                                                                HorizontalLayout {
                                                                    spacing: 12px;
                                                                    alignment: start;
                                                                    horizontal-stretch: 1;

                                                                    Rectangle {
                                                                        width: 32px;
                                                                        height: 32px;
                                                                        border-radius: 10px;
                                                                        background: Theme.surface-subtle;
                                                                        y: (parent.height - self.height) / 2;

                                                                        Image {
                                                                            source: @image-url("../assets/icons/file-text.svg");
                                                                            width: 16px;
                                                                            height: 16px;
                                                                            colorize: welcome-rec-ta.has-hover ? Theme.accent : Theme.text-secondary;
                                                                            x: (parent.width - self.width) / 2;
                                                                            y: (parent.height - self.height) / 2;
                                                                        }
                                                                    }

                                                                    VerticalLayout {
                                                                        alignment: center;
                                                                        spacing: 2px;
                                                                        horizontal-stretch: 1;

                                                                        Text {
                                                                            text: item.filename;
                                                                            font-family: "Inter";
                                                                            font-size: 13px;
                                                                            font-weight: 600;
                                                                            color: Theme.text-primary;
                                                                            overflow: elide;
                                                                        }

                                                                        Text {
                                                                            text: item.path;
                                                                            font-family: "Inter";
                                                                            font-size: 11px;
                                                                            color: Theme.text-muted;
                                                                            overflow: elide;
                                                                        }
                                                                    }
                                                                }

                                                                HorizontalLayout {
                                                                    spacing: 10px;
                                                                    alignment: end;

                                                                    Rectangle {
                                                                        height: 24px;
                                                                        border-radius: 12px;
                                                                        background: Theme.surface-subtle;
                                                                        border-width: 1px;
                                                                        border-color: Theme.border-subtle;
                                                                        y: (parent.height - self.height) / 2;

                                                                        HorizontalLayout {
                                                                            padding-left: 10px;
                                                                            padding-right: 10px;
                                                                            alignment: center;

                                                                            Text {
                                                                                text: "Page \{item.page}";
                                                                                font-family: "Inter";
                                                                                font-size: 11px;
                                                                                font-weight: 600;
                                                                                color: Theme.text-secondary;
                                                                                vertical-alignment: center;
                                                                            }
                                                                        }
                                                                    }

                                                                    Rectangle {
                                                                        width: 28px;
                                                                        height: 28px;
                                                                        border-radius: 14px;
                                                                        background: welcome-rec-ta.has-hover ? Theme.accent : transparent;
                                                                        y: (parent.height - self.height) / 2;

                                                                        Image {
                                                                            source: @image-url("../assets/icons/chevron-right.svg");
                                                                            width: 14px;
                                                                            height: 14px;
                                                                            colorize: welcome-rec-ta.has-hover ? Theme.on-accent : Theme.text-muted;
                                                                            x: (parent.width - self.width) / 2;
                                                                            y: (parent.height - self.height) / 2;
                                                                        }
                                                                    }
                                                                }
                                                            }

                                                            welcome-rec-ta := TouchArea {
                                                                clicked => {
                                                                    root.open-recent-book(item.path);
                                                                }
                                                                mouse-cursor: pointer;
                                                            }
                                                        }
                                                    }
                                                }

                                                if root.recent-books.length == 0: Rectangle {
                                                    height: 120px;
                                                    background: Theme.card-elevated;
                                                    border-radius: 14px;
                                                    border-width: 1px;
                                                    border-color: Theme.border;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: 6px;

                                                        Text {
                                                            text: "No recent documents";
                                                            font-family: "Inter";
                                                            font-size: 14px;
                                                            font-weight: 600;
                                                            color: Theme.text-primary;
                                                            horizontal-alignment: center;
                                                        }

                                                        Text {
                                                            text: "Open a PDF to start reading";
                                                            font-family: "Inter";
                                                            font-size: 12px;
                                                            color: Theme.text-muted;
                                                            horizontal-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Single Page / Dual Page View
                    if !root.has-error && !root.is-scroll-view: view-scroll := Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: max(parent.width, (root.is-dual-page && root.has-secondary-page) ? (root.page-width + root.secondary-page-width + 88px) : (root.page-width + 64px));
                        content-height: max(parent.height, (root.is-dual-page && root.has-secondary-page) ? (max(root.page-height, root.secondary-page-height) + 64px) : (root.page-height + 64px));

                        viewport-touch := TouchArea {
                            width: view-scroll.content-width;
                            height: view-scroll.content-height;

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.move) {
                                    root.hovered-annotation-id = -1;
                                    keyboard-handler.focus();
                                } else if (event.kind == PointerEventKind.down) {
                                    keyboard-handler.focus();
                                }
                            }

                            scroll-event(event) => {
                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                    if (event.delta-y > 0) {
                                        root.zoom-in();
                                        return accept;
                                    } else if (event.delta-y < 0) {
                                        root.zoom-out();
                                        return accept;
                                    }
                                }
                                return reject;
                            }

                            // Page Card with soft shadow and rounded corners
                            page-card := Rectangle {
                                x: (root.is-dual-page && root.has-secondary-page)
                                    ? max(32px, (view-scroll.content-width - (root.page-width + root.secondary-page-width + 24px)) / 2)
                                    : max(32px, (view-scroll.content-width - self.width) / 2);
                                y: max(32px, (view-scroll.content-height - self.height) / 2);
                                width: root.page-width;
                                height: root.page-height;
                                background: root.paper-theme == 1 ? #F4ECD8 : root.paper-theme == 2 ? #18181A : #ffffff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.paper-theme == 2 ? #2B2D24 : root.paper-theme == 1 ? #DCD4BC : Theme.border;
                                drop-shadow-blur: root.paper-theme == 2 ? 24px : 20px;
                                drop-shadow-offset-y: 6px;
                                drop-shadow-color: root.paper-theme == 2 ? #00000090 : Theme.dark ? #00000060 : #0000001a;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: root.page-image;
                                    opacity: root.page-opacity;
                                    animate opacity {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }
                                }

                                // Interactive Text Selection Highlights directly on actual text
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        if sel-r.page == root.current-page: Rectangle {
                                            x: sel-r.x;
                                            y: sel-r.y;
                                            width: sel-r.width;
                                            height: sel-r.height;
                                            background: #3b82f640;
                                            border-radius: 2px;
                                        }
                                    }
                                }

                                // Search Match Highlights on Document Paper (Single Page View)
                                if root.show-search: Rectangle {
                                    for hl in root.page-search-highlights: Rectangle {
                                        x: hl.x;
                                        y: hl.y;
                                        width: hl.width;
                                        height: hl.height;
                                        background: hl.is-current ? #f59e0b35 : #fde04730;
                                        border-radius: 2px;
                                        border-width: hl.is-current ? 1.5px : 0px;
                                        border-color: hl.is-current ? #ea580c : transparent;
                                    }
                                }

                                // TouchArea for dragging text selection
                                page-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;

                                    scroll-event(event) => {
                                        if (event.modifiers.control || root.is-ctrl-pressed) {
                                            if (event.delta-y > 0) {
                                                root.zoom-in();
                                                return accept;
                                            } else if (event.delta-y < 0) {
                                                root.zoom-out();
                                                return accept;
                                            }
                                        }
                                        return reject;
                                    }

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move) {
                                            root.hovered-annotation-id = -1;
                                            keyboard-handler.focus();
                                        } else if (event.button == PointerEventButton.left) {
                                            if (event.kind == PointerEventKind.down) {
                                                keyboard-handler.focus();
                                                root.selected-annotation-id = -1;
                                                root.selected-annotation-kind = "";
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-started(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                            } else if (event.kind == PointerEventKind.up) {
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-completed(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                            }
                                        }
                                    }

                                    moved => {
                                        if (page-ta.pressed) {
                                            root.selection-dragged(root.current-page, page-ta.mouse-x, page-ta.mouse-y);
                                        }
                                    }
                                }

                                // Embedded Document Links (Table of Contents, internal jumps, external URLs)
                                for link in root.page-links: Rectangle {
                                    if link.page == root.current-page: Rectangle {
                                        x: link.x;
                                        y: link.y;
                                        width: link.width;
                                        height: link.height;
                                        background: link-ta.has-hover ? #3b82f618 : transparent;
                                        border-radius: 2px;
                                        border-width: link-ta.has-hover ? 1px : 0px;
                                        border-color: link-ta.has-hover ? #3b82f640 : transparent;

                                        link-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = -1;
                                                    keyboard-handler.focus();
                                                } else if (event.button == PointerEventButton.left) {
                                                    if (event.kind == PointerEventKind.down) {
                                                        keyboard-handler.focus();
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.selection-started(root.current-page, link.x + link-ta.mouse-x, link.y + link-ta.mouse-y);
                                                    } else if (event.kind == PointerEventKind.up) {
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.selection-completed(root.current-page, link.x + link-ta.mouse-x, link.y + link-ta.mouse-y);
                                                    }
                                                }
                                            }

                                            moved => {
                                                if (link-ta.pressed) {
                                                    root.selection-dragged(root.current-page, link.x + link-ta.mouse-x, link.y + link-ta.mouse-y);
                                                }
                                            }

                                            clicked => {
                                                if (link.target-page >= 0) {
                                                    root.jump-to-page(link.target-page);
                                                } else if (link.uri != "") {
                                                    root.open-external-url(link.uri);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Render Page Annotations on top of page-ta so hover and click are intercepted
                                for annot in root.page-annotations: Rectangle {
                                    if annot.page == root.current-page: Rectangle {
                                        x: annot.x;
                                        y: annot.y;
                                        width: annot.w;
                                        height: annot.h;

                                        // Selection visual recognition feedback rectangle (clean, non-obscuring)
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.selected-annotation-id == annot.id ? #3b82f618 : transparent;
                                            border-width: root.selected-annotation-id == annot.id ? 1px : 0px;
                                            border-color: root.selected-annotation-id == annot.id ? #3b82f680 : transparent;
                                        }

                                        // Underline (anchored with breathing space below character baseline, scaling with zoom)
                                        if annot.kind == "underline": Rectangle {
                                            y: parent.height * 0.88;
                                            width: 100%;
                                            height: max(1.2px, root.zoom-level * 1.35px);
                                            background: annot.color;
                                        }

                                        // Strikethrough (centered directly through lowercase x-height, scaling with zoom)
                                        if annot.kind == "strikethrough": Rectangle {
                                            y: parent.height * 0.52;
                                            width: 100%;
                                            height: max(1.0px, root.zoom-level * 1.0px);
                                            background: annot.color;
                                        }

                                        // Margin Gutter Note Pin: positioned in the right page margin so text is never covered
                                        if annot.show-note-icon: margin-pin := Rectangle {
                                            x: root.page-width - annot.x - 28px;
                                            y: (parent.height - self.height) / 2;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 6px;
                                            background: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? annot.color : annot.color.darker(0.15);
                                            border-width: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? 2px : 1px;
                                            border-color: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta.has-hover) ? #ffffff : #ffffff50;
                                            drop-shadow-blur: (root.hovered-annotation-id == annot.id || pin-ta.has-hover) ? 6px : 3px;
                                            drop-shadow-color: #00000080;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Image {
                                                source: @image-url("../assets/icons/message-square.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: #ffffff;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            pin-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                scroll-event(event) => {
                                                    if (event.modifiers.control || root.is-ctrl-pressed) {
                                                        if (event.delta-y > 0) {
                                                            root.zoom-in();
                                                            return accept;
                                                        } else if (event.delta-y < 0) {
                                                            root.zoom-out();
                                                            return accept;
                                                        }
                                                    }
                                                    return reject;
                                                }
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.move) {
                                                        root.hovered-annotation-id = annot.id;
                                                        keyboard-handler.focus();
                                                    }
                                                }
                                                clicked => {
                                                    keyboard-handler.focus();
                                                    root.popup-page = root.current-page;
                                                    root.selected-annotation-id = annot.id;
                                                    root.selected-annotation-kind = annot.kind;
                                                    root.selected-color-index = annot.color-index;
                                                    root.has-selection = false;
                                                    root.current-note-text = annot.comment;
                                                    root.show-note-input = true;
                                                    let p_width = max(root.note-input-width + 16px, 320px);
                                                    let p_height = root.note-input-height + 66px;
                                                    root.popup-x = round(max(8px, min(root.page-width - p_width - 8px, root.page-width - p_width - 16px)) / 1px) * 1px;
                                                    root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                    root.show-popup = true;
                                                }
                                            }
                                        }

                                        annot-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = annot.id;
                                                    keyboard-handler.focus();
                                                }
                                            }

                                            clicked => {
                                                keyboard-handler.focus();
                                                root.popup-page = root.current-page;
                                                root.selected-annotation-id = annot.id;
                                                root.selected-annotation-kind = annot.kind;
                                                root.selected-color-index = annot.color-index;
                                                root.has-selection = false;
                                                root.current-note-text = annot.comment;
                                                root.show-note-input = annot.comment != "" || annot.kind == "note";
                                                let p_width = root.show-note-input ? max(root.note-input-width + 16px, 320px) : 256px;
                                                let p_height = root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                                root.popup-x = round(max(8px, min(root.page-width - p_width - 8px, annot.x + (annot.w - p_width) / 2)) / 1px) * 1px;
                                                root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                root.show-popup = true;
                                            }
                                        }
                                    }
                                }

                                // Floating Annotation Icon Popup
                                if root.show-popup && root.popup-page == root.current-page: popup := Rectangle {
                                    x: round(root.popup-x / 1px) * 1px;
                                    y: round(root.popup-y / 1px) * 1px;
                                    width: root.show-note-input ? max(root.note-input-width + 16px, 350px) : (root.selected-annotation-id > 0 ? 310px : 350px);
                                    height: root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                    border-radius: 14px;
                                    background: Theme.card-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-offset-y: 4px;
                                    drop-shadow-color: Theme.dark ? #000000a0 : #00000028;
                                    animate height { duration: 120ms; }
                                    animate width { duration: 120ms; }

                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 5px;
                                        padding-bottom: 7px;
                                        spacing: 5px;

                                        // Drag Grip Handle Bar (allows dragging anywhere on the paper)
                                        Rectangle {
                                            height: 6px;
                                            width: 100%;

                                            Rectangle {
                                                width: 32px;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: drag-ta.has-hover ? Theme.text-secondary : Theme.border-subtle;
                                                x: (parent.width - self.width) / 2;
                                                y: 1px;
                                            }

                                            drag-ta := TouchArea {
                                                mouse-cursor: move;
                                                pointer-event(event) => {
                                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                        root.popup-grab-x = self.mouse-x;
                                                        root.popup-grab-y = self.mouse-y;
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed) {
                                                        let max-w = max(8px, root.page-width - popup.width - 8px);
                                                        let max-h = max(8px, root.page-height - popup.height - 8px);
                                                        root.popup-x = round(max(8px, min(max-w, root.popup-x + self.mouse-x - root.popup-grab-x)) / 1px) * 1px;
                                                        root.popup-y = round(max(8px, min(max-h, root.popup-y + self.mouse-y - root.popup-grab-y)) / 1px) * 1px;
                                                    }
                                                }
                                            }
                                        }

                                        // UPDATE MODE: When existing annotation recognized
                                        if root.selected-annotation-id > 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Actions
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                IconButton {
                                                    icon: @image-url("../assets/icons/copy.svg");
                                                    size: 28px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Copy text (Ctrl+C)";
                                                    tooltip-position: "top";
                                                    clicked => { root.copy-selection(); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/message-square.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: root.show-note-input;
                                                    accent-active: true;
                                                    tooltip: "Edit note (N)";
                                                    tooltip-position: "top";
                                                    clicked => { root.show-note-input = !root.show-note-input; }
                                                }

                                                // Done Button (active when note input is open)
                                                if root.show-note-input: IconButton {
                                                    icon: @image-url("../assets/icons/check.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: true;
                                                    accent-active: true;
                                                    tooltip: "Save note";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        root.update-annotation-note(root.selected-annotation-id, root.current-note-text);
                                                        root.show-popup = false;
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                    }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/trash.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Delete annotation";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        root.delete-annotation(root.selected-annotation-id);
                                                        root.show-popup = false;
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                        root.hovered-annotation-id = -1;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-yellow : Theme.annot-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 0;
                                                                root.update-annotation-color(root.selected-annotation-id, 0);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-green : Theme.annot-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 1;
                                                                root.update-annotation-color(root.selected-annotation-id, 1);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-blue : Theme.annot-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 2;
                                                                root.update-annotation-color(root.selected-annotation-id, 2);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-pink : Theme.annot-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 3;
                                                                root.update-annotation-color(root.selected-annotation-id, 3);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-orange : Theme.annot-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 4;
                                                                root.update-annotation-color(root.selected-annotation-id, 4);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-purple : Theme.annot-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 5;
                                                                root.update-annotation-color(root.selected-annotation-id, 5);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Button
                                                IconButton {
                                                    icon: @image-url("../assets/icons/x.svg");
                                                    size: 26px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Close";
                                                    tooltip-position: "top";
                                                    tooltip-align: "right";
                                                    clicked => {
                                                        root.show-popup = false;
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                    }
                                                }
                                            }
                                        }

                                        // CREATE MODE: When text selection is active
                                        if root.selected-annotation-id <= 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Action Icons + Done Button (if note active)
                                            HorizontalLayout {
                                                spacing: 3px;
                                                alignment: start;

                                                IconButton {
                                                    icon: @image-url("../assets/icons/copy.svg");
                                                    size: 28px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Copy text (Ctrl+C)";
                                                    tooltip-position: "top";
                                                    clicked => { root.copy-selection(); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/highlighter.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Highlight (H)";
                                                    tooltip-position: "top";
                                                    clicked => { root.create-annotation("highlight", root.selected-color-index); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/underline.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Underline (U)";
                                                    tooltip-position: "top";
                                                    clicked => { root.create-annotation("underline", root.selected-color-index); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/strikethrough.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Strikethrough (Ctrl+Alt+S)";
                                                    tooltip-position: "top";
                                                    clicked => { root.create-annotation("strikethrough", root.selected-color-index); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/message-square.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: root.show-note-input;
                                                    accent-active: true;
                                                    tooltip: "Add note (N)";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        if (!root.show-note-input) {
                                                            root.current-note-text = "";
                                                        }
                                                        root.show-note-input = !root.show-note-input;
                                                    }
                                                }

                                                // Done Button between Note and X (active when note input is open)
                                                if root.show-note-input: IconButton {
                                                    icon: @image-url("../assets/icons/check.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: true;
                                                    accent-active: true;
                                                    tooltip: "Save note";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        root.create-note-annotation(root.current-note-text, root.selected-color-index);
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 0; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 1; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 2; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 3; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 4; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 5; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Icon
                                                IconButton {
                                                    icon: @image-url("../assets/icons/x.svg");
                                                    size: 26px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Dismiss";
                                                    tooltip-position: "top";
                                                    tooltip-align: "right";
                                                    clicked => { root.clear-selection(); }
                                                }
                                            }
                                        }

                                        // Bottom Row: Inline Note Input Box (Resizable, full width of popover)
                                        if root.show-note-input: HorizontalLayout {
                                            alignment: center;

                                            // Resizable Note Input Box
                                            Rectangle {
                                                width: root.note-input-width;
                                                height: root.note-input-height;
                                                border-radius: 8px;
                                                background: Theme.surface-subtle;
                                                border-width: 1px;
                                                border-color: Theme.border;

                                                if root.current-note-text == "": Text {
                                                    x: 10px;
                                                    y: 8px;
                                                    text: root.selected-annotation-id > 0 ? "Add note to annotation..." : "Write a note...";
                                                    font-family: "Inter";
                                                    font-size: 13px;
                                                    color: Theme.text-muted;
                                                }

                                                ScrollView {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width;
                                                    height: parent.height - 12px;

                                                    VerticalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 14px;
                                                        padding-top: 8px;
                                                        padding-bottom: 8px;

                                                        note-input := TextInput {
                                                            init => { self.focus(); }
                                                            text <=> root.current-note-text;
                                                            font-family: "Inter";
                                                            font-size: 13px;
                                                            color: Theme.text-primary;
                                                            wrap: word-wrap;
                                                            single-line: false;
                                                            width: 100%;
                                                        }
                                                    }
                                                }

                                                // Resize handle grip in bottom-right corner
                                                Rectangle {
                                                    x: parent.width - 16px;
                                                    y: parent.height - 16px;
                                                    width: 16px;
                                                    height: 16px;

                                                    Image {
                                                        source: @image-url("../assets/icons/maximize-2.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: Theme.text-muted;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    resize-ta := TouchArea {
                                                        mouse-cursor: nwse-resize;
                                                        moved => {
                                                            if (self.pressed) {
                                                                root.note-input-width = max(300px, min(560px, root.note-input-width + self.mouse-x - self.pressed-x));
                                                                root.note-input-height = max(50px, min(360px, root.note-input-height + self.mouse-y - self.pressed-y));
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Secondary Page Card for Dual Page Spread
                            if root.is-dual-page && root.has-secondary-page: secondary-page-card := Rectangle {
                                x: page-card.x + page-card.width + 24px;
                                y: max(32px, (view-scroll.content-height - self.height) / 2);
                                width: root.secondary-page-width;
                                height: root.secondary-page-height;
                                background: root.paper-theme == 1 ? #F4ECD8 : root.paper-theme == 2 ? #18181A : #ffffff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.paper-theme == 2 ? #2B2D24 : root.paper-theme == 1 ? #DCD4BC : Theme.border;
                                drop-shadow-blur: root.paper-theme == 2 ? 24px : 20px;
                                drop-shadow-offset-y: 6px;
                                drop-shadow-color: root.paper-theme == 2 ? #00000090 : Theme.dark ? #00000060 : #0000001a;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: root.secondary-page-image;
                                    opacity: root.page-opacity;
                                    animate opacity {
                                        duration: 160ms;
                                        easing: ease-out;
                                    }
                                }

                                // Interactive Text Selection Highlights on Secondary Page
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        if sel-r.page == root.secondary-page: Rectangle {
                                            x: sel-r.x;
                                            y: sel-r.y;
                                            width: sel-r.width;
                                            height: sel-r.height;
                                            background: #3b82f640;
                                            border-radius: 2px;
                                        }
                                    }
                                }

                                // Embedded Document Links on Secondary Page
                                for link in root.page-links: Rectangle {
                                    if link.page == root.secondary-page: Rectangle {
                                        x: link.x;
                                        y: link.y;
                                        width: link.width;
                                        height: link.height;
                                        background: link-sec-ta.has-hover ? #3b82f618 : transparent;
                                        border-radius: 2px;
                                        border-width: link-sec-ta.has-hover ? 1px : 0px;
                                        border-color: link-sec-ta.has-hover ? #3b82f640 : transparent;

                                        link-sec-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            clicked => {
                                                if (link.target-page >= 0) {
                                                    root.jump-to-page(link.target-page);
                                                } else if (link.uri != "") {
                                                    root.open-external-url(link.uri);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Continuous Scroll View
                    if !root.has-error && root.is-scroll-view: scroll-view := ScrollView {
                        width: 100%;
                        height: 100%;
                        content-y <=> root.scroll-content-y;
                        content-height: root.total-scroll-height;
                        content-width: max(parent.width, root.page-width + 64px);

                        scroll-bg-ta := TouchArea {
                            width: scroll-view.content-width;
                            height: max(scroll-view.content-height, parent.height);

                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.move) {
                                    root.hovered-annotation-id = -1;
                                    keyboard-handler.focus();
                                } else if (event.kind == PointerEventKind.down) {
                                    keyboard-handler.focus();
                                }
                            }

                            scroll-event(event) => {
                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                    if (event.delta-y > 0) {
                                        root.zoom-in();
                                        return accept;
                                    } else if (event.delta-y < 0) {
                                        root.zoom-out();
                                        return accept;
                                    }
                                }
                                return reject;
                            }
                        }

                        for page-item in root.scroll-pages: Rectangle {
                            y: page-item.offset-y;
                            width: scroll-view.content-width;
                            height: page-item.height + 24px;

                            margin-ta := TouchArea {
                                width: 100%;
                                height: 100%;

                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.move) {
                                        root.hovered-annotation-id = -1;
                                        keyboard-handler.focus();
                                    } else if (event.kind == PointerEventKind.down) {
                                        keyboard-handler.focus();
                                    }
                                }

                                scroll-event(event) => {
                                    if (event.modifiers.control || root.is-ctrl-pressed) {
                                        if (event.delta-y > 0) {
                                            root.zoom-in();
                                            return accept;
                                        } else if (event.delta-y < 0) {
                                            root.zoom-out();
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }

                            page-card-scroll := Rectangle {
                                x: max(32px, (parent.width - self.width) / 2);
                                y: 12px;
                                width: page-item.width;
                                height: page-item.height;
                                background: root.paper-theme == 1 ? #F4ECD8 : root.paper-theme == 2 ? #18181A : #ffffff;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.paper-theme == 2 ? #2B2D24 : root.paper-theme == 1 ? #DCD4BC : Theme.border;
                                drop-shadow-blur: root.paper-theme == 2 ? 24px : 20px;
                                drop-shadow-offset-y: 6px;
                                drop-shadow-color: root.paper-theme == 2 ? #00000090 : Theme.dark ? #00000060 : #0000001a;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: page-item.image;
                                }

                                // Interactive Text Selection Highlights directly on actual text
                                if root.has-selection: Rectangle {
                                    for sel-r in root.selection-rects: Rectangle {
                                        if sel-r.page == page-item.page-index: Rectangle {
                                            x: sel-r.x;
                                            y: sel-r.y;
                                            width: sel-r.width;
                                            height: sel-r.height;
                                            background: #3b82f640;
                                            border-radius: 2px;
                                        }
                                    }
                                }



                                page-scroll-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: text;

                                    scroll-event(event) => {
                                        if (event.modifiers.control || root.is-ctrl-pressed) {
                                            if (event.delta-y > 0) {
                                                root.zoom-in();
                                                return accept;
                                            } else if (event.delta-y < 0) {
                                                root.zoom-out();
                                                return accept;
                                            }
                                        }
                                        return reject;
                                    }

                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.move) {
                                            root.hovered-annotation-id = -1;
                                            keyboard-handler.focus();
                                        } else if (event.button == PointerEventButton.left) {
                                            if (event.kind == PointerEventKind.down) {
                                                keyboard-handler.focus();
                                                root.selected-annotation-id = -1;
                                                root.selected-annotation-kind = "";
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.current-page = page-item.page-index;
                                                root.selection-started(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                            } else if (event.kind == PointerEventKind.up) {
                                                root.current-note-text = "";
                                                root.show-note-input = false;
                                                root.selection-completed(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                            }
                                        }
                                    }

                                    moved => {
                                        if (page-scroll-ta.pressed) {
                                            root.selection-dragged(page-item.page-index, page-scroll-ta.mouse-x, page-scroll-ta.mouse-y);
                                        }
                                    }
                                }

                                // Embedded Document Links in Scroll View
                                for link in root.page-links: Rectangle {
                                    if link.page == page-item.page-index: Rectangle {
                                        x: link.x;
                                        y: link.y;
                                        width: link.width;
                                        height: link.height;
                                        background: link-scroll-ta.has-hover ? #3b82f618 : transparent;
                                        border-radius: 2px;
                                        border-width: link-scroll-ta.has-hover ? 1px : 0px;
                                        border-color: link-scroll-ta.has-hover ? #3b82f640 : transparent;

                                        link-scroll-ta := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = -1;
                                                    keyboard-handler.focus();
                                                } else if (event.button == PointerEventButton.left) {
                                                    if (event.kind == PointerEventKind.down) {
                                                        keyboard-handler.focus();
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.current-page = page-item.page-index;
                                                        root.selection-started(page-item.page-index, link.x + link-scroll-ta.mouse-x, link.y + link-scroll-ta.mouse-y);
                                                    } else if (event.kind == PointerEventKind.up) {
                                                        root.current-note-text = "";
                                                        root.show-note-input = false;
                                                        root.selection-completed(page-item.page-index, link.x + link-scroll-ta.mouse-x, link.y + link-scroll-ta.mouse-y);
                                                    }
                                                }
                                            }

                                            moved => {
                                                if (link-scroll-ta.pressed) {
                                                    root.selection-dragged(page-item.page-index, link.x + link-scroll-ta.mouse-x, link.y + link-scroll-ta.mouse-y);
                                                }
                                            }

                                            clicked => {
                                                if (link.target-page >= 0) {
                                                    root.jump-to-page(link.target-page);
                                                } else if (link.uri != "") {
                                                    root.open-external-url(link.uri);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Render Page Annotations in Scroll View on top of page-scroll-ta
                                for annot in root.page-annotations: Rectangle {
                                    if annot.page == page-item.page-index: Rectangle {
                                        x: annot.x;
                                        y: annot.y;
                                        width: annot.w;
                                        height: annot.h;

                                        // Selection visual recognition feedback rectangle (clean, non-obscuring)
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.selected-annotation-id == annot.id ? #3b82f618 : transparent;
                                            border-width: root.selected-annotation-id == annot.id ? 1px : 0px;
                                            border-color: root.selected-annotation-id == annot.id ? #3b82f680 : transparent;
                                        }

                                        // Underline (anchored with breathing space below character baseline, scaling with zoom)
                                        if annot.kind == "underline": Rectangle {
                                            y: parent.height * 0.88;
                                            width: 100%;
                                            height: max(1.2px, root.zoom-level * 1.35px);
                                            background: annot.color;
                                        }

                                        // Strikethrough (centered directly through lowercase x-height, scaling with zoom)
                                        if annot.kind == "strikethrough": Rectangle {
                                            y: parent.height * 0.52;
                                            width: 100%;
                                            height: max(1.0px, root.zoom-level * 1.0px);
                                            background: annot.color;
                                        }

                                        // Margin Gutter Note Pin in Scroll View
                                        if annot.show-note-icon: margin-pin2 := Rectangle {
                                            x: page-item.width - annot.x - 28px;
                                            y: (parent.height - self.height) / 2;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 6px;
                                            background: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? annot.color : annot.color.darker(0.15);
                                            border-width: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? 2px : 1px;
                                            border-color: (root.hovered-annotation-id == annot.id || root.selected-annotation-id == annot.id || pin-ta2.has-hover) ? #ffffff : #ffffff50;
                                            drop-shadow-blur: (root.hovered-annotation-id == annot.id || pin-ta2.has-hover) ? 6px : 3px;
                                            drop-shadow-color: #00000080;
                                            animate background { duration: 100ms; }
                                            animate border-color { duration: 100ms; }

                                            Image {
                                                source: @image-url("../assets/icons/message-square.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: #ffffff;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            pin-ta2 := TouchArea {
                                                mouse-cursor: pointer;
                                                scroll-event(event) => {
                                                    if (event.modifiers.control || root.is-ctrl-pressed) {
                                                        if (event.delta-y > 0) {
                                                            root.zoom-in();
                                                            return accept;
                                                        } else if (event.delta-y < 0) {
                                                            root.zoom-out();
                                                            return accept;
                                                        }
                                                    }
                                                    return reject;
                                                }
                                                pointer-event(event) => {
                                                    if (event.kind == PointerEventKind.move) {
                                                        root.hovered-annotation-id = annot.id;
                                                        keyboard-handler.focus();
                                                    }
                                                }
                                                clicked => {
                                                    keyboard-handler.focus();
                                                    root.current-page = page-item.page-index;
                                                    root.popup-page = page-item.page-index;
                                                    root.selected-annotation-id = annot.id;
                                                    root.selected-annotation-kind = annot.kind;
                                                    root.selected-color-index = annot.color-index;
                                                    root.has-selection = false;
                                                    root.current-note-text = annot.comment;
                                                    root.show-note-input = true;
                                                    let p_width = max(root.note-input-width + 16px, 320px);
                                                    let p_height = root.note-input-height + 66px;
                                                    root.popup-x = round(max(8px, min(page-item.width - p_width - 8px, page-item.width - p_width - 16px)) / 1px) * 1px;
                                                    root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                    root.show-popup = true;
                                                }
                                            }
                                        }

                                        annot-ta2 := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;

                                            scroll-event(event) => {
                                                if (event.modifiers.control || root.is-ctrl-pressed) {
                                                    if (event.delta-y > 0) {
                                                        root.zoom-in();
                                                        return accept;
                                                    } else if (event.delta-y < 0) {
                                                        root.zoom-out();
                                                        return accept;
                                                    }
                                                }
                                                return reject;
                                            }

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.hovered-annotation-id = annot.id;
                                                    keyboard-handler.focus();
                                                }
                                            }

                                            clicked => {
                                                keyboard-handler.focus();
                                                root.current-page = page-item.page-index;
                                                root.popup-page = page-item.page-index;
                                                root.selected-annotation-id = annot.id;
                                                root.selected-annotation-kind = annot.kind;
                                                root.selected-color-index = annot.color-index;
                                                root.has-selection = false;
                                                root.current-note-text = annot.comment;
                                                root.show-note-input = annot.comment != "" || annot.kind == "note";
                                                let p_width = root.show-note-input ? max(root.note-input-width + 16px, 320px) : 256px;
                                                let p_height = root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                                root.popup-x = round(max(8px, min(page-item.width - p_width - 8px, annot.x + (annot.w - p_width) / 2)) / 1px) * 1px;
                                                root.popup-y = round((annot.y > (p_height + 8px) ? annot.y - (p_height + 4px) : annot.y + annot.h + 8px) / 1px) * 1px;
                                                root.show-popup = true;
                                            }
                                        }
                                    }
                                }

                                // Floating Annotation Icon Popup in Scroll View
                                if root.show-popup && root.popup-page == page-item.page-index: popup2 := Rectangle {
                                    x: round(root.popup-x / 1px) * 1px;
                                    y: round(root.popup-y / 1px) * 1px;
                                    width: root.show-note-input ? max(root.note-input-width + 16px, 350px) : (root.selected-annotation-id > 0 ? 310px : 350px);
                                    height: root.show-note-input ? (root.note-input-height + 66px) : 54px;
                                    border-radius: 14px;
                                    background: Theme.card-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 16px;
                                    drop-shadow-offset-y: 4px;
                                    drop-shadow-color: Theme.dark ? #000000a0 : #00000028;
                                    animate height { duration: 120ms; }
                                    animate width { duration: 120ms; }

                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 5px;
                                        padding-bottom: 7px;
                                        spacing: 5px;

                                        // Drag Grip Handle Bar (allows dragging anywhere on the paper)
                                        Rectangle {
                                            height: 6px;
                                            width: 100%;

                                            Rectangle {
                                                width: 32px;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: drag-ta2.has-hover ? Theme.text-secondary : Theme.border-subtle;
                                                x: (parent.width - self.width) / 2;
                                                y: 1px;
                                            }

                                            drag-ta2 := TouchArea {
                                                mouse-cursor: move;
                                                pointer-event(event) => {
                                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                        root.popup-grab-x = self.mouse-x;
                                                        root.popup-grab-y = self.mouse-y;
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed) {
                                                        let max-w = max(8px, page-item.width - popup2.width - 8px);
                                                        let max-h = max(8px, page-item.height - popup2.height - 8px);
                                                        root.popup-x = round(max(8px, min(max-w, root.popup-x + self.mouse-x - root.popup-grab-x)) / 1px) * 1px;
                                                        root.popup-y = round(max(8px, min(max-h, root.popup-y + self.mouse-y - root.popup-grab-y)) / 1px) * 1px;
                                                    }
                                                }
                                            }
                                        }

                                        // UPDATE MODE: When existing annotation recognized
                                        if root.selected-annotation-id > 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Actions
                                            HorizontalLayout {
                                                spacing: 4px;
                                                alignment: start;

                                                IconButton {
                                                    icon: @image-url("../assets/icons/copy.svg");
                                                    size: 28px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Copy text (Ctrl+C)";
                                                    tooltip-position: "top";
                                                    clicked => { root.copy-selection(); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/message-square.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: root.show-note-input;
                                                    accent-active: true;
                                                    tooltip: "Edit note (N)";
                                                    tooltip-position: "top";
                                                    clicked => { root.show-note-input = !root.show-note-input; }
                                                }

                                                // Done Button (active when note input is open)
                                                if root.show-note-input: IconButton {
                                                    icon: @image-url("../assets/icons/check.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: true;
                                                    accent-active: true;
                                                    tooltip: "Save note";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        root.update-annotation-note(root.selected-annotation-id, root.current-note-text);
                                                        root.show-popup = false;
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                    }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/trash.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Delete annotation";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        root.delete-annotation(root.selected-annotation-id);
                                                        root.show-popup = false;
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                        root.hovered-annotation-id = -1;
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-yellow : Theme.annot-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 0;
                                                                root.update-annotation-color(root.selected-annotation-id, 0);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-green : Theme.annot-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 1;
                                                                root.update-annotation-color(root.selected-annotation-id, 1);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-blue : Theme.annot-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 2;
                                                                root.update-annotation-color(root.selected-annotation-id, 2);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-pink : Theme.annot-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 3;
                                                                root.update-annotation-color(root.selected-annotation-id, 3);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-orange : Theme.annot-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 4;
                                                                root.update-annotation-color(root.selected-annotation-id, 4);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: root.selected-annotation-kind == "highlight" ? Theme.hl-purple : Theme.annot-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => {
                                                                root.selected-color-index = 5;
                                                                root.update-annotation-color(root.selected-annotation-id, 5);
                                                            }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Button
                                                IconButton {
                                                    icon: @image-url("../assets/icons/x.svg");
                                                    size: 26px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Close";
                                                    tooltip-position: "top";
                                                    tooltip-align: "right";
                                                    clicked => {
                                                        root.show-popup = false;
                                                        root.selected-annotation-id = -1;
                                                        root.selected-annotation-kind = "";
                                                    }
                                                }
                                            }
                                        }

                                        // CREATE MODE: When text selection is active
                                        if root.selected-annotation-id <= 0: HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            alignment: space-between;

                                            // Action Icons + Done Button (if note active)
                                            HorizontalLayout {
                                                spacing: 3px;
                                                alignment: start;

                                                IconButton {
                                                    icon: @image-url("../assets/icons/copy.svg");
                                                    size: 28px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Copy text (Ctrl+C)";
                                                    tooltip-position: "top";
                                                    clicked => { root.copy-selection(); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/highlighter.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Highlight (H)";
                                                    tooltip-position: "top";
                                                    clicked => { root.create-annotation("highlight", root.selected-color-index); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/underline.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Underline (U)";
                                                    tooltip-position: "top";
                                                    clicked => { root.create-annotation("underline", root.selected-color-index); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/strikethrough.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    tooltip: "Strikethrough (Ctrl+Alt+S)";
                                                    tooltip-position: "top";
                                                    clicked => { root.create-annotation("strikethrough", root.selected-color-index); }
                                                }

                                                IconButton {
                                                    icon: @image-url("../assets/icons/message-square.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: root.show-note-input;
                                                    accent-active: true;
                                                    tooltip: "Add note (N)";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        if (!root.show-note-input) {
                                                            root.current-note-text = "";
                                                        }
                                                        root.show-note-input = !root.show-note-input;
                                                    }
                                                }

                                                // Done Button between Note and X (active when note input is open)
                                                if root.show-note-input: IconButton {
                                                    icon: @image-url("../assets/icons/check.svg");
                                                    size: 28px;
                                                    icon-size: 18px;
                                                    border-radius: 6px;
                                                    active: true;
                                                    accent-active: true;
                                                    tooltip: "Save note";
                                                    tooltip-position: "top";
                                                    clicked => {
                                                        root.create-note-annotation(root.current-note-text, root.selected-color-index);
                                                    }
                                                }
                                            }

                                            // Divider
                                            Rectangle {
                                                width: 1px;
                                                height: 18px;
                                                background: Theme.border;
                                                y: 5px;
                                            }

                                            // 6 Color Circles + Close Button
                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: end;

                                                // 6 Color Circles
                                                HorizontalLayout {
                                                    spacing: 5px;
                                                    alignment: start;

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-yellow;
                                                        border-width: root.selected-color-index == 0 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 0 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 0; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-green;
                                                        border-width: root.selected-color-index == 1 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 1 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 1; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-blue;
                                                        border-width: root.selected-color-index == 2 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 2 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 2; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-pink;
                                                        border-width: root.selected-color-index == 3 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 3 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 3; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-orange;
                                                        border-width: root.selected-color-index == 4 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 4 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 4; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }

                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 9px;
                                                        background: Theme.hl-purple;
                                                        border-width: root.selected-color-index == 5 ? 2px : 1px;
                                                        border-color: root.selected-color-index == 5 ? #ffffff : #00000040;
                                                        y: 5px;
                                                        TouchArea {
                                                            clicked => { root.selected-color-index = 5; }
                                                            mouse-cursor: pointer;
                                                        }
                                                    }
                                                }

                                                // Close Icon
                                                IconButton {
                                                    icon: @image-url("../assets/icons/x.svg");
                                                    size: 26px;
                                                    icon-size: 17px;
                                                    border-radius: 6px;
                                                    tooltip: "Dismiss";
                                                    tooltip-position: "top";
                                                    tooltip-align: "right";
                                                    clicked => { root.clear-selection(); }
                                                }
                                            }
                                        }

                                        // Bottom Row: Inline Note Input Box (Resizable, full width of popover)
                                        if root.show-note-input: HorizontalLayout {
                                            alignment: center;

                                            // Resizable Note Input Box
                                            Rectangle {
                                                width: root.note-input-width;
                                                height: root.note-input-height;
                                                border-radius: 8px;
                                                background: Theme.surface-subtle;
                                                border-width: 1px;
                                                border-color: Theme.border;

                                                if root.current-note-text == "": Text {
                                                    x: 10px;
                                                    y: 8px;
                                                    text: root.selected-annotation-id > 0 ? "Add note to annotation..." : "Write a note...";
                                                    font-family: "Inter";
                                                    font-size: 13px;
                                                    color: Theme.text-muted;
                                                }

                                                ScrollView {
                                                    x: 0;
                                                    y: 0;
                                                    width: parent.width;
                                                    height: parent.height - 12px;

                                                    VerticalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 14px;
                                                        padding-top: 8px;
                                                        padding-bottom: 8px;

                                                        note-input2 := TextInput {
                                                            init => { self.focus(); }
                                                            text <=> root.current-note-text;
                                                            font-family: "Inter";
                                                            font-size: 13px;
                                                            color: Theme.text-primary;
                                                            wrap: word-wrap;
                                                            single-line: false;
                                                            width: 100%;
                                                        }
                                                    }
                                                }

                                                // Resize handle grip in bottom-right corner
                                                Rectangle {
                                                    x: parent.width - 16px;
                                                    y: parent.height - 16px;
                                                    width: 16px;
                                                    height: 16px;

                                                    Image {
                                                        source: @image-url("../assets/icons/maximize-2.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: Theme.text-muted;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }

                                                    resize-ta2 := TouchArea {
                                                        mouse-cursor: nwse-resize;
                                                        moved => {
                                                            if (self.pressed) {
                                                                root.note-input-width = max(300px, min(560px, root.note-input-width + self.mouse-x - self.pressed-x));
                                                                root.note-input-height = max(50px, min(360px, root.note-input-height + self.mouse-y - self.pressed-y));
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Flattened Search Match Highlights across entire continuous document
                        if root.show-search: Rectangle {
                            width: 100%;
                            height: root.total-scroll-height;

                            for hl in root.scroll-search-highlights: Rectangle {
                                x: max(32px, (parent.width - hl.page-width) / 2) + hl.x;
                                y: hl.y;
                                width: hl.width;
                                height: hl.height;
                                background: hl.is-current ? #f59e0b35 : #fde04730;
                                border-radius: 2px;
                                border-width: hl.is-current ? 1.5px : 0px;
                                border-color: hl.is-current ? #ea580c : transparent;
                            }
                        }
                    }
                }
            }
        }
    }

    // Top Hover Sensor to reveal Zen Controls in Zen Mode
    top-sensor := TouchArea {
        x: (parent.width - 440px) / 2;
        y: 0;
        width: 440px;
        height: root.is-zen-mode ? 60px : 0px;
        enabled: root.is-zen-mode;
    }

    // Floating Zen Mode Controls Bar
    if root.is-zen-mode: Rectangle {
        x: (parent.width - self.width) / 2;
        y: top-sensor.has-hover ? 16px : -54px;
        height: 44px;
        z: 100;
        border-radius: 22px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.dark ? #00000080 : #00000018;
        animate y { duration: 160ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            alignment: center;

            IconButton {
                icon: @image-url("../assets/icons/chevron-left.svg");
                enabled: root.can-prev;
                y: (parent.height - self.height) / 2;
                tooltip: "Previous page (PageUp / ←)";
                clicked => { root.prev-page(); }
            }

            Text {
                text: root.page-display;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            IconButton {
                icon: @image-url("../assets/icons/chevron-right.svg");
                enabled: root.can-next;
                y: (parent.height - self.height) / 2;
                tooltip: "Next page (PageDown / →)";
                clicked => { root.next-page(); }
            }

            Rectangle {
                width: 1px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                background: Theme.border;
            }

            IconButton {
                icon: @image-url("../assets/icons/zoom-out.svg");
                y: (parent.height - self.height) / 2;
                tooltip: "Zoom out (Ctrl+-)";
                clicked => { root.is-fit-width = false; root.zoom-out(); }
            }

            Text {
                text: root.zoom-display;
                font-family: "Inter";
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            IconButton {
                icon: @image-url("../assets/icons/zoom-in.svg");
                y: (parent.height - self.height) / 2;
                tooltip: "Zoom in (Ctrl+=)";
                clicked => { root.is-fit-width = false; root.zoom-in(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/fit-to-page.svg");
                y: (parent.height - self.height) / 2;
                tooltip: "Fit to page (Ctrl+0)";
                clicked => { root.is-fit-width = false; root.zoom-fit(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/fit-to-width.svg");
                active: root.is-fit-width;
                y: (parent.height - self.height) / 2;
                tooltip: "Fit to width (Ctrl+2 / W)";
                clicked => { root.is-fit-width = true; root.zoom-fit-width(); }
            }

            IconButton {
                icon: @image-url("../assets/icons/rotate-cw.svg");
                y: (parent.height - self.height) / 2;
                tooltip: "Rotate clockwise (R)";
                clicked => { root.rotate-clockwise(); }
            }

            Rectangle {
                width: 1px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                background: Theme.border;
            }

            // Exit Zen Button
            Rectangle {
                height: 28px;
                border-radius: 14px;
                y: (parent.height - self.height) / 2;
                background: exit-zen-ta.has-hover ? Theme.hover-bg : transparent;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 5px;
                    alignment: center;

                    Image {
                        source: @image-url("../assets/icons/minimize-2.svg");
                        width: 15px;
                        height: 15px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Exit Zen (F11)";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                exit-zen-ta := TouchArea {
                    clicked => { root.exit-zen-mode(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // Floating Notification Toast
    if root.show-toast: Rectangle {
        width: toast-hl.preferred-width;
        height: 38px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 56px;
        z: 200;
        border-radius: 19px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.accent-border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.dark ? #00000070 : #00000018;

        toast-hl := HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 8px;
            alignment: center;

            Image {
                source: @image-url("../assets/icons/check.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.accent;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.toast-message;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
    }

    // Dismiss overlay for Tab Context Menu
    if root.show-tab-menu: TouchArea {
        width: 100%;
        height: 100%;
        z: 94;
        clicked => {
            root.show-tab-menu = false;
        }
    }

    // Tab Context Menu Popover
    if root.show-tab-menu: Rectangle {
        x: root.tab-menu-x;
        y: root.tab-menu-y;
        width: 200px;
        height: tab-cm-vl.preferred-height;
        z: 105;
        background: Theme.card-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000099 : #00000020;
        clip: true;

        tab-cm-vl := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            // Close Tab
            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: cm-close-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.text-primary;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Close Tab";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                cm-close-ta := TouchArea {
                    clicked => {
                        root.show-tab-menu = false;
                        root.close-tab(root.tab-menu-index);
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Close Other Tabs
            cm-other-row := Rectangle {
                property <bool> is-row-enabled: root.open-tabs.length > 1;
                height: 32px;
                border-radius: 6px;
                background: self.is-row-enabled && cm-other-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 13px;
                        height: 13px;
                        colorize: cm-other-row.is-row-enabled ? Theme.text-secondary : Theme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Close Other Tabs";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 500;
                        color: cm-other-row.is-row-enabled ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                cm-other-ta := TouchArea {
                    clicked => {
                        if (cm-other-row.is-row-enabled) {
                            root.show-tab-menu = false;
                            root.close-other-tabs(root.tab-menu-index);
                        }
                    }
                    mouse-cursor: cm-other-row.is-row-enabled ? pointer : default;
                }
            }

            // Close Tabs to the Right
            cm-right-row := Rectangle {
                property <bool> is-row-enabled: root.tab-menu-index < root.open-tabs.length - 1;
                height: 32px;
                border-radius: 6px;
                background: self.is-row-enabled && cm-right-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Image {
                        source: @image-url("../assets/icons/chevron-right.svg");
                        width: 13px;
                        height: 13px;
                        colorize: cm-right-row.is-row-enabled ? Theme.text-secondary : Theme.text-muted;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Close Tabs to the Right";
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 500;
                        color: cm-right-row.is-row-enabled ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                cm-right-ta := TouchArea {
                    clicked => {
                        if (cm-right-row.is-row-enabled) {
                            root.show-tab-menu = false;
                            root.close-tabs-to-the-right(root.tab-menu-index);
                        }
                    }
                    mouse-cursor: cm-right-row.is-row-enabled ? pointer : default;
                }
            }
        }
    }

    // Dismiss overlay for Recent Books menu
    if root.show-recent-books: TouchArea {
        width: 100%;
        height: 100%;
        z: 90;
        clicked => {
            root.show-recent-books = false;
        }
    }

    // Recent Books Dropdown Popover
    if root.show-recent-books: Rectangle {
        x: 16px;
        y: root.open-tabs.length > 0 ? 100px : 54px;
        width: 320px;
        height: recent-vl.preferred-height;
        z: 100;
        background: Theme.card-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000080 : #00000015;

        recent-vl := VerticalLayout {
            padding: 8px;
            spacing: 4px;
            alignment: start;

            // Header
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: space-between;

                Text {
                    text: "RECENT BOOKS";
                    font-family: "Inter";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            if root.recent-books.length == 0: Rectangle {
                height: 44px;
                Text {
                    text: "No recent books yet";
                    font-family: "Inter";
                    font-size: 13px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for item in root.recent-books: Rectangle {
                height: 38px;
                border-radius: 8px;
                background: item-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/icons/book-open.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: item.filename;
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 210px;
                        }
                    }

                    Text {
                        text: "p. \{item.page}";
                        font-family: "Inter";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                item-ta := TouchArea {
                    clicked => {
                        root.show-recent-books = false;
                        root.open-recent-book(item.path);
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Bottom actions: Document Properties & Open PDF
            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: doc-props-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/icons/info.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-primary;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Document Properties";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Ctrl+D";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                doc-props-ta := TouchArea {
                    clicked => {
                        root.show-recent-books = false;
                        root.show-doc-info = true;
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 38px;
                border-radius: 8px;
                background: open-other-ta.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: 80ms; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/icons/folder-open.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Open other file...";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Ctrl+O";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                open-other-ta := TouchArea {
                    clicked => {
                        root.show-recent-books = false;
                        root.open-document();
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // Backdrop click-to-dismiss for Doc Info Modal
    if root.show-doc-info: TouchArea {
        width: 100%;
        height: 100%;
        z: 190;
        clicked => {
            root.show-doc-info = false;
        }
    }

    // Modal Dim Backdrop
    if root.show-doc-info: Rectangle {
        width: 100%;
        height: 100%;
        z: 195;
        background: Theme.dark ? #000000a6 : #00000045;
        animate background { duration: 140ms; }
    }

    // Document Properties Modal Card
    if root.show-doc-info: Rectangle {
        width: root.width > 600px ? 560px : round((root.width - 32px) / 2px) * 2px;
        height: doc-info-vl.preferred-height;
        x: round((parent.width - self.width) / 2px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px;
        z: 200;
        background: Theme.card-elevated;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dark ? #000000bb : #00000028;

        doc-info-vl := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            alignment: start;

            // Modal Header
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        y: (parent.height - self.height) / 2;

                        Image {
                            source: @image-url("../assets/icons/file-text.svg");
                            width: 20px;
                            height: 20px;
                            colorize: Theme.text-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Document Properties";
                            font-family: "Inter";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: root.doc-info.file-name != "" ? root.doc-info.file-name : "No file loaded";
                            font-family: "Inter";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            overflow: elide;
                            max-width: 380px;
                        }
                    }
                }

                IconButton {
                    icon: @image-url("../assets/icons/x.svg");
                    size: 30px;
                    icon-size: 16px;
                    border-radius: 15px;
                    y: (parent.height - self.height) / 2;
                    tooltip: "Close";
                    tooltip-align: "right";
                    clicked => {
                        root.show-doc-info = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Section 1: File Specs
            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "FILE SPECIFICATIONS";
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    letter-spacing: 0.5px;
                }

                DocPropRow {
                    label: "File Name";
                    value: root.doc-info.file-name != "" ? root.doc-info.file-name : "—";
                    can-copy: true;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "Location";
                    value: root.doc-info.file-path;
                    is-path: true;
                    can-copy: true;
                    copy-value(v) => { root.copy-to-clipboard(v); }
                }

                DocPropRow {
                    label: "File Size";
                    value: root.doc-info.file-size;
                }

                DocPropRow {
                    label: "Modified";
                    value: root.doc-info.mod-date;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Section 2: Metadata
            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "METADATA";
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    letter-spacing: 0.5px;
                }

                DocPropRow {
                    label: "Title";
                    value: root.doc-info.title;
                }

                DocPropRow {
                    label: "Author";
                    value: root.doc-info.author;
                }

                DocPropRow {
                    label: "Subject";
                    value: root.doc-info.subject;
                }

                DocPropRow {
                    label: "Keywords";
                    value: root.doc-info.keywords;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Section 3: PDF Details
            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "PDF SPECIFICATIONS";
                    font-family: "Inter";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    letter-spacing: 0.5px;
                }

                DocPropRow {
                    label: "Page Count";
                    value: root.doc-info.page-count;
                }

                DocPropRow {
                    label: "Page Dimensions";
                    value: root.doc-info.page-size;
                }

                DocPropRow {
                    label: "Format / Version";
                    value: root.doc-info.pdf-version;
                }

                DocPropRow {
                    label: "Security";
                    value: root.doc-info.encryption;
                }

                DocPropRow {
                    label: "Created";
                    value: root.doc-info.creation-date;
                }

                DocPropRow {
                    label: "Producer";
                    value: root.doc-info.producer;
                }

                DocPropRow {
                    label: "Creator";
                    value: root.doc-info.creator;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Modal Footer: Actions
            HorizontalLayout {
                padding-top: 4px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    // Copy File Name Button
                    Rectangle {
                        height: 32px;
                        border-radius: 16px;
                        background: copy-name-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 80ms; }
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/copy.svg");
                                width: 14px;
                                height: 14px;
                                colorize: Theme.text-primary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Copy Name";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        copy-name-ta := TouchArea {
                            clicked => {
                                root.copy-to-clipboard(root.doc-info.file-name);
                            }
                            mouse-cursor: pointer;
                        }
                    }

                    // Copy Path Button
                    Rectangle {
                        height: 32px;
                        border-radius: 16px;
                        background: copy-path-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 80ms; }
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/copy.svg");
                                width: 14px;
                                height: 14px;
                                colorize: Theme.text-primary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Copy Path";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        copy-path-ta := TouchArea {
                            clicked => {
                                root.copy-to-clipboard(root.doc-info.file-path);
                            }
                            mouse-cursor: pointer;
                        }
                    }

                    // Print Document Button
                    Rectangle {
                        height: 32px;
                        border-radius: 16px;
                        background: doc-info-print-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 80ms; }
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/printer.svg");
                                width: 14px;
                                height: 14px;
                                colorize: Theme.text-primary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Print";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        doc-info-print-ta := TouchArea {
                            clicked => {
                                root.show-doc-info = false;
                                root.open-print-dialog();
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }

                // Done Close Button
                Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: done-ta.has-hover ? Theme.cta-hover : Theme.cta-bg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    animate background { duration: 80ms; }
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;

                        Text {
                            text: "Done";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.on-cta;
                            vertical-alignment: center;
                        }
                    }

                    done-ta := TouchArea {
                        clicked => {
                            root.show-doc-info = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Backdrop click-to-dismiss for Shortcuts Modal
    if root.show-shortcuts-modal: TouchArea {
        width: 100%;
        height: 100%;
        z: 190;
        clicked => {
            root.show-shortcuts-modal = false;
        }
    }

    // Modal Dim Backdrop
    if root.show-shortcuts-modal: Rectangle {
        width: 100%;
        height: 100%;
        z: 195;
        background: Theme.dark ? #000000a6 : #00000045;
        animate background { duration: 140ms; }
    }

    // Keyboard Shortcuts Modal Card
    if root.show-shortcuts-modal: Rectangle {
        width: root.width > 700px ? 660px : round((root.width - 32px) / 2px) * 2px;
        height: root.height > 620px ? 560px : round((root.height - 40px) / 2px) * 2px;
        x: round((parent.width - self.width) / 2px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px;
        z: 200;
        background: Theme.card-elevated;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dark ? #000000bb : #00000028;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // Modal Header
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;
                        y: (parent.height - self.height) / 2;

                        Image {
                            source: @image-url("../assets/icons/keyboard.svg");
                            width: 20px;
                            height: 20px;
                            colorize: Theme.text-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Keyboard Shortcuts";
                            font-family: "Inter";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Quick reference for keyboard navigation and tools";
                            font-family: "Inter";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                        }
                    }
                }

                IconButton {
                    icon: @image-url("../assets/icons/x.svg");
                    size: 30px;
                    icon-size: 16px;
                    border-radius: 15px;
                    y: (parent.height - self.height) / 2;
                    tooltip: "Close (Esc)";
                    tooltip-align: "right";
                    clicked => {
                        root.show-shortcuts-modal = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Scrollable Content
            ScrollView {
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 20px;
                    alignment: stretch;
                    padding-right: 8px;

                    // Left Column
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        alignment: start;

                        // General & Application
                        VerticalLayout {
                            spacing: 4px;
                            ShortcutSectionHeader { title: "GENERAL & APPLICATION"; }
                            ShortcutItem { label: "Open Document"; shortcut: "Ctrl + O"; }
                            ShortcutItem { label: "Save Document"; shortcut: "Ctrl + S"; }
                            ShortcutItem { label: "Save As Copy"; shortcut: "Ctrl + Shift + S"; }
                            ShortcutItem { label: "Print Document"; shortcut: "Ctrl + P"; }
                            ShortcutItem { label: "Document Properties"; shortcut: "Ctrl + D"; shortcut-alt: "Ctrl + I"; }
                            ShortcutItem { label: "Toggle Sidebar"; shortcut: "Ctrl + B"; }
                            ShortcutItem { label: "Zen / Fullscreen"; shortcut: "F11"; }
                            ShortcutItem { label: "Keyboard Shortcuts"; shortcut: "Ctrl + /"; shortcut-alt: "F1"; }
                            ShortcutItem { label: "Close / Dismiss"; shortcut: "Esc"; }
                        }

                        // Tabs
                        VerticalLayout {
                            spacing: 4px;
                            ShortcutSectionHeader { title: "TABS"; }
                            ShortcutItem { label: "New Tab"; shortcut: "Ctrl + T"; }
                            ShortcutItem { label: "Close Tab"; shortcut: "Ctrl + W"; }
                            ShortcutItem { label: "Next Tab"; shortcut: "Ctrl + Tab"; shortcut-alt: "Ctrl + PgDn"; }
                            ShortcutItem { label: "Previous Tab"; shortcut: "Ctrl + Shift + Tab"; shortcut-alt: "Ctrl + PgUp"; }
                            ShortcutItem { label: "Select Tab 1-9"; shortcut: "Ctrl + 1..9"; }
                        }

                        // Navigation & Search
                        VerticalLayout {
                            spacing: 4px;
                            ShortcutSectionHeader { title: "NAVIGATION & SEARCH"; }
                            ShortcutItem { label: "Next Page"; shortcut: "↓"; shortcut-alt: "PgDn"; }
                            ShortcutItem { label: "Previous Page"; shortcut: "↑"; shortcut-alt: "PgUp"; }
                            ShortcutItem { label: "Search Text"; shortcut: "Ctrl + F"; }
                            ShortcutItem { label: "Go to Page"; shortcut: "Ctrl + G"; }
                            ShortcutItem { label: "History Back"; shortcut: "Alt + ←"; }
                            ShortcutItem { label: "History Forward"; shortcut: "Alt + →"; }
                        }
                    }

                    // Right Column
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        alignment: start;

                        // View & Display
                        VerticalLayout {
                            spacing: 4px;
                            ShortcutSectionHeader { title: "VIEW & DISPLAY"; }
                            ShortcutItem { label: "Zoom In"; shortcut: "Ctrl + +"; }
                            ShortcutItem { label: "Zoom Out"; shortcut: "Ctrl + -"; }
                            ShortcutItem { label: "Reset Zoom (100%)"; shortcut: "Ctrl + 0"; }
                            ShortcutItem { label: "Fit to Width"; shortcut: "Ctrl + Shift + W"; shortcut-alt: "W"; }
                            ShortcutItem { label: "Fit to Page"; shortcut: "Ctrl + Shift + F"; }
                            ShortcutItem { label: "Continuous Scroll"; shortcut: "Ctrl + M"; }
                            ShortcutItem { label: "Dual Page Spread"; shortcut: "Ctrl + Alt + D"; }
                            ShortcutItem { label: "Cover Page Alone"; shortcut: "Ctrl + Alt + C"; }
                            ShortcutItem { label: "Rotate Clockwise"; shortcut: "Ctrl + R"; }
                            ShortcutItem { label: "Cycle Theme"; shortcut: "T"; shortcut-alt: "P"; }
                        }

                        // Annotations & Editing
                        VerticalLayout {
                            spacing: 4px;
                            ShortcutSectionHeader { title: "ANNOTATIONS & EDITING"; }
                            ShortcutItem { label: "Copy Selection"; shortcut: "Ctrl + C"; }
                            ShortcutItem { label: "Highlight Text"; shortcut: "Ctrl + H"; }
                            ShortcutItem { label: "Underline Text"; shortcut: "Ctrl + U"; }
                            ShortcutItem { label: "Strikethrough"; shortcut: "Ctrl + Alt + S"; }
                            ShortcutItem { label: "Add Sticky Note"; shortcut: "Ctrl + Alt + N"; }
                            ShortcutItem { label: "Color Palette"; shortcut: "1 .. 6"; }
                            ShortcutItem { label: "Delete Annotation"; shortcut: "Del"; shortcut-alt: "Backspace"; }
                            ShortcutItem { label: "Undo"; shortcut: "Ctrl + Z"; }
                            ShortcutItem { label: "Redo"; shortcut: "Ctrl + Y"; shortcut-alt: "Ctrl+Shift+Z"; }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Modal Footer
            HorizontalLayout {
                padding-top: 2px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "Press Esc or Ctrl+/ to close";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                // Done Close Button
                Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: shortcuts-done-ta.has-hover ? Theme.cta-hover : Theme.cta-bg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    animate background { duration: 80ms; }
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: center;

                        Text {
                            text: "Done";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.on-cta;
                            vertical-alignment: center;
                        }
                    }

                    shortcuts-done-ta := TouchArea {
                        clicked => {
                            root.show-shortcuts-modal = false;
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Password Modal Backdrop TouchArea
    if root.show-password-modal: TouchArea {
        width: 100%;
        height: 100%;
        z: 205;
        clicked => { root.cancel-password(); }
    }

    // Password Modal Dim Backdrop
    if root.show-password-modal: Rectangle {
        width: 100%;
        height: 100%;
        z: 210;
        background: Theme.dark ? #000000a6 : #00000045;
        animate background { duration: 140ms; }
    }

    // Password Modal Card
    if root.show-password-modal: Rectangle {
        width: root.width > 500px ? 440px : round((root.width - 32px) / 2px) * 2px;
        height: pwd-modal-vl.preferred-height;
        x: round((parent.width - self.width) / 2px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px;
        z: 215;
        background: Theme.card-elevated;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dark ? #000000bb : #00000028;

        pwd-modal-vl := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            // Header with Lock Icon Badge
            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.accent-subtle;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: @image-url("../assets/icons/lock.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "Password Required";
                        font-family: "Inter";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    Text {
                        text: root.password-file-name != "" ? root.password-file-name : "Encrypted Document";
                        font-family: "Inter";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }
            }

            Text {
                text: "This document is password protected. Enter the password below to decrypt and read it.";
                font-family: "Inter";
                font-size: 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // Password Input Box
            Rectangle {
                height: 42px;
                border-radius: 8px;
                background: Theme.surface-subtle;
                border-width: 1.5px;
                border-color: root.password-error != "" ? #e06c75 : pwd-input-box.has-focus ? Theme.accent : Theme.border;

                pwd-input-box := TextInput {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    text <=> root.password-input;
                    input-type: password;
                    font-family: "Inter";
                    font-size: 14px;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    accepted => {
                        root.submit-password(self.text);
                    }
                }
            }

            if root.password-error != "": Text {
                text: root.password-error;
                font-family: "Inter";
                font-size: 12px;
                font-weight: 600;
                color: #e06c75;
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Cancel Button
                Rectangle {
                    height: 36px;
                    border-radius: 18px;
                    background: cancel-pwd-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 80ms; }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;

                        Text {
                            text: "Cancel";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    cancel-pwd-ta := TouchArea {
                        clicked => { root.cancel-password(); }
                        mouse-cursor: pointer;
                    }
                }

                // Unlock Button
                Rectangle {
                    height: 36px;
                    border-radius: 18px;
                    background: unlock-ta.has-hover ? Theme.cta-hover : Theme.cta-bg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    animate background { duration: 80ms; }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: center;

                        Text {
                            text: "Unlock";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.on-cta;
                            vertical-alignment: center;
                        }
                    }

                    unlock-ta := TouchArea {
                        clicked => { root.submit-password(root.password-input); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Print Modal Backdrop TouchArea
    if root.show-print-modal: TouchArea {
        width: 100%;
        height: 100%;
        z: 205;
        clicked => { root.cancel-print(); }
    }

    // Print Modal Dim Backdrop
    if root.show-print-modal: Rectangle {
        width: 100%;
        height: 100%;
        z: 210;
        background: Theme.dark ? #000000a6 : #00000045;
        animate background { duration: 140ms; }
    }

    // Print Modal Card
    if root.show-print-modal: Rectangle {
        width: root.width > 540px ? 480px : round((root.width - 32px) / 2px) * 2px;
        height: print-modal-vl.preferred-height;
        x: round((parent.width - self.width) / 2px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px;
        z: 215;
        background: Theme.card-elevated;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dark ? #000000bb : #00000028;

        print-modal-vl := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            // Header with Printer Icon Badge
            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.accent-subtle;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: @image-url("../assets/icons/printer.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: "Print Document";
                        font-family: "Inter";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    Text {
                        text: root.file-title != "" ? root.file-title : "Current Document";
                        font-family: "Inter";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Section: Printer Selection
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Printer Destination";
                    font-family: "Inter";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                }

                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: Theme.surface-subtle;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        Text {
                            text: root.selected-printer != "" ? root.selected-printer : "Default System Printer";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }

                        Image {
                            source: @image-url("../assets/icons/chevron-down.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.cycle-printer();
                        }
                        mouse-cursor: pointer;
                    }
                }
            }

            // Section: Pages to Print
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Pages";
                    font-family: "Inter";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                }

                HorizontalLayout {
                    spacing: 8px;

                    // All Pages Pill
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: root.print-page-mode == 0 ? Theme.accent-subtle : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: root.print-page-mode == 0 ? Theme.accent : Theme.border;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            Text {
                                text: "All (" + root.total-pages + ")";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: root.print-page-mode == 0 ? 700 : 500;
                                color: root.print-page-mode == 0 ? Theme.accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.print-page-mode = 0; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Current Page Pill
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: root.print-page-mode == 1 ? Theme.accent-subtle : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: root.print-page-mode == 1 ? Theme.accent : Theme.border;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            Text {
                                text: "Current (" + (root.current-page + 1) + ")";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: root.print-page-mode == 1 ? 700 : 500;
                                color: root.print-page-mode == 1 ? Theme.accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.print-page-mode = 1; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Custom Range Pill
                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: root.print-page-mode == 2 ? Theme.accent-subtle : Theme.surface-subtle;
                        border-width: 1px;
                        border-color: root.print-page-mode == 2 ? Theme.accent : Theme.border;
                        animate background { duration: 80ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            Text {
                                text: "Range";
                                font-family: "Inter";
                                font-size: 12px;
                                font-weight: root.print-page-mode == 2 ? 700 : 500;
                                color: root.print-page-mode == 2 ? Theme.accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.print-page-mode = 2; }
                            mouse-cursor: pointer;
                        }
                    }
                }

                // Custom Range Input Field
                if root.print-page-mode == 2: Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: Theme.surface-subtle;
                    border-width: 1px;
                    border-color: range-input.has-focus ? Theme.accent : Theme.border;

                    range-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text <=> root.print-page-range;
                        font-family: "Inter";
                        font-size: 13px;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }
            }

            // Section: Copies Stepper
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "Copies";
                    font-family: "Inter";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.surface-subtle;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: center;

                        IconButton {
                            icon: @image-url("../assets/icons/chevron-left.svg");
                            size: 26px;
                            icon-size: 14px;
                            border-radius: 13px;
                            enabled: root.print-copies > 1;
                            tooltip: "Decrease copies";
                            clicked => { root.print-copies = Math.max(1, root.print-copies - 1); }
                        }

                        Text {
                            text: root.print-copies;
                            font-family: "Inter";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            min-width: 24px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        IconButton {
                            icon: @image-url("../assets/icons/chevron-right.svg");
                            size: 26px;
                            icon-size: 14px;
                            border-radius: 13px;
                            tooltip: "Increase copies";
                            clicked => { root.print-copies = root.print-copies + 1; }
                        }
                    }
                }
            }

            if root.print-error != "": Text {
                text: root.print-error;
                font-family: "Inter";
                font-size: 12px;
                font-weight: 600;
                color: #e06c75;
                wrap: word-wrap;
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                Rectangle {
                    height: 36px;
                    border-radius: 18px;
                    background: cancel-print-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 80ms; }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;

                        Text {
                            text: "Cancel";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    cancel-print-ta := TouchArea {
                        clicked => { root.cancel-print(); }
                        mouse-cursor: pointer;
                    }
                }

                Rectangle {
                    height: 36px;
                    border-radius: 18px;
                    background: print-submit-ta.has-hover ? Theme.cta-hover : Theme.cta-bg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    animate background { duration: 80ms; }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: center;

                        Text {
                            text: "Print";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.on-cta;
                            vertical-alignment: center;
                        }
                    }

                    print-submit-ta := TouchArea {
                        clicked => {
                            root.request-print(root.selected-printer, root.print-page-mode, root.print-page-range, root.print-copies);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }

    // Unsaved Changes Confirmation Modal Backdrop TouchArea
    if root.show-unsaved-modal: TouchArea {
        width: 100%;
        height: 100%;
        z: 220;
    }

    // Unsaved Changes Modal Dim Backdrop
    if root.show-unsaved-modal: Rectangle {
        width: 100%;
        height: 100%;
        z: 222;
        background: Theme.dark ? #000000a6 : #00000045;
        animate background { duration: 140ms; }
    }

    // Unsaved Changes Modal Card
    if root.show-unsaved-modal: Rectangle {
        width: root.width > 520px ? 460px : round((root.width - 32px) / 2px) * 2px;
        height: unsaved-modal-vl.preferred-height;
        x: round((parent.width - self.width) / 2px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px;
        z: 225;
        background: Theme.card-elevated;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dark ? #000000bb : #00000028;

        unsaved-modal-vl := VerticalLayout {
            padding: 24px;
            spacing: 20px;
            alignment: start;

            // Header with Save Icon Badge + Title
            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.accent-subtle;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: @image-url("../assets/icons/save.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Save changes?";
                        font-family: "Inter";
                        font-size: 17px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }

                    if root.unsaved-remaining-count > 1: Text {
                        text: root.unsaved-remaining-count + " documents with unsaved changes";
                        font-family: "Inter";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }
            }

            // Description Body
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Do you want to save the changes you made to \"" + root.unsaved-file-name + "\"?";
                    font-family: "Inter";
                    font-size: 14px;
                    font-weight: 500;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                Text {
                    text: "Your changes will be lost if you don't save them.";
                    font-family: "Inter";
                    font-size: 13px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            // Action Buttons Footer: Cancel, Don't Save, Save
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                // Cancel Button
                Rectangle {
                    height: 38px;
                    min-width: 80px;
                    border-radius: 9px;
                    background: cancel-unsaved-ta.pressed ? Theme.active-bg : cancel-unsaved-ta.has-hover ? Theme.hover-bg : Theme.surface-subtle;
                    border-width: 1px;
                    border-color: cancel-unsaved-ta.has-hover ? Theme.border-strong : Theme.border;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: "Cancel";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    cancel-unsaved-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.cancel-unsaved-close();
                        }
                    }
                }

                // Don't Save Button (Discard)
                Rectangle {
                    height: 38px;
                    min-width: 96px;
                    border-radius: 9px;
                    background: discard-ta.pressed ? (Theme.dark ? #4a1d1d : #fee2e2) : discard-ta.has-hover ? (Theme.dark ? #3b1818 : #fef2f2) : (Theme.dark ? #2e1717 : #fff1f2);
                    border-width: 1px;
                    border-color: discard-ta.has-hover ? #ef4444 : (Theme.dark ? #5c2020 : #fecdd3);

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: "Don't Save";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 600;
                            color: #ef4444;
                            vertical-alignment: center;
                        }
                    }

                    discard-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.confirm-discard-and-close(root.unsaved-tab-index, root.unsaved-is-quitting);
                        }
                    }
                }

                // Save Button (Primary CTA)
                Rectangle {
                    height: 38px;
                    min-width: 80px;
                    border-radius: 9px;
                    background: save-cta-ta.pressed ? Theme.accent.darker(10%) : save-cta-ta.has-hover ? Theme.accent-hover : Theme.accent;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: center;

                        Text {
                            text: "Save";
                            font-family: "Inter";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.on-accent;
                            vertical-alignment: center;
                        }
                    }

                    save-cta-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.confirm-save-and-close(root.unsaved-tab-index, root.unsaved-is-quitting);
                        }
                    }
                }
            }
        }
    }
}
